// Isolated production-handler checks for the same-model, distinct-instance bug.
auto* PS=World->SpawnActor<AColdSteelPlayerState>();PS->SetOwner(PC);Pawn->SetPlayerState(PS);
auto R=Model->CreateItem(TEXT("ue_pit_viper2011"));R.Place=1;R.Cell=6;R.Magazine=8;
auto L=R;L.InstanceId=TEXT("pistol-review-left");L.Cell=8;L.Magazine=3;L.LoadedAmmoType=TEXT("ammo_9mm_ap");
auto Old=L;Old.InstanceId=TEXT("pistol-review-other-set");Old.Cell=11;
auto Profile=Seed;Profile.Items={R,L,Old};Model->Current=Profile;
auto* Shadow=Model->CreateShadowModel(Profile);PS->ShadowModel=Shadow;Shadow->CurrentPawn=Pawn;Pawn->NetShadowProfile=Shadow;
Pawn->ApplyColdSteelProfile(Shadow);
auto* Target=World->SpawnActor<AActor>(Pawn->GetPawnViewLocation()+FVector(200,0,0),FRotator::ZeroRotator);
FColdSteelNetHitReport Report;Report.Target=Target;Report.ItemDefinition=L.Definition;Report.ItemInstance=L.InstanceId;
Report.AimOrigin=Pawn->GetPawnViewLocation();Report.ImpactPoint=Target->GetActorLocation();Report.Direction=FVector::ForwardVector;
Report.Flags=(1<<2)|(1<<6);Report.FireSequence=1;Report.ConvergenceRounds=1;
FString Reason;const FColdSteelItem* Declared=nullptr;
PS->ServerRememberPistolShot_Implementation(1,L.InstanceId,6,1,Pawn);
Check(TEXT("same model selects left instance and ammo"),PS->ValidateHitReport(Report,Pawn,Reason,Declared)&&Declared&&Declared->InstanceId==L.InstanceId&&Declared->LoadedAmmoType==L.LoadedAmmoType);
const auto Snapshot=ColdSteelSkills::Snapshot(Pawn,&L,true);
Check(TEXT("launch snapshot freezes exact left instance"),Snapshot.ItemInstance==L.InstanceId);
Report.ItemInstance=Old.InstanceId;
Check(TEXT("inactive weapon set cannot author hit"),!PS->ValidateHitReport(Report,Pawn,Reason,Declared));
Report.ItemInstance.Reset();
Check(TEXT("ambiguous pistol definition cannot author hit"),!PS->ValidateHitReport(Report,Pawn,Reason,Declared));
Report.ItemInstance=TEXT("missing-instance");
Check(TEXT("missing instance never falls back to right model"),!PS->ValidateHitReport(Report,Pawn,Reason,Declared));
PS->ServerGunLedgers.Reset();PS->RegisteredPistolShots.Reset();PS->FireTokenBucket=6.f;
Report.ItemInstance=R.InstanceId;PS->ServerRememberPistolShot_Implementation(Report.FireSequence,R.InstanceId,6,1,Pawn);PS->ServerReportHit_Implementation(Report);
Report.FireSequence=2;Report.ItemInstance=L.InstanceId;PS->ServerRememberPistolShot_Implementation(2,L.InstanceId,6,1,Pawn);PS->ServerReportHit_Implementation(Report);
const auto* RL=PS->ServerGunLedgers.Find(R.InstanceId);const auto* LL=PS->ServerGunLedgers.Find(L.InstanceId);
Check(TEXT("simultaneous same-id shots debit both gun ledgers"),RL&&LL&&RL->Magazine==7&&LL->Magazine==2);
const float Roll=LL?LL->CriticalRolls.FindRef(2):0.f;
Report.FireSequence=3;Report.ItemInstance=R.InstanceId;PS->ServerRememberPistolShot_Implementation(3,R.InstanceId,6,1,Pawn);PS->ServerReportHit_Implementation(Report);
Report.FireSequence=2;Report.ItemInstance=L.InstanceId;PS->ServerReportHit_Implementation(Report);
Check(TEXT("interleaved repeated contact does not debit left twice"),PS->ServerGunLedgers.FindChecked(L.InstanceId).Magazine==2);
Check(TEXT("interleaved contact retains its critical sample"),PS->ServerGunLedgers.FindChecked(L.InstanceId).CriticalRolls.FindRef(2)==Roll);
Check(TEXT("switching back does not reset right magazine"),PS->ServerGunLedgers.FindChecked(R.InstanceId).Magazine==6);
auto Switched=Shadow->Snapshot();Switched.ActiveWeaponSlot=9;Shadow->AdoptNetMirror(Switched);
Check(TEXT("registered in-flight hit survives weapon-set switch"),PS->ValidateHitReport(Report,Pawn,Reason,Declared)&&Declared&&Declared->InstanceId==L.InstanceId);
PS->ServerRememberPistolShot_Implementation(4,L.InstanceId,6,1,Pawn);
Check(TEXT("a missed shot still consumes its gun ledger"),PS->ServerGunLedgers.FindChecked(L.InstanceId).Magazine==1);
// This exercises frozen projectile metadata, not a recreated assertion struct.
Pawn->Ballistics->Launch(Pawn->GetPawnViewLocation(),FVector::ForwardVector,10000,10000,1,nullptr,nullptr,10000,&L,false,false,73,1);
Check(TEXT("ballistic launch preserves instance sequence and cost"),Pawn->Ballistics->ActiveCount()>0&&Pawn->Ballistics->Rounds.Last().Training.ItemInstance==L.InstanceId&&Pawn->Ballistics->Rounds.Last().Training.FireSequence==73&&Pawn->Ballistics->Rounds.Last().Training.FiredRounds==1);
PS->ShadowModel=nullptr;Pawn->NetShadowProfile=nullptr;
