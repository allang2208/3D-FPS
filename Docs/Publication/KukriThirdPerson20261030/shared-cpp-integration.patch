+// Read the same modular recipe on local and remote pawns. No owner viewmodel is
+// required, and the existing body equipment serializer carries the individual parts.
+void DescribeKukri(FFPSBodyWeapon& Weapon,const FColdSteelItem& Item)
+{
+    for(const auto& Module:ColdSteelModularSword::DescribeGeometry(Item))
+    {
+        if(Module.bRoot)
+        {
+            Weapon.StaticMesh=FSoftObjectPath(Module.Mesh);Weapon.Materials.Reset();
+            for(const FString& Material:Module.Materials)Weapon.Materials.Emplace(FSoftObjectPath(Material));
+            continue;
+        }
