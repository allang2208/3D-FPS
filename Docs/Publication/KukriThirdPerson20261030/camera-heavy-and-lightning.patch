@@ -330,0 +331,2 @@
+    if(++NetworkHeavyReleaseSerial==0)++NetworkHeavyReleaseSerial;
+    for(auto& Targets:NetworkHeavyTargets)Targets.Reset();
@@ -333,0 +336,11 @@
+bool UKukriWeaponComponent::IsNetworkHeavyTargetNew(const FString& Weapon,AActor* Target) const
+{
+    return IsValid(Target)&&IsNetworkHeavyReleaseWindowOpen(Weapon)&&
+        !NetworkHeavyTargets[Weapon==ServerHeavyWeapon?0:1].Contains(Target);
+}
+
+void UKukriWeaponComponent::RecordNetworkHeavyTarget(const FString& Weapon,AActor* Target)
+{
+    if(IsNetworkHeavyTargetNew(Weapon,Target))NetworkHeavyTargets[Weapon==ServerHeavyWeapon?0:1].Add(Target);
+}
