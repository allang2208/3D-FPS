 public class FPSGAME : ModuleRules
 {
     public FPSGAME(ReadOnlyTargetRules Target) : base(Target)
     {
+        ConfigureHillsContentIdentity();
         PCHUsage = PCHUsageMode.UseExplicitOrSharedPCHs;
         PublicDependencyModuleNames.AddRange(new[]
         {
@@ -68,4 +74,37 @@
             "ChaosCloth"
