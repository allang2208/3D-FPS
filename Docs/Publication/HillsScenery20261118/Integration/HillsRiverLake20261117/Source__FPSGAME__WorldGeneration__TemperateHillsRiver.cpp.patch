+    if(Lake.Valid&&LakeEdge<(Lake.bNaturalShore?FPlan::FLake::MaxBankExtent:3200.)&&LakeEdge<R.Distance-R.HalfWidth)
+    {
+        const auto Shore=Lake.Shore(X,Y);
