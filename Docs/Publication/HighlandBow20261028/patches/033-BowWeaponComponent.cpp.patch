+    if(Weapon!=InstanceId||DrawId!=LastReleasedDrawId)return;
+    bPerfectSpeedPending=Perfect;
+    if(!IsDrawing()){bLastPerfectRelease=Accepted&&Perfect;bLastPiercingRelease=Accepted&&Piercing;}
+}
