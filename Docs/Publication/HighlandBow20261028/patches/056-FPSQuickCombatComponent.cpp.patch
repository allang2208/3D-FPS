+float UFPSQuickCombatComponent::GetBowRecoilCM() const
+{
+    return Style==EQuickCombatStyle::Bow&&IsOccupyingLeftHand()&&ImpactStrength>0.f
+        ?BowQuickCombatMotion::RecoilCM(ImpactAge)*ImpactStrength:0.f;
+}
+
+float UFPSQuickCombatComponent::GetBowSourcePlaybackRate() const
+{
+    return Style==EQuickCombatStyle::Bow&&IsOccupyingLeftHand()&&!IsImpactPaused()
+        ?BowQuickCombatMotion::SourceRate(ActionAge,ClipLength)*ActionRate:0.f;
+}
