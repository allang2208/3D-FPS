+#include "ColdSteelCadenceBadge.h"
+#include "ColdSteelUIStyle.h"
+#include "../Weapons/Bow/CadenceString.h"
+#include "Framework/Application/SlateApplication.h"
+#include "Fonts/FontMeasure.h"
