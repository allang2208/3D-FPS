+    inline float SourceRate(float Time,float SourceLength)
+    {
+        const float T=Time*Length/FMath::Max(.05f,SourceLength);
+        return T<Grip?ReachRate:T<Cock?CockRate:T<Contact?StrikeRate:T<Follow?FollowRate:RecoveryRate;
