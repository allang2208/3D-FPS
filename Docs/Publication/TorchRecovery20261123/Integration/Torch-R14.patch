+int32 UColdSteelStatusModel::TorchBurnRate(const FColdSteelItem& Item) const
+{
+    if(Item.Place!=1||(Item.Cell!=Current.ActiveWeaponSlot&&Item.Cell!=ActiveOffhandSlot()))return 1;
+    const auto* Pawn=RuntimePawn();
+    const auto* Weather=Pawn?Pawn->FindComponentByClass<UWeaponWeatherStateComponent>():nullptr;
+    return Weather?Weather->TorchBurnRate(Item.InstanceId):1;
+}
+
+void UColdSteelStatusModel::SettleBurnedTorches()
+{
+    if(bCampfireInventoryPending||bTransactionSaveUnconfirmed||bStagingNetworkContainer||
+        Current.CampfireInventoryRevision==MAX_int64)return;
+    SyncRuntime();
+    auto P=Snapshot();
+    for(int32 N=P.Items.Num()-1;N>=0;--N)
+    {
+        const auto& I=P.Items[N];
+        if(!ColdSteelInventory::IsWoodenTorch(I)||ColdSteelInventory::TorchFuelRemaining(I)>0.||
+            I.Container.StartsWith(TEXT("NetView.")))continue;
+        P.Items.RemoveAt(N);
+    }
+    const auto* PS=RuntimePawn()->GetPlayerState<AColdSteelPlayerState>();
+    const FString GuestSlot=bNetShadowProfile&&PS?PS->CampfireGuestSlot():FString();
+    if(bNetShadowProfile&&GuestSlot.IsEmpty())return;
+    ++P.CampfireInventoryRevision;
+    TGuardValue<FString> SlotGuard(CampfireGuestSaveSlot,GuestSlot);
+    TGuardValue<bool> SaveGuard(bSavingTransaction,true);
+    PersistState(MoveTemp(P),true);
+}
