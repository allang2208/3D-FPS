+TSharedRef<SWidget> UColdSteelNpcDialogue::Workshop()
+{
+    const TWeakObjectPtr<UColdSteelNpcDialogue> Owner(this);
+    auto Extent=[Owner](bool Horizontal)
+    {
+        if(!Owner.IsValid())return FOptionalSize();
+        const FVector2D Size=UWidgetLayoutLibrary::GetViewportSize(Owner.Get());
+        const float Scale=FMath::Max(.1f,UWidgetLayoutLibrary::GetViewportScale(Owner.Get()));
+        return FOptionalSize(FMath::Max(1.f,FMath::Min(Horizontal?860.f:600.f,
+            float(Horizontal?Size.X:Size.Y)/Scale-24.f)));
+    };
+    return SNew(SOverlay)
+        +SOverlay::Slot().HAlign(HAlign_Center).VAlign(VAlign_Center)
+        [SNew(SBox).WidthOverride_Lambda([Extent]{return Extent(true);}).HeightOverride_Lambda([Extent]{return Extent(false);})
+            [SNew(SBorder).BorderImage(&TreeStyle.GlassBrush).Padding(14)
