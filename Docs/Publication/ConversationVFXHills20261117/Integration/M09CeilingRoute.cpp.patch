 AM09CeilingRoute::AM09CeilingRoute()
 {
@@ -59,5 +60,8 @@ bool AM09CeilingRoute::ClearSegment(UWorld* W,FVector A,FVector B,const AActor*
  // Hanging travel ignores the body's terrain volume. Only continuity of the
