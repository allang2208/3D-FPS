+   const int32 Added=Nodes.Add({Contact,Nodes[At].Cost+float(FVector::Distance(Current,Contact)),Distance,At});
+   if(Distance<BestDistance-5.f){Best=Added;BestDistance=Distance;}
+  }
+  if(BestDistance<35.f)break;
+ }
