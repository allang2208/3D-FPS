+void URuneSwordComponent::AdvanceRingPrimaryHold()
+{
+    if(RingPrimaryDownAt<0.||bRingHoldAttempted||bCharging)return;
+    if(bGuardHeld||bChainSlashPending||bChainSlash||bUppercut||bWhirlwind||bDashAttack||
+        Character->IsCastBlockingLeftHandAction()||!CanUse(true))
+    {RingPrimaryDownAt=-1.;return;}
+    const double Now=GetWorld()->GetTimeSeconds();
+    const double HoldAt=RingPrimaryDownAt+.20;
+    if(Now<=HoldAt||IsBusy())return;
+    bRingHoldAttempted=true;
+    // A press during recovery borrows no charge time from the preceding swing.
+    StartHeavyCharge(bRingInputBuffered?Now:HoldAt);
+}
