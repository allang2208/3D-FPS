+void UColdSteelProgressNotification::PrepareNoticeIcon()
+{
+    bNoticeLoading=true;bNoticeReady=false;
+    const uint64 Request=++IconRequest;
+    IconTexture=nullptr;IconBrush.SetResourceObject(nullptr);IconBrush.DrawAs=ESlateBrushDrawType::NoDrawType;
+    if(Active.Icon.IsEmpty()){bNoticeReady=true;return;}
+    const FString Filename=FPaths::ProjectContentDir()/TEXT("ColdSteelData")/Active.Icon;
+    const TWeakObjectPtr<UColdSteelProgressNotification> Weak(this);
+    // One decode per widget at a time. Preserve the original full-resolution
+    // image/format; texture creation and widget access stay on the game thread.
+    Async(EAsyncExecution::ThreadPool,[Weak,Request,Filename]()
+    {
+        auto Image=MakeShared<FImage,ESPMode::ThreadSafe>();
+        const bool Loaded=FImageUtils::LoadImage(*Filename,*Image);
+        AsyncTask(ENamedThreads::GameThread,[Weak,Request,Image,Loaded]()
+        {
+            auto* Self=Weak.Get();
+            if(!Self||Self->IconRequest!=Request||!Self->bNoticeLoading)return;
+            if(Loaded)Self->IconTexture=FImageUtils::CreateTexture2DFromImage(*Image);
+            Self->IconBrush.SetResourceObject(Self->IconTexture);
+            Self->IconBrush.DrawAs=Self->IconTexture?ESlateBrushDrawType::Image:ESlateBrushDrawType::NoDrawType;
+            Self->bNoticeReady=true;
+        });
+    });
+}
