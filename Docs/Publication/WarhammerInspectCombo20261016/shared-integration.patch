+bool UProductionToolComponent::PredictBluntEnemyContact() const
+{
+    // Mirrors ResolveBluntContact's sector and the enemy filter below; the
+    // server still settles damage and only its result changes gameplay.
+    auto* Pawn=Character.Get();if(!Pawn||!GetWorld())return false;
+    const FTransform Aim=Pawn->GetMeleeAimTransform();
+    const FVector Forward=Aim.GetUnitAxis(EAxis::X).GetSafeNormal2D(UE_SMALL_NUMBER,Pawn->GetActorForwardVector());
+    const TSet<TWeakObjectPtr<AActor>> Empty;
+    for(const auto& Hit:RuneSwordCombat::QuerySector(GetWorld(),Pawn,Pawn->GetActorLocation(),Forward,AxeCombatReach,BluntArcDegrees,Empty))
+        if(IsAxeEnemy(Hit.GetActor(),Pawn))return true;
+    return false;
+}
