+            FaceRig=Face->GetSkeletalMeshAsset();
+            BodyRig=Body->GetSkeletalMeshAsset();
+            bFaceOwnsEyes=FResidentGaze::HasEyePair(*Face) && !FResidentGaze::HasEyePair(*Body);
+        }
+        EyeGaze.UpdateTarget(*Face,bFaceOwnsEyes?Viewer:nullptr,Delta);
