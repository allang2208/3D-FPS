+bool UColdSteelShopModel::BuyHorse(FGuid Id)
+{
+    if(!IsStableShop() || !CanTrade())return false;
+    auto* PC=GetGameInstance()->GetFirstLocalPlayerController();
+    FColdSteelInventoryRequest R;
+    R.Action=EColdSteelInventoryAction::Shop;R.Mode=StableMenu.BuyMode;
+    R.MountId=Id;R.Target=MenuSeller.Get();R.Pawn=PC->GetPawn();R.Count=1;
+    if(GetWorld()->GetNetMode()==NM_Standalone)
+    {
+        FString Reason;
+        bool Saved;
+        {
+            TGuardValue<bool> Guard(bCommitting,true);
+            Model->SyncRuntime();
+            Saved=ExecuteNetworkTrade(Model,R,FString(),Reason);
+        }
+        RefreshHorseOffers();Message=Reason;OnChanged.Broadcast();
+        return Saved;
+    }
+    auto* PS=PC->GetPlayerState<AColdSteelPlayerState>();
+    bPendingSale=false;bCommitting=true;
+    if(!PS || !PS->RequestInventoryAction(R)){bCommitting=false;return Fail(TEXT("交易正在等待角色同步"));}
+    if(bCommitting){Message=TEXT("正在登记马匹");OnChanged.Broadcast();}
+    return true;
+}
