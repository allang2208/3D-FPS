+bool UColdSteelShopModel::RefreshHorseOffers()
+{
+    if(!IsStableShop()||!Model)return false;
+    if(!StableClock.IsValid())StableClock=MarketClock(GetWorld());
+    const int32 Day=StableClock.IsValid()?StableClock->GetScheduleDay():INDEX_NONE;
+    const FGuid Profile=Model->ProfileView().NetworkProfileId;
+    if(Day==StableDay && Profile==StableProfile)return false;
+    StableDay=Day;StableProfile=Profile;
+    StableOffers=StableHorseMarket::Stock(Profile,Day);
+    return true;
+}
