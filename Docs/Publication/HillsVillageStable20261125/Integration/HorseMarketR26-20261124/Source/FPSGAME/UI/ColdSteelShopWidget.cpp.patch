+void UColdSteelShopWidget::BuildHorseMarket(UVerticalBox* Body)
+{
+    HorseMarket=WidgetTree->ConstructWidget<UVerticalBox>();
+    auto* MarketSlot=Body->AddChildToVerticalBox(HorseMarket);
+    MarketSlot->SetSize(FSlateChildSize(ESlateSizeRule::Fill));
+    MarketSlot->SetPadding(FMargin(12,8));
+    HorseMarket->SetVisibility(ESlateVisibility::Collapsed);
+
+    MarketDate=ShopText(WidgetTree,TEXT(""),14,true);
+    HorseMarket->AddChildToVerticalBox(MarketDate)->SetPadding(FMargin(0,0,0,8));
+    auto* Scroll=WidgetTree->ConstructWidget<UScrollBox>();
+    Scroll->SetAllowOverscroll(false);
+    HorseMarket->AddChildToVerticalBox(Scroll)->SetSize(FSlateChildSize(ESlateSizeRule::Fill));
+    auto* List=WidgetTree->ConstructWidget<UVerticalBox>();
+    Scroll->AddChild(List);
+    for(int32 Index=0;Index<StableHorseMarket::DailyCount;++Index)
+    {
+        auto* Button=WidgetTree->ConstructWidget<UColdSteelHorseOfferButton>();
+        Button->Bind(this);Button->SetStyle(ColdSteelUI::ButtonStyle());
+        auto* Row=WidgetTree->ConstructWidget<UHorizontalBox>();Button->SetContent(Row);
+        auto* ContentSlot=CastChecked<UButtonSlot>(Row->Slot);
+        ContentSlot->SetHorizontalAlignment(HAlign_Fill);ContentSlot->SetPadding(FMargin(12,8));
+        auto* Label=ShopText(WidgetTree,TEXT(""),16,true);
+        Row->AddChildToHorizontalBox(Label)->SetSize(FSlateChildSize(ESlateSizeRule::Fill));
+        auto* Price=ShopText(WidgetTree,TEXT(""),14);Row->AddChildToHorizontalBox(Price)->SetVerticalAlignment(VAlign_Center);
+        List->AddChildToVerticalBox(Button)->SetPadding(FMargin(0,0,0,4));
+        HorseRows.Add(Button);HorseLabels.Add(Label);HorsePrices.Add(Price);
+    }
+    auto* Surface=ShopSurface(WidgetTree);
+    List->AddChildToVerticalBox(Surface)->SetPadding(FMargin(0,8,0,4));
+    auto* Details=WidgetTree->ConstructWidget<UVerticalBox>();Surface->SetContent(Details);
+    HorseName=ShopText(WidgetTree,TEXT(""),18,true);HorseName->SetColorAndOpacity(ColdSteelUI::HUDGoldLight);
+    Details->AddChildToVerticalBox(HorseName);
+    HorseRatings=ShopText(WidgetTree,TEXT(""),16);
+    Details->AddChildToVerticalBox(HorseRatings)->SetPadding(FMargin(0,8));
+    HorseFigures=ShopText(WidgetTree,TEXT(""),14);
+    Details->AddChildToVerticalBox(HorseFigures);
+    HorsePurchase=ShopButton(WidgetTree,TEXT("购买"));
+    HorsePurchase->OnClicked.AddDynamic(this,&ThisClass::BuySelectedHorse);
+    HorseMarket->AddChildToVerticalBox(HorsePurchase)->SetPadding(FMargin(0,8,0,0));
+}
+
+void UColdSteelShopWidget::SelectHorse(FGuid Id)
+{
+    if(!Model || !Model->IsStableShop())return;
+    ViewedHorse=Id;
+    if(HUD)HUD->PlayButtonClick();
+    Refresh();
+}
+void UColdSteelShopWidget::BuySelectedHorse()
+{
+    if(HUD)HUD->PlayButtonClick();
+    if(Model && ViewedHorse.IsValid())Model->BuyHorse(ViewedHorse);
+}
+void UColdSteelShopWidget::RefreshHorseMarket(const UColdSteelStatusModel& Status)
+{
+    const auto& Offers=Model->HorseOffers();
+    const auto& Roster=Status.ProfileView().MountRoster;
+    const auto* Current=Offers.FindByPredicate([this](const auto& Lot){return Lot.Horse.HorseId==ViewedHorse;});
+    // A new day clears the previous selection. A purchase always targets the visible ID.
+    if(!Current && !Offers.IsEmpty())
+    {
+        Current=Offers.FindByPredicate([&Roster](const auto& Lot){return !Roster.Find(Lot.Horse.HorseId);});
+        if(!Current)Current=&Offers[0];
+    }
+    ViewedHorse=Current?Current->Horse.HorseId:FGuid();
+    ShopSet(MarketDate,Current?FString::Printf(TEXT("第 %d 天 · 在售名册     每日零时换马"),Model->HorseMarketDay()+1):TEXT("正在等候村庄马匹名册"));
+    for(int32 I=0;I<HorseRows.Num();++I)
+    {
+        auto* Row=HorseRows[I].Get();
+        Row->SetVisibility(Offers.IsValidIndex(I)?ESlateVisibility::Visible:ESlateVisibility::Collapsed);
+        if(!Offers.IsValidIndex(I))continue;
+        const auto& Lot=Offers[I];Row->Horse=Lot.Horse.HorseId;
+        const bool Sold=Roster.Find(Row->Horse)!=nullptr;
+        const bool Selected=Row->Horse==ViewedHorse;
+        ShopSet(HorseLabels[I],Lot.Horse.DisplayName());
+        HorseLabels[I]->SetColorAndOpacity(Selected?ColdSteelUI::HUDGoldLight:ColdSteelUI::TextPrimary);
+        ShopSet(HorsePrices[I],Sold?TEXT("已购入"):FString::Printf(TEXT("%d 灵魂"),Lot.Price));
+        HorsePrices[I]->SetColorAndOpacity(Sold?ColdSteelUI::TextSecondary:ColdSteelUI::HUDGoldLight);
+    }
+    auto* Caption=CastChecked<UTextBlock>(HorsePurchase->GetContent());
+    if(!Current)
+    {
+        for(auto* Label:{HorseName.Get(),HorseRatings.Get(),HorseFigures.Get()})ShopSet(Label,TEXT(""));
+        ShopSet(Caption,TEXT("等候名册"));HorsePurchase->SetIsEnabled(false);return;
+    }
+    const auto Traits=FStableHorseTraits::FromId(ViewedHorse);
+    ShopSet(HorseName,Current->Horse.DisplayName());
+    ShopSet(HorseRatings,Traits.RatingsText());
+    ShopSet(HorseFigures,FString::Printf(TEXT("生命  %.0f      体力  %.0f\n%s"),Traits.HealthLimit(),Traits.StaminaLimit(),*Traits.PerformanceText()));
+    const bool Sold=Roster.Find(ViewedHorse)!=nullptr;
+    const bool Affordable=Status.SoulBalance()>=Current->Price;
+    const FString Action=Sold?TEXT("已收入马匹栏"):Model->IsTradePending()?TEXT("正在登记"):
+        Affordable?FString::Printf(TEXT("购买%s · %d 灵魂"),*Current->Horse.DisplayName(),Current->Price):
+        FString::Printf(TEXT("还差 %lld 灵魂"),int64(Current->Price)-Status.SoulBalance());
+    ShopSet(Caption,Action);
+    HorsePurchase->SetIsEnabled(!Sold && Affordable && !Model->IsTradePending());
 }
 
