+        const bool Accepted=PS->PrepareHitReport(Hit,Prepared);
+        Check(Accepted&&Prepared.Shot.DamagePanel.BaseMagic==0.&&Prepared.Shot.DamagePanel.AddedMagic==0.&&
+            FMath::IsNearlyEqual(Prepared.Damage,Stats.Damage,.01f),FString(Definition)+TEXT(" authoritative quick physical channel"));
+        if(Accepted){const float Before=A->Health;const FVector Position=A->GetActorLocation();PS->SettleHitReport(Prepared);
+            const double Push=FVector::Dist2D(Position,A->GetActorLocation());
+            Check(A->Health<Before&&Push>.1,FString(Definition)+TEXT(" authoritative damage and knockback"),FString::Printf(TEXT("push_cm %.3f"),Push));}
