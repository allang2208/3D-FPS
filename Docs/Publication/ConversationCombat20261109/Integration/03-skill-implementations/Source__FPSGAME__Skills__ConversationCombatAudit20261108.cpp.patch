+        Shadow->Current.Items={Item};Begin();PS->QuickCombatUntil=-1;const float BeforeExpiry=B->Health;
+        PS->ServerReportHit_Implementation(Report(Item,B));Check(B->Health==BeforeExpiry,FString(Definition)+TEXT(" expired quick rejects contact"));
