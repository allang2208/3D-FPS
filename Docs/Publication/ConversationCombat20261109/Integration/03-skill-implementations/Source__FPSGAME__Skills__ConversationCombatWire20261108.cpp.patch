+FColdSteelProfile Seed(UColdSteelStatusModel* M,int32 Case)
+{
+    auto P=M->Snapshot();P.Items.Reset();P.ActiveWeaponSlot=6;P.ActiveProductionTool.Reset();P.DungeonRun={};P.Stamina=150;P.bSprintExhausted=false;
+    P.bQuickCombatReserved=false;P.QuickCombatCooldown=P.QuickCombatCooldownDuration=0;P.Mana=M->Derived(TEXT("maxMp"));
+    P.LightningHasteCooldown=P.LightningHasteCooldownDuration=0;
+    for(auto& S:P.Skills){S.Value.Level=1;S.Value.Experience=0;}
+    const TCHAR* Definition=Case==1?TEXT("ue_runebound_warhammer"):Case==2?TEXT("ue_thunder_god_hammer"):
+        Case==3?TEXT("ue_pit_viper2011"):Case==4||Case==8?TEXT("ue_apprentice_staff"):TEXT("ue_steel_warhammer");
+    auto Item=M->CreateItem(Definition);Item.InstanceId=TEXT("ConversationPrimary");Item.Place=1;Item.Cell=6;
+    if(Case<3||Case==5||Case==6)
+    {
+        TSharedPtr<FJsonObject> D;FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Item.Data),D);
+        auto Parts=MakeShared<FJsonObject>();Parts->SetStringField(TEXT("head_mount"),TEXT("conical_seat"));D->SetObjectField(TEXT("gunsmith_parts"),Parts);
+        Item.Data.Reset();FJsonSerializer::Serialize(D.ToSharedRef(),TJsonWriterFactory<>::Create(&Item.Data));
+    }
+    P.Items.Add(Item);
+    if(Case==3||Case==4){auto Axe=M->CreateItem(TEXT("ue_tactical_hatchet"));Axe.InstanceId=TEXT("ConversationOffhand");Axe.Place=1;Axe.Cell=8;P.Items.Add(Axe);}
+    return P;
+}
+void Save(const TSharedRef<FJsonObject>& Root)
+{
+    FString Json;FJsonSerializer::Serialize(Root,TJsonWriterFactory<>::Create(&Json));FString Path;
+    if(FParse::Value(FCommandLine::Get(),TEXT("SkillWireOutput="),Path))FFileHelper::SaveStringToFile(Json,*Path);
+    UE_LOG(LogTemp,Display,TEXT("CONVERSATION_WIRE_RESULT %s"),*Json);
+}
+void Stationary(AFPSGAMECharacter* P)
+{P->SetActorTickEnabled(false);P->GetCharacterMovement()->SetComponentTickEnabled(false);}
