+void ASkillWireAuditController::TickConversationCombat()
+{
+    if(HasAuthority()||!IsLocalController())return;
+    const double Now=GetWorld()->GetRealTimeSeconds();if(ExitAt>=0){if(Now>=ExitAt)FPlatformMisc::RequestExit(false);return;}
+    if(ConversationCase<0)return;auto* P=Cast<AFPSGAMECharacter>(GetPawn());auto* M=GetGameInstance()->GetSubsystem<UColdSteelStatusModel>();
+    auto* PS=GetPlayerState<AColdSteelPlayerState>();if(!P||!M||!PS)return;
+    if(ConversationCase==8)
+    {
+        const auto* H=P->FindComponentByClass<UFPSLightningHasteComponent>();const auto* Other=OtherArmor?OtherArmor->FindComponentByClass<UFPSLightningHasteComponent>():nullptr;
+        bConversationHasteSeen|=H&&H->Remaining()>0&&H->ActionMultiplier()>1&&H->MoveMultiplier()>1;
+        bConversationLateSeen|=Other&&Other->Remaining()>0&&Other->Remaining()<28&&Other->ActionMultiplier()>1;
+        if(Now-StarStatusFirstSeen>2){StarStatusFirstSeen=Now;
+            UE_LOG(LogTemp,Display,TEXT("CONVERSATION_FIXTURE client haste own=%.3f other=%.3f actor=%s replicated=%d"),H?H->Remaining():-1.f,Other?Other->Remaining():-1.f,*GetNameSafe(OtherArmor),Other&&Other->GetIsReplicated());}
+        if(!bConversationFinished&&((bConversationHasteSeen&&bConversationLateSeen&&H->Remaining()==0&&Other->Remaining()==0)||Now-Started>38))
+        {
+            bConversationFinished=true;const bool Paid=FMath::IsNearlyEqual(M->Snapshot().Mana,StarInitialMana-StarManaCost,.01f);
+            auto R=MakeShared<FJsonObject>();R->SetBoolField(TEXT("passed"),Paid&&bConversationHasteSeen&&bConversationLateSeen&&H->Remaining()==0&&Other->Remaining()==0);
+            R->SetBoolField(TEXT("owner_haste"),bConversationHasteSeen);R->SetBoolField(TEXT("late_remote_haste"),bConversationLateSeen);R->SetBoolField(TEXT("paid_once"),Paid);
+            R->SetBoolField(TEXT("observer_resolved"),Other!=nullptr);
+            ConversationWire::Save(R);ServerResult(Paid,bConversationHasteSeen,bConversationLateSeen,H&&H->Remaining()==0,Other&&Other->Remaining()==0);ExitAt=Now+3;
+        }
+        return;
+    }
+    if(!bConversationContact&&Now-Started>.45)
+    {
+        bConversationContact=true;const auto* Item=M->Equipped(ConversationCase==3||ConversationCase==4?8:6);
+        if(Item)for(auto* T:{Subject.Get(),Subject.Get(),ConversationSecond.Get()})
+        {
+            FColdSteelNetHitReport Hit;Hit.Target=T;Hit.ItemDefinition=Item->Definition;Hit.ItemInstance=Item->InstanceId;
+            if(ConversationCase==5)Hit.ItemInstance+=TEXT("_swapped");
+            Hit.AttackMeta=0x80;Hit.QuickCombatSerial=PS->QuickCombatSequence;Hit.Flags=(1<<0)|(1<<3);
+            Hit.AimOrigin=P->GetPawnViewLocation();Hit.ImpactPoint=T->GetActorLocation();Hit.Direction=FVector::ForwardVector;Hit.HitNormal=-FVector::ForwardVector;
+            Hit.ClientFireTime=GetWorld()->GetGameState()->GetServerWorldTimeSeconds();PS->ServerReportHit(Hit);
+            UE_LOG(LogTemp,Display,TEXT("CONVERSATION_FIXTURE contact case=%d eye=%s target=%s"),ConversationCase,*FVector(Hit.AimOrigin).ToCompactString(),*FVector(Hit.ImpactPoint).ToCompactString());
+        }
+    }
+    if(!bConversationFinished&&Now-Started>1.0)
+    {
+        bConversationFinished=true;const bool Cost=FMath::IsNearlyEqual(M->Stamina(),InitialStamina-(ConversationCase==6?0:ExpectedCost),.01f);
+        M->FinishQuickCombatCast();ServerResult(Cost,true,true,true,true);
+    }
+}
