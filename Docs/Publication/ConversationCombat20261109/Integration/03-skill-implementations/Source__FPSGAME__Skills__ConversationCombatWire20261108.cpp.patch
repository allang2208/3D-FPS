+void ASkillWireAuditGameMode::TickConversationCombat()
+{
+    const double Now=GetWorld()->GetRealTimeSeconds();if(ExitAt>=0){if(Now>=ExitAt)FPlatformMisc::RequestExit(false);return;}
+    if(!Guest)return;auto* P=Cast<AFPSGAMECharacter>(Guest->GetPawn());auto* PS=Guest->GetPlayerState<AColdSteelPlayerState>();
+    auto* Host=GetGameInstance()->GetSubsystem<UColdSteelStatusModel>();if(!P||!PS||!Host||!Host->IsAudit())return;
+    if(!GuestModel)
+    {
+        GuestModel=Host->CreateShadowModel(ConversationWire::Seed(Host,0));PS->ShadowModel=GuestModel;P->NetShadowProfile=GuestModel;GuestModel->CurrentPawn=P;
+        ConversationWire::Stationary(P);P->SetActorLocation(FVector(0,0,100));P->ForceNetUpdate();PS->SetActorTickEnabled(false);
+        P->FindComponentByClass<UFPSCombatHealthComponent>()->Health=1000;
+        Target=GetWorld()->SpawnActor<ANurseZombie>(FVector(120,-30,160),FRotator::ZeroRotator);
+        ConversationSecond=GetWorld()->SpawnActor<ANurseZombie>(FVector(120,30,160),FRotator::ZeroRotator);
+        for(auto* T:{Target.Get(),ConversationSecond.Get()}){T->Health=T->MaxHealth=100000;T->SetActorTickEnabled(false);T->GetCharacterMovement()->SetComponentTickEnabled(false);
+            if(auto* AI=Cast<AMonsterAIController>(T->GetController()))AI->SetDecisionEnabled(false);T->OnTakeAnyDamage.AddDynamic(this,&ASkillWireAuditGameMode::CountContact);}
+        ArmorHostXP=Host->MasteryProgress(TEXT("lightningHaste")).Experience;
+    }
+    if(ConversationPhase==0)
+    {
+        PS->ServerQuickCombat_Implementation(PS->QuickCombatServerSequence,P,0,true);GuestModel->Current=ConversationWire::Seed(GuestModel,ConversationCase);
+        if(ConversationCase==6)GuestModel->Current.Stamina=0;
+        InitialStamina=GuestModel->Stamina();ExpectedCost=GuestModel->QuickCombatStaminaCost();Contacts=0;
+        Target->Health=ConversationSecond->Health=100000;Guest->bReported=Guest->bPassed=false;LastSetup=-1;ConversationStarted=Now;ConversationPhase=1;
+        Target->SetActorLocation(FVector(120,-30,160));ConversationSecond->SetActorLocation(FVector(120,30,160));
+        Target->ForceNetUpdate();ConversationSecond->ForceNetUpdate();
+        if(ConversationCase==8)
+        {
+            GuestModel->LightningHasteSkill.LightningHaste.DurationBase=5;GuestModel->LightningHasteSkill.LightningHaste.DurationPerLevel=0;
+            ArmorInitialMana=GuestModel->Snapshot().Mana;ArmorManaCost=GuestModel->LightningHasteStats().ManaCost;
+            ExistingArmor=GetWorld()->SpawnActor<AFPSGAMECharacter>(FVector(500,0,100),FRotator::ZeroRotator);ConversationWire::Stationary(ExistingArmor);ExistingArmor->SetReplicates(false);
+            StarObserverProfile=Host->CreateShadowModel(ConversationWire::Seed(Host,8));StarObserverProfile->CurrentPawn=ExistingArmor;ExistingArmor->NetShadowProfile=StarObserverProfile;
+            auto Spell=GuestModel->LightningHasteStats();Spell.Duration=30;FColdSteelNetCastRequest Req;Req.SkillId=TEXT("lightningHaste");Req.CastId=700;
+            const bool StartedBuff=ExistingArmor->FindComponentByClass<UFPSLightningHasteComponent>()->NetRelease(ExistingArmor,Req,StarObserverProfile,Spell);
+            UE_LOG(LogTemp,Display,TEXT("CONVERSATION_FIXTURE observer haste started=%d remaining=%.3f"),StartedBuff,ExistingArmor->FindComponentByClass<UFPSLightningHasteComponent>()->Remaining());
+        }
+    }
+    if(ConversationCase==8&&Now-ConversationStarted<2)return;
+    if(ConversationCase==8&&!ExistingArmor->GetIsReplicated()){ExistingArmor->SetReplicates(true);ExistingArmor->ForceNetUpdate();}
+    if(Now-LastSetup>1){LastSetup=Now;Guest->ClientSetupConversation(ConversationCase,Target,ConversationSecond,ExistingArmor);}
+    if(PS->QuickCombatServerSequence&&ConversationPhase==1&&ConversationCase!=5){ConversationPhase=2;
+        UE_LOG(LogTemp,Display,TEXT("CONVERSATION_FIXTURE server case=%d pawn=%s eye=%s target=%s range=%.1f"),ConversationCase,*P->GetActorLocation().ToCompactString(),*P->GetPawnViewLocation().ToCompactString(),*Target->GetActorLocation().ToCompactString(),GuestModel->QuickCombatStats().RangeCM);}
+    if(ConversationCase==5&&ConversationPhase==1&&PS->QuickCombatServerSequence){GuestModel->Current.Items[0].InstanceId+=TEXT("_swapped");ConversationPhase=2;}
+    if(Guest->bReported||Now-ConversationStarted>50)
+    {
+        const bool Haste=ConversationCase==8;const bool Reject=ConversationCase==5||ConversationCase==6;const int32 ExpectedHits=Reject?0:ConversationCase<3?2:1;
+        bool OK=Guest->bReported&&Guest->bPassed;
+        if(Haste)OK&=FMath::IsNearlyEqual(GuestModel->Snapshot().Mana,ArmorInitialMana-ArmorManaCost,.01f)&&
+            P->FindComponentByClass<UFPSLightningHasteComponent>()->Remaining()==0&&GuestModel->MasteryProgress(TEXT("lightningHaste")).Experience>0&&
+            Host->MasteryProgress(TEXT("lightningHaste")).Experience==ArmorHostXP;
+        else OK&=Contacts==ExpectedHits&&FMath::IsNearlyEqual(GuestModel->Stamina(),InitialStamina-(ConversationCase==6?0:ExpectedCost),.01f);
+        auto Row=MakeShared<FJsonObject>();Row->SetNumberField(TEXT("case"),ConversationCase);Row->SetBoolField(TEXT("passed"),OK);
+        Row->SetNumberField(TEXT("contacts"),Contacts);Row->SetBoolField(TEXT("client_passed"),Guest->bReported&&Guest->bPassed);ConversationResults.Add(MakeShared<FJsonValueObject>(Row));
+        UE_LOG(LogTemp,Display,TEXT("CONVERSATION_WIRE_CASE %d pass=%d contacts=%d client=%d"),ConversationCase,OK,Contacts,Guest->bPassed);
+        ++ConversationCase;ConversationPhase=0;
+        if(ConversationCase>8)
+        {
+            auto Root=MakeShared<FJsonObject>();Root->SetArrayField(TEXT("cases"),ConversationResults);
+            Root->SetBoolField(TEXT("passed"),!ConversationResults.ContainsByPredicate([](const auto& R){return !R->AsObject()->GetBoolField(TEXT("passed"));}));
+            Root->SetStringField(TEXT("transport"),GetNetMode()==NM_DedicatedServer?TEXT("UDP dedicated"):TEXT("UDP listen"));
+#if DO_ENABLE_NET_TEST
+            if(auto* Net=GetWorld()->GetNetDriver()){Root->SetNumberField(TEXT("actual_pkt_lag"),Net->PacketSimulationSettings.PktLag);Root->SetNumberField(TEXT("actual_pkt_loss"),Net->PacketSimulationSettings.PktLoss);}
+#endif
+            ConversationWire::Save(Root);ExitAt=Now+3;
+        }
+    }
