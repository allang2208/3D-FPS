+void ASkillWireAuditController::ClientSetupConversation_Implementation(int32 Case,ANurseZombie* First,ANurseZombie* Second,AFPSGAMECharacter* Observer)
+{
+    if(!FParse::Param(FCommandLine::Get(),TEXT("ConversationCombatWire"))||HasAuthority()||Case==ConversationCase||!First||!Second)return;
+    if(Case==8&&!Observer)return; // Retry after the late actor's NetGUID resolves.
+    auto* P=Cast<AFPSGAMECharacter>(GetPawn());auto* M=GetGameInstance()->GetSubsystem<UColdSteelStatusModel>();auto* PS=GetPlayerState<AColdSteelPlayerState>();
+    if(!P||!M||!M->IsAudit()||!PS||PS->GetPawn()!=P)return;
+    ConversationWire::Stationary(P);PS->SetActorTickEnabled(false);M->Current=ConversationWire::Seed(M,Case);M->CurrentPawn=P;
+    // Autonomous proxies do not adopt a frozen authority pawn's teleport.
+    // Place both isolated fixtures at the same origin before reporting hits.
+    P->SetActorLocation(FVector(0,0,100));
+    UE_LOG(LogTemp,Display,TEXT("CONVERSATION_FIXTURE client case=%d eye=%s first_before=%s second_before=%s"),Case,
+        *P->GetPawnViewLocation().ToCompactString(),*First->GetActorLocation().ToCompactString(),*Second->GetActorLocation().ToCompactString());
+    // The empty test map's floor is server-only. Do not let simulated proxies
+    // fall while their authority counterparts are intentionally frozen.
+    for(auto* T:{First,Second}){T->SetActorTickEnabled(false);T->GetCharacterMovement()->SetComponentTickEnabled(false);}
+    First->SetActorLocation(FVector(120,-30,160));Second->SetActorLocation(FVector(120,30,160));
+    if(Observer)ConversationWire::Stationary(Observer);
+    if(Case==8)UE_LOG(LogTemp,Display,TEXT("CONVERSATION_FIXTURE client observer=%s haste=%s remaining=%.3f"),*GetNameSafe(Observer),
+        *GetNameSafe(Observer->FindComponentByClass<UFPSLightningHasteComponent>()),Observer->FindComponentByClass<UFPSLightningHasteComponent>()->Remaining());
+    ConversationCase=Case;Subject=First;ConversationSecond=Second;OtherArmor=Observer;Started=GetWorld()->GetRealTimeSeconds();
+    bConversationContact=bConversationFinished=false;InitialStamina=M->Stamina();ExpectedCost=M->QuickCombatStaminaCost();
+    bReported=false;bPassed=false;
+    if(Case==8)
+    {
+        const auto Cast=M->LightningHasteStats();StarInitialMana=M->Snapshot().Mana;StarManaCost=Cast.ManaCost;
+        M->BeginLightningHasteCast(Cast);FColdSteelNetCastRequest Req;Req.SkillId=TEXT("lightningHaste");
+        Req.CastId=PS->RequestCastSpell(Req);Req.Phase=1;PS->RequestCastSpell(Req);PS->RequestCastSpell(Req);
+    }
+    else M->CommitQuickCombatCast(1.2f);
+}
