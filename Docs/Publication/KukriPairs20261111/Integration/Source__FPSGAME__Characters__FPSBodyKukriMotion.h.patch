+        if(S.ActionVariant==TEXT("HatchetPairAttack3HK"))return TEXT("Kukri.Hatchet.DualChop");
+        if(S.ActionVariant==TEXT("HatchetPairAttack3KH"))return TEXT("Kukri.FullBody.Dual.Thrust");
         return TEXT("Kukri.FullBody.Thrust");
     case EFPSBodyAction::Charge:
         if(S.ActionVariant==TEXT("FalconCharge"))return TEXT("Kukri.Falcon.Charge");
@@ -129,9 +142,12 @@ inline bool UsesAuthoredClock(FName Key)
 inline uint8 PreserveHands(const FFPSBodyState& S,bool bOffhandKukriEquipment)
 {
