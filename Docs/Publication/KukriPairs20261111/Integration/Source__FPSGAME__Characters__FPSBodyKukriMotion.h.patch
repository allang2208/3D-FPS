@@ -78,11 +83,18 @@ inline FName Clip(const FFPSBodyState& S)
     if(IsCarry(S))return TEXT("Kukri.FullBody.Idle");
     switch(S.Action)
     {
-    case EFPSBodyAction::Equip:return TEXT("Kukri.FullBody.Equip");
+    case EFPSBodyAction::Equip:
