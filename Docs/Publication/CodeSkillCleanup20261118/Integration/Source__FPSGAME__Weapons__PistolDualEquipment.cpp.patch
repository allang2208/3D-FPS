+FString Root(bool Revolver,int32 Side)
+{
+    return FString::Printf(TEXT("/Game/Weapons/PistolDualWield20260914/%s/%s"),Revolver?TEXT("DW715"):TEXT("M1911"),Side?TEXT("l"):TEXT("r"));
+}
+FString Stem(bool Revolver,int32 Side)
+{
+    return FString::Printf(TEXT("Dual_%s_%s"),Revolver?TEXT("DW715"):TEXT("M1911"),Side?TEXT("l"):TEXT("r"));
+}
+FName PistolPoseFamily(const FString& Kind)
+{
+    return Kind.Contains(TEXT("_long"))?FName(TEXT("long")):Kind.Contains(TEXT("_fitted"))?FName(TEXT("fitted")):FName(NAME_None);
+}
+// Resolves which item drives each hand: akimbo (main + offhand pistol) or the
+// offhand-only rig (staff/pistol pair, and the lone offhand pistol when the main
+// slot is empty). Offhand-only owns one rig in the left hand; the Pit Viper
+// lone variant includes the supporting right arm in that same native mesh.
+struct FPistolWieldSlots
+{
+    const FColdSteelItem* Main=nullptr;
+    const FColdSteelItem* Off=nullptr;
+    bool Staff=false;
+    bool Blade=false;
+    // 主手槽空置、只有副手手枪：同样是"只建左手"，但没有法杖。
+    bool Lone=false;
+    bool Any() const { return Off && ColdSteelInventory::IsDualPistol(*Off); }
+};
+FPistolWieldSlots ResolvePistolSlots(const UColdSteelStatusModel* Model)
+{
+    FPistolWieldSlots Out;
+    if(!Model)return Out;
+    Out.Main=Model->Equipped();
+    // A backpack tool override reserves both hands even when no main-hand
+    // weapon is equipped, so it must never expose the offhand gun.
+    const bool ToolBusy=Model->ActiveProductionTool()!=nullptr;
+    if(Out.Main)
+    {
+        Out.Staff=ColdSteelStaff::IsStaff(*Out.Main) && !ToolBusy;
+        Out.Blade=UKukriWeaponComponent::IsKukri(*Out.Main) && !ToolBusy;
+        Out.Off=Model->Equipped(Out.Main->Cell==6?8:11);
+    }
+    else if(!ToolBusy)
+    {
+        // 主手空置：ActiveFirearm() 在这时正好返回顶替主武器的那把副手手枪。
+        const auto* Lone=Model->ActiveFirearm();
+        if(Lone&&ColdSteelInventory::IsDualPistol(*Lone))
+        {
+            Out.Off=Lone;
+            Out.Lone=true;
+        }
+    }
+    return Out;
+}
