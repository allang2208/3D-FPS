+bool UPistolDualWieldComponent::MatchesEquipment(const UColdSteelStatusModel* Model,bool bWeaponReady) const
+{
+    const auto E=ResolvePistolSlots(Model);
+    // 法杖/单手刀副手与主手空置的单手枪都只建左手。
+    const bool OffhandOnly=E.Staff||E.Blade||E.Lone;
+    const bool Want=E.Any() && (OffhandOnly || (bWeaponReady && E.Main && ColdSteelInventory::IsDualPistol(*E.Main)));
+    if(!Want)return !bActive;
+    const FString MainInstance=E.Main?E.Main->InstanceId:FString();
+    return bActive && bOffhandOnly==OffhandOnly
+        && MainHandInstance==MainInstance
+        && (!E.Main || E.Staff || E.Blade || Hands[0].Item.Definition==E.Main->Definition)
+        && Hands[1].Item.InstanceId==E.Off->InstanceId && Hands[1].Item.Definition==E.Off->Definition;
+}
+
+void UPistolDualWieldComponent::Deactivate()
+{
+    if(!bActive)return;
+    if(IsQuickCombatActive())Player->QuickCombatPistol->Cancel();
+    CancelInputs();
+    for(int32 Side=FirstHand();Side<2;++Side)
+    {
+        auto& H=Hands[Side];
+        StopAction(Side);
+        if(H.FX)H.FX->StopEmission();
+        if(H.Anim){H.Anim->bDualPistolAim=false;H.Anim->DualPistolAimAlpha=0.f;H.Anim->LonePistolADSAlpha=0.f;}
+    }
+    bActive=false;
+    bMeleePrimary=false;MeleeAvoidance=0.f;
+    MeleeReleaseClip=nullptr;MeleeReleaseGrip=nullptr;
+    MainHandInstance.Reset();
+    // 换枪/退役后瞄具标定作废，下次装配重新量。
+    bLoneSightCalibrated=false;
+    LeftOptic.Reset();
+    if(Hands[1].Mesh)Hands[1].Mesh->SetVisibility(false,true);
+    if(Hands[1].Tactical)Hands[1].Tactical->Configure(TEXT(""),TEXT(""),Hands[1].Mesh,false);
+    if(auto* CastMesh=Cast<UFPSCastingMeshComponent>(Player->AKMViewmodel))CastMesh->bApplyLeftHandCast=true;
+}
