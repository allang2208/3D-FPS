+bool ColdSteelSkills::Migrate(FColdSteelProfile& P)
+{
+    if (P.SkillProgressVersion >= 32) return false;
+    P.LeapStrikeCooldown=P.LeapStrikeCooldownDuration=0.f;
+    P.Skills.FindOrAdd(TEXT("leapStrike"));
+    if(P.SkillProgressVersion==31){P.SkillProgressVersion=32;return true;}
+    if(P.SkillProgressVersion==30){P.SkillProgressVersion=32;return true;}
+    P.Skills.FindOrAdd(TEXT("chainSlash"));
+    if(P.SkillProgressVersion==29){P.SkillProgressVersion=32;return true;}
+    P.Skills.FindOrAdd(TEXT("illuminationArrow"));
+    if(P.SkillProgressVersion==28){P.SkillProgressVersion=32;return true;}
+    P.Skills.FindOrAdd(TEXT("elementalArrow"));
+    if(P.SkillProgressVersion==27){P.SkillProgressVersion=32;return true;}
+    P.Skills.FindOrAdd(TEXT("magicArrowRain"));
+    if(P.SkillProgressVersion==26){P.SkillProgressVersion=32;return true;}
+    P.Skills.FindOrAdd(TEXT("heartPiercingArrow"));
+    if(P.SkillProgressVersion==25){P.SkillProgressVersion=32;return true;}
+    P.Skills.FindOrAdd(TEXT("bluntMastery"));
