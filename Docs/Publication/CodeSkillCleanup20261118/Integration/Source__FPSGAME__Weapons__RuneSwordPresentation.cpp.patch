+        Arms->ClearWhirlwindEntry();
+        Arms->CacheQuickCombatIdlePose();
+        CurrentClip=NAME_None;
+        SetClip(TEXT("Idle"),true);
+    }
+    bEquipping=true;SetClip(TEXT("Equip"),false);
+    if(!CurrentAnimation){bEquipping=false;SetClip(TEXT("Idle"),true);}
