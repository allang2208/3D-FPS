+void AFPSGAMECharacter::StartEquipCharge()
+{
+    // The restored loadout owns its equip action. In particular, a staff with
+    // an offhand pistol must not enter the inactive main-gun state machine.
+    if(!bInventoryWeaponReady || HasOffhandPistol())return;
+    bM24EquipBoltPending=false;
+    bM24DeferReloadTail=false;
+    if(IsM24Weapon())
+    {
+        const auto* Profile=NetShadowProfile?NetShadowProfile.Get():GetGameInstance()->GetSubsystem<UColdSteelStatusModel>();
+        const auto* Gun=Profile?Profile->FindItem(ActiveInventoryWeapon):nullptr;
+        bM24EquipBoltPending=Gun&&WeaponReloadStages::NeedsM24ShotCycle(*Gun);
+        bM24PendingCasing=bM24EquipBoltPending&&WeaponReloadStages::HasM24PendingCasing(*Gun);
+        M24ActionBoltDurationScale=bM24EquipBoltPending?M24GearBoltDurationScale:1.f;
+        bM24DeferReloadTail=Gun&&!bM24EquipBoltPending&&WeaponReloadStages::NeedsCycle(*Gun);
+        EquipAnimation=bM24EquipBoltPending?LoadAKMAnimation(TEXT("A_AKM_equip")):
+            LoadObject<UAnimSequence>(nullptr,M24WeaponAssets::ReadyEquipPath);
+    }
+    if (bUseM1911)
+    {
+        const auto* Profile = GetGameInstance() ? GetGameInstance()->GetSubsystem<UColdSteelStatusModel>() : nullptr;
+        const auto* Item = Profile ? Profile->ActiveFirearm() : nullptr;
+        EquipAnimation = LoadAKMAnimation(Item && Item->Magazine == 0 ? TEXT("A_AKM_equip_charge_empty") : TEXT("A_AKM_equip_charge"));
+    }
+    // 左手单持同样要走拔枪动作：任何手枪都补一次解析，避免 bUsingReplacement 未命中时
+    // 直接跳过装配（表现为枪凭空出现、没有抬枪动画）。
+    if (IsPistolWeapon() && !EquipAnimation)
+    {
+        const auto* Profile = GetGameInstance() ? GetGameInstance()->GetSubsystem<UColdSteelStatusModel>() : nullptr;
+        const auto* Item = Profile ? Profile->ActiveFirearm() : nullptr;
+        EquipAnimation = LoadAKMAnimation(Item && Item->Magazine == 0 ? TEXT("A_AKM_equip_charge_empty") : TEXT("A_AKM_equip_charge"));
+    }
+    StopMechanicalAudio();
+    // Switching can interrupt ADS, reload or sprint. Their cached presentation
+    // offsets belong to the previous weapon, not the new equip animation.
+    SetAimingState(false);
+    if (auto* ActionCamera = FindComponentByClass<UWeaponActionCameraComponent>()) ActionCamera->BeginEquipTransition();
+    ADSProgress = ADSStartProgress = CameraADSFactor = WeaponADSFactor = 0.0f;
+    ADSStartedAt = GetWorld()->GetTimeSeconds();
+    M4ActionFramingAlpha = SprintPoseFactor = 0.0f;
+    if (auto* Sprint = FindComponentByClass<UM4TacticalSprintComponent>()) Sprint->Reset();
+    ResetPistolLocomotion();
+    ResetRifleLocomotion();
+    WeaponBobPosition = WeaponBobRotation = FVector::ZeroVector;
+    FVector InitialHipLocation=RifleHipFraming.Location(HipViewmodelLocation);
+    FQuat InitialHipRotation=RifleHipFraming.Rotation(GetViewmodelBaseRotation().Quaternion());
+    if(M249WeaponAssets::Matches(AKMViewmodel))
+        M249WeaponAssets::LevelHipPose(InitialHipLocation,InitialHipRotation,ViewmodelScale,1.f);
+    AKMViewmodel->SetRelativeLocationAndRotation(InitialHipLocation,InitialHipRotation);
+    // 左手单持的镜面法线要跟着这次设置的机位走，否则装备第一帧还在用上一把枪的朝向。
+    if(bViewmodelMirrored)UpdateLeftHandMirrorPlane();
+    if (GunplayAnimation)
+    {
+        GunplayAnimation->AimAlpha = 0.0f;
+        GunplayAnimation->ActionAlpha = 0.0f;
+        GunplayAnimation->SprintAlpha = 0.0f;
+    }
+    WeaponState = EAKMWeaponState::Equipping;
+    WeaponActionStartedAt = GetWorld()->GetTimeSeconds();
+    if (IsPistolWeapon()) NextAllowedShotTime = WeaponActionStartedAt;
+    WeaponStateElapsed = 0.0f;
+    MechanicalCueTimes.Reset(); MechanicalCueSounds.Reset(); NextMechanicalCue = 0;
+    const bool bAKMChargeOnly = !bUsingM4Infima && EquipAnimation && (EquipAnimation->GetPathName().Contains(TEXT("/AKMIntegration/EquipCharge/")) || A762WeaponAssets::Matches(AKMViewmodel) || LMG201WeaponAssets::Matches(AKMViewmodel));
+    if (bAKMChargeOnly)
+    {
+        MechanicalCueTimes = {0.55f, 0.80f};
+        MechanicalCueSounds = {ChargePullSound, ChargeReleaseSound};
+        UE_LOG(LogTemp, Display, TEXT("AKM_EQUIP_CHARGE: clip=%s magazine=attached left=idle duration=%.3f"), *EquipAnimation->GetPathName(), EquipAnimation->GetPlayLength());
+    }
+    else if (IsM24Weapon())
+    {
+        if(bM24EquipBoltPending)
+        {
+            MechanicalCueTimes={M24WeaponAssets::EquipBoltPull,M24WeaponAssets::EquipBoltClosed};
+            MechanicalCueSounds={ChargePullSound,ChargeReleaseSound};
+        }
+    }
+    else if (SVDWeaponAssets::Matches(AKMViewmodel) || SVCHWeaponAssets::Matches(AKMViewmodel))
+    {
+        MechanicalCueTimes={SVDWeaponAssets::EquipPull,SVDWeaponAssets::EquipRelease};
+        MechanicalCueSounds={ChargePullSound,ChargeReleaseSound};
+    }
+    else if (IsTubeShotgunWeapon())
+    {
+        // Gamedev's selected equip cue is one complete sound, not two contacts.
+        PlayMechanicalSound(EquipSound, AKMSource::ActionVolume);
+    }
+    else if (IsPistolWeapon())
+    {
+        // Raising these rigs has no charging-handle contact. Original P9 Unholster: no slide pull occurs in the equip donor.
+        MechanicalCueTimes.Reset();
+        MechanicalCueSounds.Reset();
+    }
+    else if (bUseQBZ191)
+    {
+        // Equip audio uses the same 38-frame source mapped to the .72s action.
+        MechanicalCueTimes = {16.f / 38.f * .72f, 25.f / 38.f * .72f};
+        MechanicalCueSounds = {ChargePullSound, ChargeReleaseSound};
+    }
+    else if (PKMLowpolyWeaponAssets::Matches(AKMViewmodel))
+    {
+        // PKM's own equip clip carries no charging-handle travel (EquipCharge31),
+        // so this stays one contact at action start. It uses the PKM rear-pull cut
+        // instead of the borrowed AKM equip one-shot; that cut is the time-stretched
+        // (pitch-preserving) ChargeAudio35 sample, the same asset the empty reload
+        // plays at its 5.13 s source contact.
+        USoundBase* PKMPull = LoadObject<USoundBase>(nullptr, *PKMLowpolyWeaponAssets::ChargeSoundPath(TEXT("ChargePullMove")));
+        if (!PKMPull) UE_LOG(LogTemp, Warning, TEXT("PKM equip pull missing: %s"), *PKMLowpolyWeaponAssets::ChargeSoundPath(TEXT("ChargePullMove")));
+        PlayMechanicalSound(PKMPull ? PKMPull : EquipSound.Get(), AKMSource::ActionVolume);
+    }
+    else PlayMechanicalSound(EquipSound, AKMSource::ActionVolume);
+    if (EquipAnimation)
+    {
+        // PKM's video-authored raise/catch/settle uses its own clip clock.
+        WeaponStateDuration = bUsingM4Infima && !IsM24Weapon() && !IsPistolWeapon() && !SVDWeaponAssets::Matches(AKMViewmodel) && !SVCHWeaponAssets::Matches(AKMViewmodel)
+            && !PKMLowpolyWeaponAssets::SharesFeedMotion(AKMViewmodel) ? 0.72f : EquipAnimation->GetPlayLength();
+        const float EquipRate=FirearmEquipRate*LightningHaste::ActionSpeed(this);
+        if(IsM24Weapon())
+        {
+            WeaponStateDuration=M24ReloadTiming::EquipPacedTime(WeaponStateDuration,M24ActionBoltDurationScale);
+            for(float& Cue:MechanicalCueTimes)Cue=M24ReloadTiming::EquipPacedTime(Cue,M24ActionBoltDurationScale);
+        }
+        WeaponStateDuration /= EquipRate;
+        for(float& Cue : MechanicalCueTimes) Cue /= EquipRate;
+        PlayWeaponAnimation(EquipAnimation, false, EquipAnimation->GetPlayLength() / WeaponStateDuration);
+        ActionBlendIn /= EquipRate;
+    }
+    else if (ReloadEmptyAnimation)
+    {
+        const float StartAt = 1.75f;
+        const float EquipRate=LightningHaste::ActionSpeed(this);
+        WeaponStateDuration = (0.18f + FMath::Max(0.1f, ReloadEmptyAnimation->GetPlayLength() - StartAt))/EquipRate;
+        PlayWeaponAnimation(ReloadEmptyAnimation, false, EquipRate, StartAt);
+        ActionBlendIn = 0.18f/EquipRate;
+        ActionDuration = WeaponStateDuration;
+    }
+    else WeaponStateDuration = 0.1f;
+}
+
+void AFPSGAMECharacter::FinishWeaponAction()
+{
+    ClearSuper90SpeedloaderAction();
+    PendingAmmoType.Reset();PendingAmmoWeapon.Reset();
+    bReloadAmmoCommitted=bReloadCycleOnly=false;ReloadResumeElapsed=0.f;
+    const bool bFinishedQuickCombat = WeaponState == EAKMWeaponState::QuickCombat;
+    const bool bFinishedRifleReload = (RifleReloadHandoff::Supports(ActiveInventoryWeaponDefinition, bDrumInstalled) || bUseM16
+        || (bUseQBZ191 && WeaponState == EAKMWeaponState::Reloading) || SVDWeaponAssets::Matches(AKMViewmodel) || SVCHWeaponAssets::Matches(AKMViewmodel)
+        || PKMLowpolyWeaponAssets::Matches(AKMViewmodel)||HasLMG201ClothBox()||IsTubeShotgunWeapon()) && IsReloading();
+    const double CompletedAt = bFinishedQuickCombat && (bUseASH12||SVCHWeaponAssets::Matches(AKMViewmodel))
+        ? GetWorld()->GetTimeSeconds() : WeaponActionStartedAt + WeaponStateDuration;
+    // Only the eligible tail after completion can catch up. Keep a newer input
+    // deadline or another active blocker rather than rewinding it to completion.
+    NextAllowedShotTime = FMath::Max(NextAllowedShotTime, CompletedAt);
+    WeaponState = EAKMWeaponState::Idle;
+    if (bFireHeld) ExitSprintForWeapon(CompletedAt);
+    WeaponStateElapsed = WeaponStateDuration = 0.0f;
+    if (IsPistolWeapon() || bFinishedQuickCombat || bFinishedRifleReload)
+    {
+        ActiveActionAnimation = nullptr;
+        ActionElapsed = ActionDuration = 0.f;
+        if (GunplayAnimation) GunplayAnimation->ActionAlpha = 0.f;
+    }
+    if (bFinishedQuickCombat || bFinishedRifleReload) M4ActionFramingAlpha = 0.f;
+    MechanicalCueTimes.Reset(); MechanicalCueSounds.Reset(); NextMechanicalCue = 0;
+    SetAimingState(bAimHeld);
+    ResumeWeaponPose();
+}
+
+void AFPSGAMECharacter::FinishReload()
+{
+    if(IsTubeShotgunWeapon()){FinishSuper90Reload();return;}
+    ReturnOffhandAfterReload();
+    // Ammunition was committed at insertion. The tail only returns the pose.
+    RecoilPatternIndex = 0;
+    bPendingEmptyReload = false;
+    FinishWeaponAction();
+}
