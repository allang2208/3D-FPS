+void AFPSGAMECharacter::UpdateADSPose()
+{
+    if (bSightCalibrated || !AimAnimation || !AimAnimation->GetSkeleton()) return;
+    const FReferenceSkeleton& Ref = AimAnimation->GetSkeleton()->GetReferenceSkeleton();
+    const int32 RearIndex = Ref.FindBoneIndex(TEXT("WPN_RearSight"));
+    const int32 FrontIndex = Ref.FindBoneIndex(TEXT("WPN_FrontSight"));
+    if (RearIndex == INDEX_NONE || FrontIndex == INDEX_NONE) return;
+    const auto* SightProfile=IsRSH12Weapon()?WeaponGripProfileFor(EM4SprintGrip::Base):nullptr;
+    const auto* SightLayer=SightProfile?SightProfile->Find(AimAnimation):nullptr;
+    const auto PositionAtRestAim = [&](int32 BoneIndex)
+    {
+        FTransform Transform = FTransform::Identity;
+        for (int32 Index = BoneIndex; Index != INDEX_NONE; Index = Ref.GetParentIndex(Index))
+        {
+            FTransform Local;
+            AimAnimation->GetBoneTransform(Local, FSkeletonPoseBoneIndex(Index), FAnimExtractContext(0.0, false), false);
+            if(SightLayer)SightLayer->ApplyLocal(Ref.GetBoneName(Index),0.f,Local);
+            Transform = Transform * Local;
+        }
+        // Accumulating the full hierarchy includes the FBX root's unit conversion.
+        // The resulting component-space position is already in centimetres.
+        return Transform.GetLocation() * ViewmodelScale;
+    };
+    FVector Rear = PositionAtRestAim(RearIndex);
+    FVector Front = PositionAtRestAim(FrontIndex);
+    FVector SightUp = FVector::UpVector;
+    if (AKMSoviet::Matches(AKMViewmodel) || IsSaiga12KWeapon())
+    {
+        FTransform Root = FTransform::Identity;
+        for (int32 Index=Ref.FindBoneIndex(TEXT("WPN_root")); Index!=INDEX_NONE; Index=Ref.GetParentIndex(Index))
+        {
+            FTransform Local;
+            AimAnimation->GetBoneTransform(Local,FSkeletonPoseBoneIndex(Index),FAnimExtractContext(0.0,false),false);
+            if(SightLayer)SightLayer->ApplyLocal(Ref.GetBoneName(Index),0.f,Local);
+            Root=Root*Local;
+        }
+        Rear=Root.TransformPosition(IsSaiga12KWeapon()?Saiga12KWeaponAssets::Rear:AKMSoviet::Rear)*ViewmodelScale;
+        Front=Root.TransformPosition(IsSaiga12KWeapon()?Saiga12KWeaponAssets::Front:AKMSoviet::Front)*ViewmodelScale;
+        SightUp=Root.GetRotation().RotateVector(FVector::UpVector);
+    }
+    if (SVDWeaponAssets::Matches(AKMViewmodel) || SVCHWeaponAssets::Matches(AKMViewmodel))
+    {
+        // SVD aims down the PSO-1 tube and SVCh down its own iron sights; neither
+        // sits at the shared M4 sight bone positions, so each weapon carries its
+        // own baked pair (like AKMSoviet above) and supplies the gun's up axis.
+        FTransform Root = FTransform::Identity;
+        for (int32 Index=Ref.FindBoneIndex(TEXT("WPN_root")); Index!=INDEX_NONE; Index=Ref.GetParentIndex(Index))
+        {
+            FTransform Local;
+            AimAnimation->GetBoneTransform(Local,FSkeletonPoseBoneIndex(Index),FAnimExtractContext(0.0,false),false);
+            Root=Root*Local;
+        }
+        SightUp=Root.GetRotation().RotateVector(FVector::UpVector);
+        if (SVCHWeaponAssets::Matches(AKMViewmodel))
+        {
+            // The SVCh aims down its own iron sights, 537.7 mm apart and 85.9 mm
+            // above the bore. The shared WPN_* bones still carry the SVD's baked
+            // points, so take the measured pair from the weapon header instead.
+            Rear=Root.TransformPosition(SVCHWeaponAssets::RearSight)*ViewmodelScale;
+            Front=Root.TransformPosition(SVCHWeaponAssets::FrontSight)*ViewmodelScale;
+            SightUp=Root.TransformVectorNoScale(SVCHWeaponAssets::SightUp);
+        }
+    }
+    if (bHolographicOptic)
+    {
+        FTransform Root = FTransform::Identity;
+        const FName OpticBone=HolographicOptic?HolographicOptic->GetAttachSocketName():FName(TEXT("WPN_root"));
+        for (int32 Index=Ref.FindBoneIndex(OpticBone); Index!=INDEX_NONE; Index=Ref.GetParentIndex(Index))
+        {
+            FTransform Local;
+            AimAnimation->GetBoneTransform(Local,FSkeletonPoseBoneIndex(Index),FAnimExtractContext(0.0,false),false);
+            Root=Root*Local;
+        }
+        const FTransform Mount=HolographicMount*Root;
+        // Older optics expose only AimCenter; retain that calibrated fallback
+        // when a complete rear/front/up socket frame is unavailable.
+        Rear=Mount.TransformPosition(OpticLocalAimPoint())*ViewmodelScale;
+        Front=Rear+Mount.GetRotation().RotateVector(AKMSoviet::Matches(AKMViewmodel)&&OpticVariant==TEXT("holographic")?FVector::RightVector:FVector::ForwardVector)*10.f;
+        SightUp=Mount.GetRotation().RotateVector(FVector::UpVector);
+        if ((UsesPhysicalScope() || IsM24Weapon() || M249WeaponAssets::Matches(AKMViewmodel) || IsShotgunWeapon() || IsRSH12Weapon() || IsHK416Weapon() || OpticVariant == TEXT("eoth_holographic") || OpticVariant == TEXT("kv_scope_4x")) && HolographicOptic && HolographicOptic->GetStaticMesh())
+        {
+            const UStaticMesh* OpticMesh=HolographicOptic->GetStaticMesh();
+            const auto* R=OpticMesh->FindSocket(TEXT("SightRear"));
+            const auto* F=OpticMesh->FindSocket(TEXT("SightFront"));
+            const auto* U=OpticMesh->FindSocket(TEXT("SightUp"));
+            if (R&&F&&U)
+            {
+                Rear=Mount.TransformPosition(R->RelativeLocation)*ViewmodelScale;
+                Front=Mount.TransformPosition(F->RelativeLocation)*ViewmodelScale;
+                SightUp=(Mount.TransformPosition(U->RelativeLocation)*ViewmodelScale-Rear).GetSafeNormal();
+            }
+        }
+    }
+    const FVector Axis = (Front - Rear).GetSafeNormal();
+    if (Axis.IsNearlyZero() || Rear.ContainsNaN() || Front.ContainsNaN()) return;
+    const FQuat Base = GetViewmodelBaseRotation().Quaternion();
+    CalibratedADSRotation = FQuat::FindBetweenNormals(Base.RotateVector(Axis), FVector::ForwardVector) * Base;
+    // Mapping a single axis leaves roll unconstrained. Align the complete optic
+    // frame with camera forward/up so ADS is level without twisting it off the rail.
+    if ((IsM24Weapon() || IsPistolWeapon() || IsHK416Weapon() || IsTubeShotgunWeapon() || bUseQBZ191 || M249WeaponAssets::Matches(AKMViewmodel)) && !bHolographicOptic)
+    {
+        FTransform Root = FTransform::Identity;
+        for (int32 Index=Ref.FindBoneIndex(TEXT("WPN_root")); Index!=INDEX_NONE; Index=Ref.GetParentIndex(Index))
+        {
+            FTransform Local;
+            AimAnimation->GetBoneTransform(Local,FSkeletonPoseBoneIndex(Index),FAnimExtractContext(0.0,false),false);
+            Root=Root*Local;
+        }
+        SightUp=Root.GetRotation().RotateVector(IsM24Weapon() ? M24WeaponAssets::SightUp : M249WeaponAssets::Matches(AKMViewmodel) ? M249WeaponAssets::SightUp : IsTubeShotgunWeapon() ? -FVector::RightVector : FVector::UpVector);
+    }
+    // QBZ191's aim carries about 4.88 degrees of left roll. Its iron sights need
+    // the gun-root up axis, just as hip framing does, while retaining their own
+    // sight line and eye distance. The location below uses this corrected frame.
+    if(IsM24Weapon() || bHolographicOptic || IsShotgunWeapon() || IsPistolWeapon() || IsHK416Weapon() || bUseQBZ191 || M249WeaponAssets::Matches(AKMViewmodel) || SVDWeaponAssets::Matches(AKMViewmodel) || SVCHWeaponAssets::Matches(AKMViewmodel))CalibratedADSRotation=FRotationMatrix::MakeFromXZ(Axis,SightUp).ToQuat().Inverse();
+    // Calibrate the actual rear ocular to the M24 reference. Optic type, not
+    // its current zoom, selects the relief so a 1x-to-6x change stays seated.
+    const float EyeDistance = UsesPhysicalScope() ? ScopeADSEyeRelief::DistanceCM
+        : IsM24Weapon() ? M24Attachments::EyeDistanceCM(OpticVariant,ADSRearEyeDistance)
+        : bHolographicOptic && !IsPistolWeapon() ? 26.f : ADSRearEyeDistance;
+    CalibratedADSLocation = FVector(EyeDistance, 0.0f, 0.0f) - CalibratedADSRotation.RotateVector(Rear);
+    bSightCalibrated = true;
+    UE_LOG(LogTemp, Display, TEXT("GUNPLAY_ADS_CALIBRATED rear=%s front=%s offset=%s rotation=%s"), *Rear.ToCompactString(), *Front.ToCompactString(), *CalibratedADSLocation.ToCompactString(), *CalibratedADSRotation.Rotator().ToCompactString());
+}
