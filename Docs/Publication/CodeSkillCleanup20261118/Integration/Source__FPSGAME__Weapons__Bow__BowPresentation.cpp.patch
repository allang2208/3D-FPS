+bool UBowWeaponComponent::ShouldShowCrosshair() const
+{
+    return IsEquipped() && CanUse() && Stage != EBowStage::Stowed && Stage != EBowStage::Equip
+        && Character.IsValid() && !Character->IsSprinting();
+}
