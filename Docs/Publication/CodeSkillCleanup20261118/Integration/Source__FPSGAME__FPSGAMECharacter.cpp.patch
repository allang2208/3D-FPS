-    // 固定成物体 X 轴只在待机的纯 yaw -90 下成立，开镜标定带俯仰+横滚后镜面会偏出去，
-    // 枪随之歪斜并被推穿近裁剪面。
-    GunplayAnimation->LeftHandMirrorPlane=AKMViewmodel->GetRelativeRotation().Quaternion().UnrotateVector(FVector::RightVector);
-}
