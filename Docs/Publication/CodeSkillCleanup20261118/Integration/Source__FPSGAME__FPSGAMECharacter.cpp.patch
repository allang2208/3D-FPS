-float AFPSGAMECharacter::ReloadRuntimeTime(float SourceTime) const
-{
-    float Low = 0.0f, High = WeaponStateDuration;
-    for (int32 Iteration = 0; Iteration < 20; ++Iteration)
-    {
-        const float Mid = (Low + High) * 0.5f;
