-void AFPSGAMECharacter::UpdateWeaponState(float DeltaSeconds)
-{
-    AdvanceOffhandReload();
-    // The active hand controller owns equip, reload and fire for a lone left
-    // pistol too. The hidden right-hand rig must never run a second clock.
-    if(HasOffhandPistol())
-    {
-        // BeginPlay used to start a single-gun equip after AttachPawn had
-        // already restored the dual/offhand controller. This branch never
-        // advances that single-gun clock, so it blocked both mouse buttons
-        // forever through IsSwitchingWeapon. Recover existing instances too.
-        if(WeaponState==EAKMWeaponState::Equipping || WeaponState==EAKMWeaponState::Inspecting)
-        {
-            StopMechanicalAudio();
-            WeaponState=EAKMWeaponState::Idle;
-            WeaponStateElapsed=WeaponStateDuration=0.f;
-            ActiveActionAnimation=nullptr;
-        }
-        return;
-    }
-    // These rifles share the executor's source clock with their pose. SVCH
-    // must also follow action haste; a separate wall clock cuts recovery short.
-    // Cached gun flags must not take ownership of a later tool/hand action.
-    const bool bDrivenRifleQuickCombat=(IsM24Weapon()||bUseASH12||SVCHWeaponAssets::Matches(AKMViewmodel))&&QuickCombatPistol&&
-        (QuickCombatPistol->GetStyle()==EQuickCombatStyle::Rifle||
-         QuickCombatPistol->GetStyle()==EQuickCombatStyle::M4ReferenceRifle);
-    if(bDrivenRifleQuickCombat&&WeaponState!=EAKMWeaponState::QuickCombat)
-        QuickCombatPistol->Cancel();
-    if (WeaponState == EAKMWeaponState::Idle) return;
-    if(WeaponState==EAKMWeaponState::QuickCombat&&QuickCombatPistol&&!QuickCombatPistol->IsOccupyingLeftHand())
-    {
-        // A server rejection/cancel ends the action component before the clip
-        // duration expires. Release the firearm pose and its input lock too.
-        WeaponStateDuration=FMath::Min(WeaponStateDuration,
-            static_cast<float>(FMath::Max(0.0,GetWorld()->GetTimeSeconds()-WeaponActionStartedAt)));
-        FinishWeaponAction();return;
-    }
-    if(IsReloading())
-    {
-        const auto* Health=FindComponentByClass<UFPSCombatHealthComponent>();
-        if(IsTraversing() || IsCastBlockingLeftHandAction() || (Health && Health->IsDead())){InterruptReload();return;}
-    }
-    if (WeaponState == EAKMWeaponState::QuickCombat && bDrivenRifleQuickCombat)
-    {
-        // Pose, recovery, contact and action ownership share the source clock.
-        // Real time continues during impact freeze for camera kick and movement.
-        const float SinceStart=static_cast<float>(FMath::Max(0.0,GetWorld()->GetTimeSeconds()-WeaponActionStartedAt));
-        QuickCombatPistol->AdvanceAction(FMath::Min(DeltaSeconds,SinceStart));
-        WeaponStateElapsed=QuickCombatPistol->IsOccupyingLeftHand()
-            ?QuickCombatPistol->GetActionAge():WeaponStateDuration;
-        if(!QuickCombatPistol->IsOccupyingLeftHand())FinishWeaponAction();
-        return;
-    }
-    // Input can start an action immediately before Tick. Do not charge that new
-    // action for the elapsed interval which preceded the input event.
-    WeaponStateElapsed = static_cast<float>(FMath::Max(0.0, GetWorld()->GetTimeSeconds() - WeaponActionStartedAt));
-    if(bM24EquipBoltPending)AdvanceM24EquipBolt();
-    if(IsReloading() && !AdvanceReloadStages())return;
-    const bool TubeFeedCues=IsTubeShotgunWeapon()&&IsReloading()&&!bSuper90SpeedReload&&!bReloadCycleOnly;
-    const float CueClock=TubeFeedCues?WeaponStateElapsed*Super90ReloadRate:
-        (bUsingM4Infima||HasLMG201ClothBox()||IsTubeShotgunWeapon())&&IsReloading()?ReloadSourceTime(WeaponStateElapsed):WeaponStateElapsed;
-    while (NextMechanicalCue < MechanicalCueTimes.Num() && CueClock + 0.000001f >= MechanicalCueTimes[NextMechanicalCue])
-    {
-        EmitMechanicalCue(NextMechanicalCue);
-        ++NextMechanicalCue;
-    }
-    if (GetWorld()->GetTimeSeconds() < WeaponActionStartedAt + WeaponStateDuration) return;
-    if (WeaponState == EAKMWeaponState::Reloading || WeaponState == EAKMWeaponState::ReloadingEmpty) FinishReload(); else FinishWeaponAction();
-}
