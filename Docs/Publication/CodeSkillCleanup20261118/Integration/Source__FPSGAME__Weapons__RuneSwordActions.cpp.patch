+bool URuneSwordComponent::StartSwing(FName Clip,bool Heavy,float StaminaOverride,bool bUseWeaponAttackSpeed,bool bDash)
+{
+    if(bChainSlash||bUppercut)return false;
+    // Keep stage identity when a blade replaces the thrust's motion. Damage and
+    // server reports must still use stage 3 rather than a sprint/heavy skill.
+    const int32 ComboStage=Clip==TEXT("Slash2")?2:Clip==TEXT("Thrust")?3:1;
+    auto* Profile=GetWorld()->GetGameInstance()->GetSubsystem<UColdSteelStatusModel>();
+    const auto* Item=Profile?Profile->Equipped():nullptr;
+    bRiftPiercerSwing=!Heavy&&Item&&Item->Definition==TEXT("ue_frost_crystal_sword")&&
+        (Clip==TEXT("Slash1")||Clip==TEXT("Slash2")||Clip==TEXT("Thrust"));
+    if(bRiftPiercerSwing)
+    {
+        const auto* Gunsmith=GetWorld()->GetGameInstance()->GetSubsystem<UGunsmithSystem>();
+        bRiftPiercerSwing=Gunsmith&&Gunsmith->Installed(*Item).FindRef(TEXT("blade_1"))==TEXT("rift_piercer");
+    }
+    const bool OverheadFinisher=!Heavy&&ComboStage==3&&Item&&ColdSteelModularSword::UsesOverheadFinisher(*Item);
+    const bool Chixiao=Heavy&&bCharging&&bChixiaoEquipped;
+    if(!Heavy&&ComboStage==3&&Animations.Contains(HighlandRidgeThrust::Charge))
+        Clip=HighlandRidgeThrust::Finisher;
+    if(Heavy&&Clip==TEXT("HeavyRelease")&&Animations.Contains(HighlandRidgeThrust::Charge))
+        Clip=bCharging?HighlandRidgeThrust::Release:HighlandRidgeThrust::Counter;
+    if(Chixiao)
+    {
+        auto* Animation=ChixiaoAnimation();
+        const auto* Mesh=Viewmodel?Viewmodel->GetSkeletalMeshAsset():nullptr;
+        if(!Animation||!Mesh||Animation->GetSkeleton()!=Mesh->GetSkeleton())return false;
+        Clip=TEXT("ChixiaoHeavy");Animations.Add(Clip,Animation);
+    }
+    const bool RisingDragon=!Heavy&&ComboStage==3&&Item&&ColdSteelModularSword::UsesRisingDragonFinisher(*Item);
+    if(OverheadFinisher)Clip=TEXT("Overhead");
+    if(RisingDragon)
+    {
+        UAnimSequence* Uppercut=UppercutAnimation();
+        const auto* Mesh=Viewmodel?Viewmodel->GetSkeletalMeshAsset():nullptr;
+        if(!Uppercut||!Mesh||Uppercut->GetSkeleton()!=Mesh->GetSkeleton())return false;
+        Clip=TEXT("Uppercut");Animations.Add(Clip,Uppercut);
+    }
+    if(!Animations.FindRef(Clip))return false;
+    uint32 GenericReceipt=0;
+    // Special attacks keep their existing authority. Ordinary swings register
+    // on the same PlayerState channel as food use, before any contact exists.
+    if(!Heavy&&!bDash&&Clip!=TEXT("PommelStrike")&&Clip!=HighlandBreakSweep::Clip&&
+        GetNetMode()!=NM_Standalone)
+    {
+        auto* Net=Character->GetPlayerState<AColdSteelPlayerState>();
+        if(!Net)return false;
+        const uint8 Family=Clip==TEXT("Overhead")&&ComboStage!=3?
+            ColdSteelGenericMelee::SwordOverhead:ColdSteelGenericMelee::Sword;
+        GenericReceipt=Net->RequestGenericMeleeStart(Character.Get(),InstanceId,Family,uint8(ComboStage));
+        if(!GenericReceipt)return false;
+    }
+    if(++NetworkBladeSerial==0)++NetworkBladeSerial;
+    if(!Heavy||!bCharging)ClearOath();
+    SwingWaveRange=SwingWaveScale=0.f;
+    using GaleWing::EAttack;
+    const bool Gale = Clip!=TEXT("PommelStrike") && HasGaleGuard(Item);
+    const EAttack GaleAttack = Heavy ? EAttack::Heavy : bDash ? EAttack::Dash :
+        Clip==HighlandBreakSweep::Clip ? EAttack::Sweep : EAttack::Swing;
+    const bool RemoteGaleSwing = Gale && !Character->HasAuthority() &&
+        (GaleAttack==EAttack::Swing || GaleAttack==EAttack::Dash);
+    float GalePaid=0.f;
+    bool bRuneSwordCooldownTrait=false;
+    bQueuedQuickCombat=false;bQuickCombatStrike=false;bQuickCombatContactDone=false;
+    if(Profile)
+    {
+        if(Item)
+        {
+            const auto Stats=ColdSteelMelee::Evaluate(*Item,Profile);
+            Damage=Stats.Damage;AttackRate=Stats.AttackRate;Reach=Stats.BaseReach;MeleeModifiers=Stats.Modifiers;
+            SwingKnockbackCM=Stats.KnockbackCM;
+            bRuneSwordCooldownTrait=Item->Definition==TEXT("ue_rune_sword");
+            const auto* Enchant=GetWorld()->GetGameInstance()->GetSubsystem<UColdSteelEnhancementSystem>();
+            const auto* Gunsmith=GetWorld()->GetGameInstance()->GetSubsystem<UGunsmithSystem>();
+            if(Heavy&&Enchant&&Gunsmith&&Gunsmith->IsMelee(Item->Definition)&&Enchant->Effect(*Item,TEXT("riftSlash"))>0.)
+            {
+                const auto Flight=SwordWaveTuning::RiftFlight(Enchant,Item);
+                SwingWaveRange=Flight.RangeCM;
+                SwingWaveScale=Enchant->Effect(*Item,TEXT("riftSlashDamageScale"));
+                SwingWaveSpeed=Flight.SpeedCM;
+            }
+        }
+        const double StaminaCost=Heavy&&bCharging?ColdSteelMelee::HeavyReleaseStamina(Item,Profile):
+            StaminaOverride>=0.f?StaminaOverride:ColdSteelMelee::AttackStamina(Item,Profile);
+        const float BeforeStamina=Profile->Stamina();
+        if(RemoteGaleSwing)
+        {
+            auto* PS=Character->GetPlayerState<AColdSteelPlayerState>();
+            if(!PS || !Profile->CanSpendStamina(StaminaCost)){bQueuedAttack=false;return false;}
+            PS->ServerPayGaleSwing(Character.Get(),InstanceId,NetworkBladeSerial,bDash);
+        }
+        else if(!Profile->SpendStamina(StaminaCost)){bQueuedAttack=false;return false;}
+        if(Gale && Character->HasAuthority())
+            GalePaid=BeforeStamina-Profile->Stamina()+(bCharging?TakeGaleCharge():0.f);
+        OathPaidRelease=Heavy?FMath::Max(0.f,BeforeStamina-Profile->Stamina()):0.f;
+    }
+    OathReleaseStamp=Heavy&&bCharging?OathClock():0.;
+    if(Heavy&&bCharging)CommitOathRelease(OathReleaseStamp,NetworkBladeSerial);
+    SetHeavyCharging(false,Heavy,RemoteGaleSwing && bCharging ? NetworkBladeSerial : 0);
+    bAttacking=true;bQueuedAttack=bReturningCharge=false;bHeavyAttack=Heavy;
+    bChixiaoHeavy=Chixiao;ChixiaoStrikeIndex=-1;
+    // The ridge thrust retains the heavy attack's damage and target rules.
+    // The normal combo thrust also carries a single-target cap and a one-metre step.
+    bThrustAttack=Clip==TEXT("Thrust");bPommelAttack=Clip==TEXT("PommelStrike");
+    bOverheadAttack=Clip==TEXT("Overhead");
+    bLungeStarted=bLungeBlocked=false;
+    // The counterweight sits behind the guard on the hilt axis: each sword keeps
+    // its own pommel length instead of borrowing the rune sword's number.
+    PommelDepthCM=ModularSword?FMath::Clamp(-ColdSteelModularSword::LocalBounds(ModularSword).Min.Z,RuneSwordPommelRhythm::BladeBaseCM+6.f,40.f)
+        :RuneSwordPommelRhythm::CounterweightCM;
+    LungeDirection=FVector::ZeroVector;
+    // Snapshot the current action's combo bonus once, not the number of targets hit.
+    // The independent quick-combat strike supplies its own skill damage below.
+    HitActors.Reset();SwingDamage=Damage*(Heavy?MeleeModifiers.HeavyMultiplier(ChargedMultiplier):MeleeModifiers.ComboMultiplier(ComboStage));
+    bHeavyTrainingPending=Heavy;HeavyTrainingHits=HeavyTrainingKills=0;bAutoHeavyRelease=false;
+    // Martial skills keep their own action clock. Generic weapon/attribute
+    // attack speed applies only to ordinary attacks, including combo finishers.
+    SwingRate=!Heavy&&bUseWeaponAttackSpeed?AttackRate:LightningHaste::ActionSpeed(GetOwner());
+    if(Clip==HighlandBreakSweep::Clip)SwingRate*=HighlandBreakSweep::PlaybackRate;
+    if(Clip==HighlandRidgeThrust::Finisher)SwingRate*=HighlandRidgeThrust::FinisherPlaybackRate;
+    SwingReach=RuneSwordCombatTuning::ScaledReach(Reach,ComboStage==3?RuneSwordThrustRhythm::ReachBonus:0.f)*MeleeModifiers.Range;
+    SwingRangeMultiplier=RuneSwordCombatTuning::RangeMultiplier*MeleeModifiers.Range;
+    if(Heavy){SwingReach*=MeleeModifiers.MartialRange;SwingRangeMultiplier*=MeleeModifiers.MartialRange;}
+    SwingHitReactionMultiplier=MeleeModifiers.HitReaction;
+    // 两条独立通道：剑刃攻击（导魔符文）与配重锤快速近战（凝碧星核），互不混用。
+    SwingRuneVulnerability=MeleeModifiers.RuneVulnerability;SwingRuneVulnerabilitySeconds=MeleeModifiers.RuneVulnerabilitySeconds;
+    ContactStart=bOverheadAttack?RuneSwordOverheadRhythm::ContactStart:(Heavy?RuneSwordHeavyRhythm::ContactStart:(bThrustAttack?RuneSwordThrustRhythm::ContactStart:(bPommelAttack?RuneSwordPommelRhythm::ContactStart:RuneSwordRhythm::ContactStart)));
+    ContactEnd=bOverheadAttack?RuneSwordOverheadRhythm::ContactEnd:(Heavy?RuneSwordHeavyRhythm::ContactEnd:(bThrustAttack?RuneSwordThrustRhythm::ContactEnd:(bPommelAttack?RuneSwordPommelRhythm::ContactEnd:RuneSwordRhythm::ContactEnd)));
+    if(RisingDragon){ContactStart=RuneSwordUppercutMotion::ReleaseStart;ContactEnd=RuneSwordUppercutMotion::Finish;}
+    if(Clip==HighlandBreakSweep::Clip){ContactStart=HighlandBreakSweep::Contact;ContactEnd=HighlandBreakSweep::Release;}
+    if(HighlandRidgeThrust::IsRelease(Clip))
+    {
+        const float Lead=HighlandRidgeThrust::LeadFor(Clip);
+        ContactStart=Lead+HighlandRidgeThrust::ContactStart;
+        ContactEnd=Lead+HighlandRidgeThrust::ContactEnd;
+        SwingReach*=HighlandRidgeThrust::ReachScale;
+    }
+    bImpactFeedbackPlayed=bSwingCuePlayed=false;
+    SwingTrainingHits=0;
+    SwingPoison=ColdSteelCombat::Snapshot(Character.Get()).Poison;
+    SwingSkills=ColdSteelSkills::Snapshot(Character.Get());
+    SwingSkills.GenericMeleeSerial=GenericReceipt;
+    CaptureAzureDragonAttack(Profile);
+    SwingSkills.bRifle=false;SwingSkills.bPistol=false;SwingSkills.WeakpointPercent=0;
+    // 联机上报：轻重击/连段语义，服务端按影子档案的 MeleeModifiers 同参复算倍率。
+    SwingSkills.AttackMeta = uint8(Heavy ? 0x10 : (ComboStage & 0x0F));
+    UTangDaoGuardComponent::StampBladeAttack(Character.Get(),SwingSkills);
+    UPanChiGuardComponent::StampBladeAttack(Character.Get(),SwingSkills);
+    if(!SwingSkills.GuardAttackSerial)SwingSkills.GuardAttackSerial=NetworkBladeSerial;
+    if(Gale && Character->HasAuthority())
+    {
+        SwingSkills.GalePaymentKey=GaleWing::Key(GaleAttack,SwingSkills.GuardAttackSerial);
+        RecordGalePayment(SwingSkills.GalePaymentKey,InstanceId,GalePaid);
+    }
+    SwingSkills.HeavyReleaseTime=OathReleaseStamp;
+    SwingSkills.GuardSourceInstance=InstanceId;
+    SwingSkills.bRisingDragonFinisher=RisingDragon;
+    // The stage keeps its existing grip/global poise modifiers when its motion changes.
+    if(ComboStage==3&&!Heavy)SwingSkills.ToughnessDamageMultiplier*=MeleeModifiers.ComboThirdToughness;
+    if(Heavy)SwingSkills.ToughnessDamageMultiplier*=MeleeModifiers.HeavyToughness;
+    if(Heavy && bBroadbladeInstalled)SwingSkills.ToughnessDamageMultiplier*=HighlandBreakSweep::HeavyToughness;
+    ApplyOathToShot(SwingSkills);
+    // 命中形式：配重锤是钝器，其余挥砍与突刺按锐器结算削韧。
+    SwingSkills.AttackForm=bPommelAttack?EMonsterAttackForm::Blunt:EMonsterAttackForm::Blade;
+    // 符文长剑专属；按出手时的武器身份固定，高地与其他共用动作的剑不继承。
+    // 基础 0.5 秒；金色符文强化再追加装备值（合计 1.0 秒），同一挥只结算一次。
+    SwingCooldownReduceSeconds=bRuneSwordCooldownTrait?.5f+static_cast<float>(MeleeModifiers.CooldownReduceSecondsPerHit):0.f;bSwingCooldownReduced=false;
+    SetClip(Clip,false);
+    if(Animations.Contains(HighlandRidgeThrust::Charge)&&!Character->HasAuthority()&&
+        (Clip==TEXT("Slash1")||Clip==TEXT("Slash2")||HighlandRidgeThrust::IsRelease(Clip)))
+    {
+        const uint8 RidgeMeta=Clip==HighlandRidgeThrust::Dash?0x16:
+            Clip==HighlandRidgeThrust::Counter?RuneSwordGuardTuning::ClovenAttackMeta:SwingSkills.AttackMeta;
+        if(auto* PS=Character->GetPlayerState<AColdSteelPlayerState>())
+        {
+            const auto* GS=GetWorld()->GetGameState();
+            PS->ServerBeginRidgeStrike(Character.Get(),InstanceId,SwingSkills.GuardAttackSerial,RidgeMeta,
+                GS?GS->GetServerWorldTimeSeconds():GetWorld()->GetTimeSeconds());
+        }
+    }
+    ChooseAzureDragonClaw();
+    if(OverheadFinisher)Elapsed=RuneSwordOverheadRhythm::FinisherEntry;
+    if(auto* Arms=Cast<URuneSwordMeshComponent>(Viewmodel))
+        Arms->LimitLocomotionEntry((RisingDragon?RuneSwordRisingDragon::WindupEnd:ContactStart-Elapsed)/FMath::Max(.01f,SwingRate));
+    if(OverheadFinisher)SamplePose(Elapsed);
+    if(Heavy && bBroadbladeInstalled)GrantBroadbladeSweep(InstanceId);
+    return true;
+}
+
+void URuneSwordComponent::ReleaseSlashWave(const FTransform& Aim)
+{
+    if(!bHeavyAttack||SwingWaveRange<=0.f||SwingWaveScale<=0.f||SwingWaveSpeed<=0.f||!Character.IsValid())return;
+    if(!Character->HasAuthority())
+    {
+        if(auto* PS=Character->GetPlayerState<AColdSteelPlayerState>())
+            PS->ServerReleaseRiftSlash(++RiftReleaseSerial,InstanceId,Aim.GetLocation(),Aim.GetUnitAxis(EAxis::X),SwingSkills.GuardAttackSerial,SwingSkills.AzureDragonPhysicalMultiplier>1.f,SwingSkills.AttackMeta==0x15);
+        return;
+    }
+    auto WaveSkills=SwingSkills;WaveSkills.AttackMeta|=0x40;
+    SpawnAuthoritySlashWave(Aim,SwingDamage*SwingWaveScale,SwingWaveRange,SwingWaveSpeed,WaveSkills);
+}
+
+void URuneSwordComponent::SpawnAuthoritySlashWave(const FTransform& Aim,float WaveDamage,float Range,float Speed,const FColdSteelSkillShot& Shot)
+{
+    if(!GetOwner()->HasAuthority()||!Character.IsValid())return;
+    FActorSpawnParameters Spawn;Spawn.Owner=Character.Get();Spawn.Instigator=Character.Get();
+    Spawn.SpawnCollisionHandlingOverride=ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+    if(auto* Wave=GetWorld()->SpawnActor<AFPSRiftSlashProjectile>(Aim.GetLocation(),Aim.Rotator(),Spawn))
+        Wave->Launch(Aim,WaveDamage,Range,Speed,Shot,SlashWaveMesh,SlashWaveMaterial,SlashWaveMotes,HitSound);
+}
