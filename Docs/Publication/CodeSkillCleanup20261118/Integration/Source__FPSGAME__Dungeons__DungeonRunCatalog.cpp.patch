+void UDungeonRunSubsystem::ParseCatalog(const FString& Json)
+{
+    RoomIds.Reset();
+    ModuleTrackingAreas.Reset();
+    HallTrafficBoxes.Reset();
+    StartPosition = FVector::ZeroVector;
+    ReservedStartRoom.Init();
+    StartNormal = FVector::ForwardVector;
+
+    TSharedPtr<FJsonObject> Root;
+    if (Json.IsEmpty() || !FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Json), Root) || !Root.IsValid())
+    {
+        UE_LOG(LogTemp, Warning, TEXT("[DungeonRun] 模块目录不可解析，房间分类为空。"));
+        return;
+    }
+
+    const TArray<TSharedPtr<FJsonValue>>* Ids = nullptr;
+    if (Root->TryGetArrayField(TEXT("room_ids"), Ids) && Ids)
+    {
+        for (const TSharedPtr<FJsonValue>& V : *Ids)
+            if (V.IsValid() && V->Type == EJson::String) RoomIds.Add(V->AsString());
+    }
+    const TArray<TSharedPtr<FJsonValue>>* Modules = nullptr;
+    if (Root->TryGetArrayField(TEXT("modules"), Modules))
+        for (const auto& Value : *Modules)
+        {
+            const auto Module = Value->AsObject();
+            FString Id;
+            const TArray<TSharedPtr<FJsonValue>>* Clear = nullptr;
+            if (!Module.IsValid() || !Module->TryGetStringField(TEXT("id"), Id)
+                || (Id != TEXT("FacilityReceptionHall") && Id != TEXT("FacilityTransit"))
+                || !Module->TryGetArrayField(TEXT("scene_keep_clear"), Clear)) continue;
+            auto& Boxes = HallTrafficBoxes.FindOrAdd(Id);
+            for (const auto& Entry : *Clear)
+                if (const auto Box = Entry->AsObject(); Box.IsValid())
+                    Boxes.Add(FBox(ReadVec3(Box, TEXT("min")), ReadVec3(Box, TEXT("max"))));
+        }
+    // Use the authored theme sequences, not Route1/2/3: each route contains two
+    // independently drawn regions, and the same region can occupy any branch.
+    const TMap<FString, FString> AreaNames = {
+        {TEXT("freight"), TEXT("货运区")}, {TEXT("medical"), TEXT("医疗区")},
+        {TEXT("treatment"), TEXT("焚化区")}, {TEXT("staff_living"), TEXT("生活区")},
+        {TEXT("ecology"), TEXT("生态区")}, {TEXT("power"), TEXT("发电区")}
+    };
+    const TSharedPtr<FJsonObject>* Themes = nullptr;
+    const TArray<TSharedPtr<FJsonValue>>* Routes = nullptr;
+    if (Root->TryGetObjectField(TEXT("themed_routes"), Themes) && (*Themes)->TryGetArrayField(TEXT("routes"), Routes))
+        for (const auto& Value : *Routes)
+        {
+            const auto Theme = Value->AsObject();
+            FString Id;
+            const TArray<TSharedPtr<FJsonValue>>* Sequence = nullptr;
+            if (!Theme.IsValid() || !Theme->TryGetStringField(TEXT("id"), Id)
+                || !Theme->TryGetArrayField(TEXT("sequence"), Sequence)) continue;
+            FString Name;
+            if (!Theme->TryGetStringField(TEXT("display_name"), Name) || Name.IsEmpty()) Name = AreaNames.FindRef(Id);
+            if (Name.IsEmpty()) continue;
+            for (const auto& Module : *Sequence) ModuleTrackingAreas.Add(Module->AsString(), Name);
+        }
+    StartPosition = ReadVec3(Root, TEXT("start_position"));
+    if (Root->HasField(TEXT("reserved_min")) && Root->HasField(TEXT("reserved_max")))
+        ReservedStartRoom=FBox(ReadVec3(Root,TEXT("reserved_min")),ReadVec3(Root,TEXT("reserved_max")));
+    const TSharedPtr<FJsonObject>* Shrine=nullptr;
+    if(Root->TryGetObjectField(TEXT("start_shrine"),Shrine))ShrineConfig=*Shrine;
+    const FVector N = ReadVec3(Root, TEXT("start_normal"));
+    if (!N.IsNearlyZero()) StartNormal = N;
+}
