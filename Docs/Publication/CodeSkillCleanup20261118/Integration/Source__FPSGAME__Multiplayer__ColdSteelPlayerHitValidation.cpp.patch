+bool AColdSteelPlayerState::ConsumeServerAmmo(const FColdSteelItem* Item,int32 Rounds,double Now,FString& OutReason)
+{
+    if(!Item)return true;
+    if(ColdSteelInventory::IsDualPistol(*Item))return ConsumePistolAmmo(*Item,Rounds,OutReason);
+    if(ColdSteelInventory::IsMeleeWeapon(*Item)||ColdSteelInventory::IsBow(*Item))return true;
+    const auto* G=GetGameInstance()?GetGameInstance()->GetSubsystem<UGunsmithSystem>():nullptr;
+    if(G&&(G->IsStaff(Item->Definition)||G->IsTool(Item->Definition)))return true;
+    int32 Capacity=0;
+    if(G)Capacity=G->CalculateItem(*Item,G->Installed(*Item)).Capacity;
+    Capacity=FMath::Clamp(Capacity,0,1000);
+    if(Capacity<=0)Capacity=FMath::Max(1,Item->Magazine);
+    auto& Ledger=ServerGunLedgers.FindOrAdd(Item->InstanceId);
+    const auto* Shooter=Cast<AFPSGAMECharacter>(GetPawn());
+    const bool Primary=ShadowModel&&ShadowModel->Equipped()&&ShadowModel->Equipped()->InstanceId==Item->InstanceId;
+    const double ReloadSeconds=Primary&&Shooter?FMath::Max(.35f,Shooter->GetReloadSeconds(true)):
+        G?FMath::Max(.35,ColdSteelWeaponStats::Reload(Item,ShadowModel,G->CalculateItem(*Item,G->Installed(*Item)).EmptyReload)):1.;
+    if(Ledger.Magazine<0)
+    {
+        Ledger.Magazine=FMath::Clamp(Item->Magazine,0,Capacity);
+        Ledger.ReloadReadyAt=Ledger.Magazine<=0?Now+ReloadSeconds:0.;
+    }
+    if(Ledger.Magazine<=0)
+    {
+        if(Now<Ledger.ReloadReadyAt){OutReason=TEXT("reloading");return false;}
+        Ledger.Magazine=Capacity;
+    }
+    const int32 Cost=FMath::Max(1,Rounds);
+    if(Cost>Ledger.Magazine){OutReason=TEXT("magazine empty");return false;}
+    Ledger.Magazine-=Cost;
+    if(Ledger.Magazine<=0)Ledger.ReloadReadyAt=Now+ReloadSeconds;
+    return true;
+}
