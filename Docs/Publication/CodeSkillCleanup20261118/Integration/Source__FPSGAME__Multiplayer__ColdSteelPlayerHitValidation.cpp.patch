+void AColdSteelPlayerState::ServerRememberPistolShot_Implementation(uint32 Sequence,const FString& Instance,int32 ActiveSlot,int32 Rounds,APawn* SourcePawn)
+{
+    if(!HasAuthority()||!Sequence||!ShadowModel||!SourcePawn||SourcePawn!=GetPawn()||
+        (ActiveSlot!=6&&ActiveSlot!=9)||RegisteredPistolShots.Contains(Sequence))return;
+    if(PistolProcessedShot&&static_cast<int32>(Sequence-PistolProcessedShot)<=0)return;
+    PistolProcessedShot=Sequence;TickPistolAuthority();
+    // Reliable owner receipts remove accepted AND rejected predictions. A
+    // rejected round must not leave the owner's display permanently debited.
+    struct FReceiptOnExit {AColdSteelPlayerState* Owner;~FReceiptOnExit(){Owner->SendPistolAmmo();}} Receipt{this};
+    if(HasAuthorityConsumableReservation(SourcePawn))return;
+    const auto* Gun=ShadowModel->FindItem(Instance);
+    if(!Gun||!ColdSteelInventory::IsDualPistol(*Gun)||Gun->Place!=1||
+        (Gun->Cell!=ActiveSlot&&Gun->Cell!=(ActiveSlot==6?8:11))||Rounds<1)return;
+    const auto* G=GetGameInstance()->GetSubsystem<UGunsmithSystem>();
+    if(!G||Rounds>G->CalculateItem(*Gun,G->Installed(*Gun)).Capacity)return;
+    if(Rounds>1&&!ColdSteelCombat::Convergence(GetGameInstance()->GetSubsystem<UColdSteelEnhancementSystem>(),Gun).Enabled)return;
+    if(const auto* Health=SourcePawn->FindComponentByClass<UFPSCombatHealthComponent>();Health&&Health->IsDead())return;
+    const double Now=GetWorld()->GetTimeSeconds();
+    auto& Ledger=ServerGunLedgers.FindOrAdd(Instance);
+    if(Ledger.LastSequence&&static_cast<int32>(Sequence-Ledger.LastSequence)<=0)return;
+    const FColdSteelItem FiredGun=*Gun;
+    FString Reason;if(!ConsumeServerAmmo(&FiredGun,Rounds,Now,Reason))return;
+    Ledger.LastSequence=Sequence;Ledger.LastServerAt=Now;Ledger.CriticalRolls.Add(Sequence,FMath::FRand());
+    for(auto It=Ledger.CriticalRolls.CreateIterator();It;++It)
+        if(static_cast<int32>(Sequence-It.Key())>256)It.RemoveCurrent();
+    for(auto It=RegisteredPistolShots.CreateIterator();It;++It)
+        if(It.Value().Pawn.Get()!=SourcePawn||Now-It.Value().At>30.)It.RemoveCurrent();
+    FRegisteredPistolShot Shot;Shot.Item=FiredGun;Shot.Pawn=SourcePawn;Shot.At=Now;Shot.Rounds=Rounds;
+    RegisteredPistolShots.Add(Sequence,MoveTemp(Shot));
+    if (!SourcePawn->IsLocallyControlled())
+    {
+        const FString Muzzle = G->Installed(FiredGun).FindRef(TEXT("muzzle"));
+        WeaponShotNoise::Report(SourcePawn, FiredGun.Definition, Muzzle, WeaponShotNoise::PistolSuppressed(FiredGun.Definition, Muzzle));
+    }
+    RecordAuthorityShotRecovery(SourcePawn,ColdSteelWeaponStats::Interval(&FiredGun,ShadowModel,G->CalculateItem(FiredGun,G->Installed(FiredGun)).Interval)/LightningHaste::ActionSpeed(SourcePawn));
+}
