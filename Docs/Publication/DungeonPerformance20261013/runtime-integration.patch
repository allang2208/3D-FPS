diff --git a/Source/FPSGAME/UI/FPSPerformanceCaptureCommands.cpp b/Source/FPSGAME/UI/FPSPerformanceCaptureCommands.cpp
new file mode 100644
--- /dev/null
+++ b/Source/FPSGAME/UI/FPSPerformanceCaptureCommands.cpp
@@ -0,0 +1,81 @@
+#include "FPSPerformanceMetrics.h"
+#include "CoreGlobals.h"
+#include "Dom/JsonObject.h"
+#include "Engine/World.h"
+#include "HAL/IConsoleManager.h"
+#include "Misc/FileHelper.h"
+#include "Misc/Paths.h"
+#include "Serialization/JsonSerializer.h"
+
+namespace
+{
+TAutoConsoleVariable<int32> MonsterCaptureVersion(TEXT("fps.Perf.MonsterCaptureVersion"), 1,
+    TEXT("Version of the opt-in AI and render attribution capture."), ECVF_ReadOnly);
+TWeakObjectPtr<UFPSPerformanceMetricsSubsystem> CaptureMetrics;
+bool bCaptureActive = false, bPreviousRecording = false;
+int32 PreviousSampling = 1, PreviousInventory = 0;
+
+void EndCaptureResources()
+{
+    if (!bCaptureActive) return;
+    if (auto* Metrics = CaptureMetrics.Get()) Metrics->SetRecording(bPreviousRecording);
+    if (auto* CVar = IConsoleManager::Get().FindConsoleVariable(TEXT("fps.Perf.RenderResourceSampling")))
+        CVar->Set(PreviousSampling, ECVF_SetByConsole);
+    if (auto* CVar = IConsoleManager::Get().FindConsoleVariable(TEXT("fps.Perf.GpuResourceInventory")))
+        CVar->Set(PreviousInventory, ECVF_SetByConsole);
+    // Match the engine's stat namedevents reference-counted enable/disable.
+    GCycleStatsShouldEmitNamedEvents = FMath::Max(0, GCycleStatsShouldEmitNamedEvents - 1);
+    CaptureMetrics.Reset();
+    bCaptureActive = false;
+}
+
+FAutoConsoleCommandWithWorldAndArgs MonsterCapture(TEXT("fps.Perf.MonsterCapture"),
+    TEXT("Diagnostic only: begin | end | export <receipt.json under Saved>. No gameplay or quality changes."),
+    FConsoleCommandWithWorldAndArgsDelegate::CreateLambda([](const TArray<FString>& Args, UWorld* World)
+    {
+        if (Args.IsEmpty()) return;
+        if (Args[0] == TEXT("end")) { EndCaptureResources(); return; }
+        auto* Metrics = World ? World->GetSubsystem<UFPSPerformanceMetricsSubsystem>() : nullptr;
+        if (!Metrics) return;
+        if (Args[0] == TEXT("begin"))
+        {
+            if (bCaptureActive) return;
+            CaptureMetrics = Metrics;
+            bPreviousRecording = Metrics->IsRecording();
+            Metrics->SetRecording(true);
+            if (auto* CVar = IConsoleManager::Get().FindConsoleVariable(TEXT("fps.Perf.RenderResourceSampling")))
+            { PreviousSampling = CVar->GetInt(); CVar->Set(1, ECVF_SetByConsole); }
+            // Full RHI allocation enumeration can itself stall allocation.
+            // Keep the passive budget/morph observer, omit that costly inventory.
+            if (auto* CVar = IConsoleManager::Get().FindConsoleVariable(TEXT("fps.Perf.GpuResourceInventory")))
+            { PreviousInventory = CVar->GetInt(); CVar->Set(0, ECVF_SetByConsole); }
+            ++GCycleStatsShouldEmitNamedEvents;
+            bCaptureActive = true;
+            UE_LOG(LogTemp, Display, TEXT("MONSTER_CAPTURE_RESOURCES_BEGIN"));
+        }
+        else if (Args[0] == TEXT("export") && Args.Num() == 2)
+        {
+            FString Receipt = FPaths::ConvertRelativePathToFull(Args[1]);
+            FPaths::NormalizeFilename(Receipt);
+            FPaths::CollapseRelativeDirectories(Receipt);
+            const FString Saved = FPaths::ConvertRelativePathToFull(FPaths::ProjectSavedDir());
+            if (!FPaths::IsUnderDirectory(Receipt, Saved)) return;
+            // Called only after stopping the trace: the scene scan and JSON
+            // serialization must not become part of the measured combat window.
+            const auto Snapshot = Metrics->BuildSnapshot(10, World->GetFirstPlayerController());
+            UFPSPerformanceMetricsSubsystem::ExportSnapshotAsync(Snapshot,
+                [Receipt](bool bSaved, const FString& Path, double ElapsedMs)
+                {
+                    auto Root = MakeShared<FJsonObject>();
+                    Root->SetBoolField(TEXT("saved"), bSaved);
+                    Root->SetStringField(TEXT("report_path"), Path);
+                    Root->SetNumberField(TEXT("export_ms"), ElapsedMs);
+                    Root->SetStringField(TEXT("completed_utc"), FDateTime::UtcNow().ToIso8601());
+                    FString Json;
+                    FJsonSerializer::Serialize(Root, TJsonWriterFactory<>::Create(&Json));
+                    FFileHelper::SaveStringToFile(Json, *Receipt, FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM);
+                    UE_LOG(LogTemp, Display, TEXT("MONSTER_CAPTURE_REPORT saved=%d path=%s"), bSaved, *Path);
+                });
+        }
+    }));
+}
diff --git a/Source/FPSGAME/UI/FPSPerformanceEncounterCapture.cpp b/Source/FPSGAME/UI/FPSPerformanceEncounterCapture.cpp
new file mode 100644
--- /dev/null
+++ b/Source/FPSGAME/UI/FPSPerformanceEncounterCapture.cpp
@@ -0,0 +1,146 @@
+#include "FPSPerformanceMetrics.h"
+#include "HAL/IConsoleManager.h"
+#include "Dom/JsonObject.h"
+
+namespace
+{
+TAutoConsoleVariable<int32> GpuInventoryMode(TEXT("fps.Perf.GpuResourceInventory"),0,
+    TEXT("Opt-in event-triggered tracked RHI inventory. Enumeration may stall resource allocation; its interval/cost is exported."));
+}
+
+bool UFPSPerformanceMetricsSubsystem::IsGpuInventoryEnabled() { return GpuInventoryMode.GetValueOnGameThread()!=0; }
+void UFPSPerformanceMetricsSubsystem::SetGpuInventoryEnabled(bool bEnabled)
+{ GpuInventoryMode->Set(bEnabled?1:0,ECVF_SetByConsole); }
+
+void UFPSPerformanceMetricsSubsystem::ResetEncounterDiagnostics()
+{
+    ActiveCombatWindow.Reset(); CombatWindows.Reset(); EncounterEvents.Reset(); GpuResourceInventories.Reset();
+    GpuInventoryRequests.Reset(); bGpuInventoryPending=false; NextGpuInventorySeconds=0.;
+    CombatWindowsOverwritten=EncounterEventsOverwritten=GpuInventoriesOverwritten=0;
+}
+
+void UFPSPerformanceMetricsSubsystem::StartCombatWindow(const UObject* Context, const FString& Reason)
+{
+    auto* Self=Find(Context);
+    if(!Self || !Self->bRecording)return;
+    const double Now=FPlatformTime::Seconds();
+    if(Self->ActiveCombatWindow && Now>Self->ActiveCombatWindow->RequestedEndSeconds) Self->ArchiveCombatWindow(true);
+    if(!Self->ActiveCombatWindow)
+    {
+        Self->ActiveCombatWindow=MakeUnique<FFPSCombatWindow>();
+        auto& Window=*Self->ActiveCombatWindow;
+        Window.Trigger=Reason; Window.TriggerSeconds=Now; Window.RequestedEndSeconds=Now+20.;
+        const int32 First=(Self->WriteIndex-Self->SampleCount+MaxSamples)%MaxSamples;
+        for(int32 I=0;I<Self->SampleCount;++I)
+        {
+            const auto& Frame=Self->FrameSamples[(First+I)%MaxSamples];
+            if(Frame.Seconds<Now-3.)continue;
+            if(Window.Frames.Num()<MaxCombatFrames)Window.Frames.Add(Frame);
+            else Window.bFrameCapacityLimited=true;
+        }
+        for(const auto& Event:Self->EncounterEvents)
+            if(Event.EndSeconds>=Now-3.)Window.Events.Add(Event);
+        RequestGpuResourceInventory(Context,Reason+TEXT(" / wave-start"));
+        RequestGpuResourceInventory(Context,Reason+TEXT(" / wave+10s"),10.);
+    }
+    else
+    {
+        // Two halls often start together. Keep one window; additional triggers
+        // can extend it, but never retain an unbounded session of per-frame data.
+        auto& Window=*Self->ActiveCombatWindow;
+        Window.RequestedEndSeconds=FMath::Min(Window.TriggerSeconds+30.,FMath::Max(Window.RequestedEndSeconds,Now+20.));
+    }
+    RecordMarker(Context,TEXT("Hall.CaptureTrigger"),Reason,true);
+}
+
+void UFPSPerformanceMetricsSubsystem::ArchiveCombatWindow(bool bComplete)
+{
+    if(!ActiveCombatWindow)return;
+    CopyResourcesForWindow(*ActiveCombatWindow);
+    ActiveCombatWindow->bComplete=bComplete && !ActiveCombatWindow->bFrameCapacityLimited
+        && !ActiveCombatWindow->Frames.IsEmpty()
+        && ActiveCombatWindow->Frames.Last().Seconds>=ActiveCombatWindow->RequestedEndSeconds;
+    if(CombatWindows.Num()>=MaxCombatWindows){CombatWindows.RemoveAt(0);++CombatWindowsOverwritten;}
+    CombatWindows.Add(MakeShared<FFPSCombatWindow>(MoveTemp(*ActiveCombatWindow)));
+    ActiveCombatWindow.Reset();
+}
+
+void UFPSPerformanceMetricsSubsystem::CopyResourcesForWindow(FFPSCombatWindow& Window) const
+{
+    Window.ResourceSamples.Reset();
+    const int32 First=RenderResourceSamples.Num()==MaxRenderResourceSamples?RenderResourceWriteIndex:0;
+    for(int32 I=0;I<RenderResourceSamples.Num();++I)
+    {
+        const auto& Row=RenderResourceSamples[(First+I)%RenderResourceSamples.Num()];
+        const double Seconds=Row->GetNumberField(TEXT("game_seconds"));
+        if(Seconds>=Window.TriggerSeconds-3. && Seconds<=Window.RequestedEndSeconds)Window.ResourceSamples.Add(Row);
+    }
+}
+
+void UFPSPerformanceMetricsSubsystem::UpdateEncounterCapture(const FFPSRecordedFrame& Frame)
+{
+    if(ActiveCombatWindow)
+    {
+        auto& Window=*ActiveCombatWindow;
+        if(Window.Frames.IsEmpty() || Window.Frames.Last().FrameId!=Frame.FrameId)
+        {
+            if(Window.Frames.Num()<MaxCombatFrames)Window.Frames.Add(Frame);
+            else Window.bFrameCapacityLimited=true;
+        }
+        if(Frame.Seconds>=Window.RequestedEndSeconds)ArchiveCombatWindow(true);
+    }
+    PumpGpuResourceInventory(Frame.Seconds);
+}
+
+void UFPSPerformanceMetricsSubsystem::KeepEncounterEvent(const FFPSPerformanceEvent& Event)
+{
+    if(Event.bRetainForEncounter)
+    {
+        if(EncounterEvents.Num()>=MaxEncounterEvents){EncounterEvents.RemoveAt(0);++EncounterEventsOverwritten;}
+        EncounterEvents.Add(Event);
+    }
+    if(ActiveCombatWindow && (Event.bRetainForEncounter || Event.Stage==TEXT("Engine.GarbageCollection")
+        || Event.Stage==TEXT("Engine.SyncLoadPackageStart") || Event.Stage==TEXT("Engine.AsyncLoadingFlushStart")))
+    {
+        auto& Window=*ActiveCombatWindow;
+        if(Window.Events.Num()<MaxEncounterEvents)Window.Events.Add(Event);
+        else ++Window.EventsDiscarded;
+    }
+}
+
+void UFPSPerformanceMetricsSubsystem::ReadEncounterDiagnostics(FFPSPerformanceSnapshot& Snapshot) const
+{
+    Snapshot.CombatWindows=CombatWindows;
+    if(ActiveCombatWindow)
+    {
+        auto Copy=MakeShared<FFPSCombatWindow>(*ActiveCombatWindow);
+        CopyResourcesForWindow(*Copy);Snapshot.CombatWindows.Add(Copy);
+    }
+    Snapshot.EncounterEvents=EncounterEvents;
+    Snapshot.GpuResourceInventories=GpuResourceInventories;
+    Snapshot.CombatWindowsOverwritten=CombatWindowsOverwritten;
+    Snapshot.EncounterEventsOverwritten=EncounterEventsOverwritten;
+    Snapshot.GpuInventoriesOverwritten=GpuInventoriesOverwritten;
+    Snapshot.bGpuInventoryEnabled=IsGpuInventoryEnabled();
+    Snapshot.bGpuInventoryPending=bGpuInventoryPending;
+    Snapshot.GpuInventoryQueued=GpuInventoryRequests.Num();
+}
+
+void UFPSPerformanceMetricsSubsystem::RequestGpuResourceInventory(const UObject* Context,const FString& Reason,double DelaySeconds)
+{
+    auto* Self=Find(Context);
+    if(!Self || !Self->bRecording || !IsGpuInventoryEnabled())return;
+    const double Now=FPlatformTime::Seconds(), Due=Now+FMath::Max(0.,DelaySeconds);
+    for(auto& Request:Self->GpuInventoryRequests)
+        if(FMath::Abs(Request.Due-Due)<1.)
+        { Request.Reason=(Request.Reason+TEXT("; ")+Reason).Left(512);return; }
+    // Preserve a requested future sample; coalesce excess reasons into the last
+    // request rather than creating a scan for every monster in a wave.
+    if(Self->GpuInventoryRequests.Num()>=4)
+    {
+        auto& Last=Self->GpuInventoryRequests.Last();
+        Last.Reason=(Last.Reason+TEXT("; coalesced: ")+Reason).Left(512);return;
+    }
+    Self->GpuInventoryRequests.Add({Reason,Due,Now,GFrameCounter});
+    Self->GpuInventoryRequests.Sort([](const auto& A,const auto& B){return A.Due<B.Due;});
+}
diff --git a/Source/FPSGAME/UI/FPSPerformanceGpuInventory.cpp b/Source/FPSGAME/UI/FPSPerformanceGpuInventory.cpp
new file mode 100644
--- /dev/null
+++ b/Source/FPSGAME/UI/FPSPerformanceGpuInventory.cpp
@@ -0,0 +1,142 @@
+#include "FPSPerformanceMetrics.h"
+#include "Async/Async.h"
+#include "Dom/JsonObject.h"
+#include "RHI.h"
+#include "RenderingThread.h"
+#include "RHICommandList.h"
+#include "ProfilingDebugging/CpuProfilerTrace.h"
+
+namespace
+{
+struct FResourceGroup
+{
+    uint64 Bytes=0, NonTransientBytes=0, ResidentFlagBytes=0;
+    int32 Count=0;
+    void Add(const FRHIResourceStats& R)
+    {
+        Bytes+=R.SizeInBytes; ++Count;
+        if(!R.bTransient)NonTransientBytes+=R.SizeInBytes;
+        if(R.bResident)ResidentFlagBytes+=R.SizeInBytes;
+    }
+};
+
+TUniquePtr<FJsonObject> BuildInventory(const TArray<TSharedPtr<FRHIResourceStats>>& Stats)
+{
+    auto Result=MakeUnique<FJsonObject>();
+    TMap<FString,FResourceGroup> ByType, ByOwner;
+    FResourceGroup Total;
+    int32 UnknownOwner=0;
+    uint64 UnknownOwnerBytes=0;
+    TArray<TSharedPtr<FJsonValue>> Rows;
+    constexpr int32 MaxRows=128, MaxOwners=64;
+    // Engine returns resources sorted by allocation size. Aggregate all entries
+    // before truncating the exported detail, on a worker after releasing its lock.
+    for(const auto& Ptr:Stats)
+    {
+        if(!Ptr)continue;
+        const auto& R=*Ptr;
+        Total.Add(R); ByType.FindOrAdd(R.Type).Add(R);
+        const FString Owner=R.OwnerName.IsNone()?TEXT("<untracked owner>"):R.OwnerName.ToString();
+        ByOwner.FindOrAdd(Owner).Add(R);
+        if(R.OwnerName.IsNone()){++UnknownOwner;UnknownOwnerBytes+=R.SizeInBytes;}
+        if(Rows.Num()>=MaxRows)continue;
+        auto Row=MakeShared<FJsonObject>();
+        Row->SetStringField(TEXT("name"),R.Name.ToString());
+        if(R.OwnerName.IsNone())Row->SetField(TEXT("owner"),MakeShared<FJsonValueNull>());
+        else Row->SetStringField(TEXT("owner"),Owner);
+        Row->SetStringField(TEXT("type"),R.Type); Row->SetStringField(TEXT("flags"),R.Flags);
+        Row->SetNumberField(TEXT("allocation_bytes"),double(R.SizeInBytes));
+        Row->SetBoolField(TEXT("resident_flag"),R.bResident);
+        Row->SetBoolField(TEXT("has_flags"),R.bHasFlags);
+        Row->SetBoolField(TEXT("transient"),R.bTransient);
+        Row->SetBoolField(TEXT("streamable"),R.bStreaming);
+        Row->SetBoolField(TEXT("render_target"),R.bRenderTarget);
+        Row->SetBoolField(TEXT("depth_stencil"),R.bDepthStencil);
+        Row->SetBoolField(TEXT("uav"),R.bUnorderedAccessView);
+        Row->SetBoolField(TEXT("ray_tracing_acceleration_structure"),R.bRayTracingAccelerationStructure);
+        Row->SetBoolField(TEXT("marked_for_delete"),R.bMarkedForDelete);
+        Rows.Add(MakeShared<FJsonValueObject>(Row));
+    }
+    auto GroupRows=[](const TMap<FString,FResourceGroup>& Groups,int32 Limit)
+    {
+        TArray<FString> Keys; Groups.GetKeys(Keys);
+        Keys.Sort([&Groups](const FString& A,const FString& B){return Groups[A].Bytes>Groups[B].Bytes;});
+        TArray<TSharedPtr<FJsonValue>> Out;
+        for(int32 I=0;I<FMath::Min(Keys.Num(),Limit);++I)
+        {
+            const auto& G=Groups[Keys[I]];auto Row=MakeShared<FJsonObject>();
+            Row->SetStringField(TEXT("key"),Keys[I]);Row->SetNumberField(TEXT("resource_count"),G.Count);
+            Row->SetNumberField(TEXT("allocation_bytes"),double(G.Bytes));
+            Row->SetNumberField(TEXT("non_transient_allocation_bytes"),double(G.NonTransientBytes));
+            Row->SetNumberField(TEXT("resident_flag_allocation_bytes"),double(G.ResidentFlagBytes));
+            Out.Add(MakeShared<FJsonValueObject>(Row));
+        }
+        return Out;
+    };
+    Result->SetStringField(TEXT("status"),Stats.IsEmpty()?TEXT("no_tracked_resources"):TEXT("captured"));
+    Result->SetNumberField(TEXT("tracked_resource_count"),Total.Count);
+    Result->SetNumberField(TEXT("allocation_bytes"),double(Total.Bytes));
+    Result->SetNumberField(TEXT("non_transient_allocation_bytes"),double(Total.NonTransientBytes));
+    Result->SetNumberField(TEXT("resident_flag_allocation_bytes"),double(Total.ResidentFlagBytes));
+    Result->SetNumberField(TEXT("unknown_owner_count"),UnknownOwner);
+    Result->SetNumberField(TEXT("unknown_owner_allocation_bytes"),double(UnknownOwnerBytes));
+    Result->SetNumberField(TEXT("owner_group_count"),ByOwner.Num());
+    Result->SetBoolField(TEXT("resource_details_truncated"),Total.Count>MaxRows);
+    Result->SetBoolField(TEXT("owner_details_truncated"),ByOwner.Num()>MaxOwners);
+    Result->SetArrayField(TEXT("top_resources"),Rows);
+    Result->SetArrayField(TEXT("by_type"),GroupRows(ByType,64));
+    Result->SetArrayField(TEXT("top_owners"),GroupRows(ByOwner,MaxOwners));
+    return Result;
+}
+}
+
+void UFPSPerformanceMetricsSubsystem::PumpGpuResourceInventory(double Now)
+{
+    if(!IsGpuInventoryEnabled()){GpuInventoryRequests.Reset();return;}
+    if(bGpuInventoryPending || GpuInventoryRequests.IsEmpty() || Now<NextGpuInventorySeconds
+        || Now<GpuInventoryRequests[0].Due)return;
+    const auto Request=GpuInventoryRequests[0];GpuInventoryRequests.RemoveAt(0);
+    bGpuInventoryPending=true;NextGpuInventorySeconds=Now+5.;
+    const uint64 Generation=CaptureGeneration;
+    const TWeakObjectPtr<UFPSPerformanceMetricsSubsystem> WeakThis(this);
+    RecordMarker(this,TEXT("Observer.GpuInventoryQueued"),Request.Reason,true);
+    ENQUEUE_RENDER_COMMAND(FPSGpuInventory)([WeakThis,Generation,Request](FRHICommandListImmediate&)
+    {
+        TRACE_CPUPROFILER_EVENT_SCOPE(FPS_Perf_GpuInventoryEnumeration);
+        const double Begin=FPlatformTime::Seconds();
+        const uint64 RenderFrame=GFrameNumberRenderThread;
+        TArray<TSharedPtr<FRHIResourceStats>> Stats;
+#if RHI_ENABLE_RESOURCE_INFO
+        RHIGetTrackedResourceStats(Stats);
+#endif
+        const double End=FPlatformTime::Seconds();
+        Async(EAsyncExecution::ThreadPool,[WeakThis,Generation,Request,Begin,End,RenderFrame,Stats=MoveTemp(Stats)]() mutable
+        {
+            const double AggregateBegin=FPlatformTime::Seconds();
+            auto Row=BuildInventory(Stats);
+#if !RHI_ENABLE_RESOURCE_INFO
+            Row->SetStringField(TEXT("status"),TEXT("resource_tracking_not_compiled"));
+#endif
+            Row->SetStringField(TEXT("reason"),Request.Reason);
+            Row->SetStringField(TEXT("requested_engine_frame"),LexToString(Request.RequestedFrame));
+            Row->SetStringField(TEXT("collection_render_frame"),LexToString(RenderFrame));
+            Row->SetNumberField(TEXT("requested_seconds"),Request.RequestedSeconds);
+            Row->SetNumberField(TEXT("scheduled_seconds"),Request.Due);
+            Row->SetNumberField(TEXT("enumeration_start_seconds"),Begin);
+            Row->SetNumberField(TEXT("enumeration_end_seconds"),End);
+            Row->SetNumberField(TEXT("enumeration_ms"),(End-Begin)*1000.);
+            Row->SetNumberField(TEXT("worker_aggregation_ms"),(FPlatformTime::Seconds()-AggregateBegin)*1000.);
+            AsyncTask(ENamedThreads::GameThread,[WeakThis,Generation,Row=MoveTemp(Row)]() mutable
+            {
+                auto* Self=WeakThis.Get();
+                if(!Self || Self->CaptureGeneration!=Generation)return;
+                Self->bGpuInventoryPending=false;
+                if(!Self->bRecording)return;
+                Row->SetNumberField(TEXT("published_seconds"),FPlatformTime::Seconds());
+                if(Self->GpuResourceInventories.Num()>=MaxGpuInventories)
+                {Self->GpuResourceInventories.RemoveAt(0);++Self->GpuInventoriesOverwritten;}
+                Self->GpuResourceInventories.Add(MakeShareable(Row.Release()));
+            });
+        });
+    });
+}
