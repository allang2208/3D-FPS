+bool AFacilityHallEncounter::PrepareNextSlot()
+{
+    // Only the known staff lifecycle, and standalone. Other species and
+    // network worlds keep the normal spawn path; their assets are still prepared.
+    if (bStopping || bCleared || PreparedMonster.IsValid() || GetNetMode()!=NM_Standalone
+        || !Run.IsValid() || !Run->IsRunActive() || !Generator.IsValid()) return false;
+    for (int32 Offset=0; Offset<Slots.Num(); ++Offset)
+    {
+        const int32 Index=(NextSlot+Offset)%Slots.Num();
+        const auto& Slot=Slots[Index];
+        if (Slot.bDefeated || Slot.Monster.IsValid() || Slot.Member>=StaffClassCount || Slot.bObjectiveElite) continue;
+        TRACE_CPUPROFILER_EVENT_SCOPE(FacilityHallSpawn_PrepareNative);
+        FFPSPerformanceScope PrepareScope(this,TEXT("Hall.PrepareNative"),FString::Printf(TEXT("room=%d slot=%d"),Room.Id,Index),true);
+        FActorSpawnParameters Params;
+        Params.Owner=this; Params.bDeferConstruction=true;
+        Params.SpawnCollisionHandlingOverride=ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+        Params.CustomPreSpawnInitialization=[this](AActor* Actor)
+        {
+            bPreparedHidden=Actor->IsHidden(); bPreparedCollision=Actor->GetActorEnableCollision();
+            bPreparedDamage=Actor->CanBeDamaged(); PreparedTags=Actor->Tags;
+            Actor->Tags.Reset(); Actor->Tags.Add(TEXT("Dungeon.PreparedInstance"));
+            Actor->SetActorHiddenInGame(true); Actor->SetActorEnableCollision(false); Actor->SetCanBeDamaged(false);
+            CastChecked<ANurseZombie>(Actor)->PrepareDeferredAllocation();
+        };
+        // Allocate without construction/BeginPlay. Optional GPU warmup registers
+        // only the visual body; gameplay components stay deferred until activation.
+        const FTransform DeferredTransform(FRotator::ZeroRotator,Room.Origin);
+        PreparedMonster=GetWorld()->SpawnActor<ACharacter>(Members[Slot.Member],DeferredTransform,Params);
+        if (!PreparedMonster.IsValid()) { PreparedTags.Reset(); return false; }
+        PreparedSlot=Index;
+        PreparedGpuWarmup=MakeUnique<FFacilityMonsterGpuWarmup>(CastChecked<ANurseZombie>(PreparedMonster.Get()));
+        return true;
+    }
+    return false;
+}
+
+void AFacilityHallEncounter::DiscardPreparedMonster()
+{
+    PreparedGpuWarmup.Reset();
+    if (PreparedMonster.IsValid()) PreparedMonster->Destroy();
+    PreparedMonster.Reset(); PreparedSlot=INDEX_NONE; PreparedTags.Reset();
+}
