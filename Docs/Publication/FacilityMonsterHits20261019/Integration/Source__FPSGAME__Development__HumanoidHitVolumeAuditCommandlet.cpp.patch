+                auto* Feedback=Cast<UMonsterIdleBreathingMeshComponent>(Mesh);
+                if(!Feedback){P->SetStringField(TEXT("skipped"),TEXT("This character does not use shared gun-hit pose feedback"));continue;}
+                FHitResult Hit(Monster,Mesh,Mesh->GetBoneLocation(Ref.GetBoneName(PrimaryHead)),FVector::ForwardVector);Hit.BoneName=Ref.GetBoneName(PrimaryHead);
