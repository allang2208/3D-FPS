+            }
+            double MaxPositionError=0.,MaxRotationError=0.;
+            if(Physics)for(const USkeletalBodySetup* Setup:Physics->SkeletalBodySetups)
+            {
+                const int32 Bone=Setup?Ref.FindBoneIndex(Setup->BoneName):INDEX_NONE;if(Bone==INDEX_NONE||!Head[Bone])continue;
+                if(auto* Body=Mesh->GetBodyInstance(Setup->BoneName))
+                {
+                    const FTransform Physical=Body->GetUnrealWorldTransform(),Visual=Mesh->GetSocketTransform(Setup->BoneName);
+                    MaxPositionError=FMath::Max(MaxPositionError,FVector::Distance(Physical.GetLocation(),Visual.GetLocation()));
+                    MaxRotationError=FMath::Max(MaxRotationError,FMath::RadiansToDegrees(Physical.GetRotation().AngularDistance(Visual.GetRotation())));
+                }
+            }
+            P->SetNumberField(TEXT("head_body_position_error_before_forced_sync_cm"),MaxPositionError);
+            P->SetNumberField(TEXT("head_body_rotation_error_before_forced_sync_deg"),MaxRotationError);
+            // Isolate fitted hit-volume geometry from the physics scene's deferred update timing.
+            Mesh->UpdateKinematicBonesToAnim(Mesh->GetComponentSpaceTransforms(),ETeleportType::TeleportPhysics,false,EAllowKinematicDeferral::DisallowDeferral);
+            const auto& Current=Mesh->GetComponentSpaceTransforms();
+            FDynamicMesh3 Surface;TArray<int32> VertexIds;VertexIds.Init(INDEX_NONE,LOD.NumVertices);
+            TArray<float> HeadWeight;HeadWeight.Init(0,LOD.NumVertices);FBox HeadBox(ForceInit);int32 HeadVertices=0;
+            for(const auto& Section:LOD.Sections)for(int32 V=0;V<Section.SoftVertices.Num();++V)
+            {
+                const auto& Input=Section.SoftVertices[V];FVector Point=FVector::ZeroVector;double Total=0,HeadTotal=0;
+                for(int32 W=0;W<MAX_TOTAL_INFLUENCES;++W)
+                {
+                    const double Weight=Input.InfluenceWeights[W];if(Weight==0)continue;
+                    const int32 Bone=Section.BoneMap[Input.InfluenceBones[W]];
+                    Point+=Current[Bone].TransformPosition(Reference[Bone].InverseTransformPosition(FVector(Input.Position)))*Weight;
+                    Total+=Weight;if(Head[Bone])HeadTotal+=Weight;
