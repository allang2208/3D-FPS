+bool IsHead(FName Name)
+{const auto S=Name.ToString();return S.Contains(TEXT("head"),ESearchCase::IgnoreCase)||S.Equals(TEXT("cranium"),ESearchCase::IgnoreCase);}
+TSharedRef<FJsonObject> Bounds(const FBox& Box)
+{
+    auto R=MakeShared<FJsonObject>();R->SetStringField(TEXT("min"),Box.Min.ToString());R->SetStringField(TEXT("max"),Box.Max.ToString());
+    R->SetStringField(TEXT("size"),Box.GetSize().ToString());return R;
+}
