+        const FPose Poses[]={{TEXT("spawn_idle"),Clip(TEXT("IdleClip")),0.f,false},{TEXT("idle"),Clip(TEXT("IdleClip")),.25f,false},{TEXT("walk"),Clip(TEXT("WalkClip")),.5f,false},
