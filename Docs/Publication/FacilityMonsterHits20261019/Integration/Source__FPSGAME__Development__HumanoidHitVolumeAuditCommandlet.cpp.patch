+            FDynamicMeshAABBTree3 Tree(&Surface,true);
+            TArray<TSharedPtr<FJsonValue>> Views;
+            for(const FVector Direction:{FVector(1,0,0),FVector(-1,0,0),FVector(0,1,0),FVector(0,-1,0)})
