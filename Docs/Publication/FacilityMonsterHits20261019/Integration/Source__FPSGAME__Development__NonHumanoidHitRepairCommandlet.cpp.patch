+using FPolygon=TArray<FVector,TInlineAllocator<12>>;
+
+void Clip(FPolygon& P, int32 Axis, double Limit, bool KeepLess)
+{
+    if(P.IsEmpty()) return;
+    FPolygon Result;
+    FVector A=P.Last();double DA=(A[Axis]-Limit)*(KeepLess?1.:-1.);
+    for(const FVector B:P)
+    {
+        const double DB=(B[Axis]-Limit)*(KeepLess?1.:-1.);
+        if((DA<=0)!=(DB<=0)) Result.Add(FMath::Lerp(A,B,DA/(DA-DB)));
+        if(DB<=0) Result.Add(B);
+        A=B;DA=DB;
+    }
+    P=MoveTemp(Result);
+}
+void ClipBox(FPolygon& P,const FBox& Box)
+{for(int32 Axis=0;Axis<3;++Axis){Clip(P,Axis,Box.Min[Axis],false);Clip(P,Axis,Box.Max[Axis],true);}}
+
+struct FPatch
+{
+    TSet<FIntVector> Points;
+    // Quantization only reduces coincident vertices; the hull is padded beyond
+    // its 0.05 cm rounding error, so a mesh triangle cannot disappear at a seam.
+    void Add(const FVector& P){Points.Add(FIntVector(FMath::RoundToInt(P.X*10),FMath::RoundToInt(P.Y*10),FMath::RoundToInt(P.Z*10)));}
+};
+using FPatches=TMap<FIntVector,FPatch>;
+void AddPolygon(FPatches& Patches,const FPolygon& Polygon,double Cell)
+{
+    if(Polygon.Num()<3)return;
+    FBox Bounds(ForceInit);for(const FVector P:Polygon)Bounds+=P;
+    const auto Key=[Cell](const FVector& P){return FIntVector(FMath::FloorToInt(P.X/Cell),FMath::FloorToInt(P.Y/Cell),FMath::FloorToInt(P.Z/Cell));};
+    const FIntVector Low=Key(Bounds.Min),High=Key(Bounds.Max);
+    for(int32 Z=Low.Z;Z<=High.Z;++Z)for(int32 Y=Low.Y;Y<=High.Y;++Y)for(int32 X=Low.X;X<=High.X;++X)
+    {
+        const FIntVector K(X,Y,Z);const FVector Min=FVector(K)*Cell;
+        FPolygon Piece=Polygon;ClipBox(Piece,FBox(Min,Min+FVector(Cell)));
+        if(Piece.Num()<3)continue;
+        auto& Patch=Patches.FindOrAdd(K);for(const FVector P:Piece)Patch.Add(P);
+    }
+}
+
+bool MakeHull(const FPatch& Patch,const FTransform& BoneFrame,FKConvexElem& Shape,double Padding)
+{
+    TArray<FVector> Points;Points.Reserve(Patch.Points.Num()*2);
+    for(const FIntVector P:Patch.Points)Points.Add(FVector(P)*.1);
+    if(Points.Num()<3)return false;
+    // A thin, outward 0.2 cm shell also makes planar cloth/skin patches valid
+    // Chaos convexes. Spatial cells retain concave gaps between model parts.
+    const int32 Count=Points.Num();
+    TArray<FVector> Expanded;Expanded.Reserve(Count*8);
+    for(const FVector P:Points)for(int32 Z:{-1,1})for(int32 Y:{-1,1})for(int32 X:{-1,1})Expanded.Add(P+FVector(X,Y,Z)*Padding);
+    FConvexHull3d Hull;
+    if(!Hull.Solve(Expanded.Num(),[&](int32 I){return Expanded[I];}))return false;
+    TMap<int32,int32> VertexMap;
+    for(const auto& Tri:Hull.GetTriangles())for(int32 I=0;I<3;++I)
+        if(!VertexMap.Contains(Tri[I]))
+        {VertexMap.Add(Tri[I],Shape.VertexData.Num());Shape.VertexData.Add(BoneFrame.InverseTransformPosition(Expanded[Tri[I]]));}
+    FVector Center=FVector::ZeroVector;for(const FVector P:Shape.VertexData)Center+=P;Center/=Shape.VertexData.Num();
+    for(const auto& Tri:Hull.GetTriangles())
+    {
+        const FVector A=Shape.VertexData[VertexMap[Tri.A]],B=Shape.VertexData[VertexMap[Tri.B]],C=Shape.VertexData[VertexMap[Tri.C]];
+        FVector Normal=FVector::CrossProduct(B-A,C-A).GetSafeNormal();
+        if(FVector::DotProduct(Normal,Center-A)>0)Normal=-Normal;
+    }
+    Shape.UpdateElemBox();Shape.SetName(TEXT("NonHumanoidRepairQuery20261018"));
+    Shape.SetCollisionEnabled(ECollisionEnabled::QueryOnly);Shape.SetContributeToMass(false);
+    return true;
+}
