+FVector WirePoint(const FVector& Point)
+{
+    FVector_NetQuantize Sent(Point);FBitWriter Writer(1024,true);bool OK=false;
+    Sent.NetSerialize(Writer,nullptr,OK);FBitReader Reader(Writer.GetData(),Writer.GetNumBits());
+    FVector_NetQuantize Received;Received.NetSerialize(Reader,nullptr,OK);return Received;
+}
+void Pose(USkeletalMeshComponent* Mesh)
+{
+    Mesh->TickAnimation(0.f,false);Mesh->RefreshBoneTransforms();
+    Mesh->UpdateKinematicBonesToAnim(Mesh->GetComponentSpaceTransforms(),ETeleportType::TeleportPhysics,false,EAllowKinematicDeferral::DisallowDeferral);
+}
+FHitResult Remote(FHitResult Hit)
+{
+    Hit.BoneName=UHumanoidHitVolumeData::NetworkBoneName(Hit);
+    if(Cast<ABoundCongregate>(Hit.GetActor()))Hit.BoneName=ABoundCongregate::NetworkHitBone(Hit);
+    Hit.ImpactPoint=WirePoint(Hit.ImpactPoint);Hit.TraceStart=WirePoint(Hit.TraceStart);Hit.TraceEnd=Hit.ImpactPoint;
+    Hit.Component=nullptr;return Hit;
+}
