+bool CopyThunderCustomization(FColdSteelItem& TargetItem,const FColdSteelItem& SourceItem)
+{
+    if(TargetItem.InstanceId!=SourceItem.InstanceId||TargetItem.Definition!=TEXT("ue_thunder_god_hammer")||TargetItem.Definition!=SourceItem.Definition)return false;
+    TSharedPtr<FJsonObject> Target,Source;
+    if(!FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(TargetItem.Data),Target)||!Target||
+        !FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(SourceItem.Data),Source)||!Source)return false;
+    bool Changed=false;
+    for(const TCHAR* Key:{TEXT("gunsmith_parts"),TEXT("gunsmith_version"),TEXT("tool_enhance_level")})
+    {
+        const auto Before=Target->TryGetField(Key),Value=Source->TryGetField(Key);
+        if((!Before&&!Value)||(Before&&Value&&FJsonValue::CompareEqual(*Before,*Value)))continue;
+        Changed=true;if(Value)Target->SetField(Key,Value);else Target->RemoveField(Key);
+    }
+    if(Changed){TargetItem.Data.Reset();FJsonSerializer::Serialize(Target.ToSharedRef(),TJsonWriterFactory<TCHAR,TCondensedJsonPrintPolicy<TCHAR>>::Create(&TargetItem.Data));}
+    return Changed;
+}
