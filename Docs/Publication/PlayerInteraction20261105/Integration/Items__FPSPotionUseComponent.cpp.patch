+bool UFPSPotionUseComponent::BlocksWeaponAttack(const AActor* Pawn)
+{
+    const auto* Use = Pawn ? Pawn->FindComponentByClass<UFPSPotionUseComponent>() : nullptr;
+    return Use && (Use->IsActive() || Use->IsReturningBow());
+}
+
+bool UFPSPotionUseComponent::HandlePrimaryPress()
+{
+    bOwnsPrimaryRelease = bActive || IsReturningBow();
+    if (!bOwnsPrimaryRelease) return false;
+    if (!bActive || bReturningFromMeal || !(bFood || bWater || bSoda)) return true;
+
+    if (!bStowOffhand || bWaitingForBow)
+    {
+        Cancel();
+        return true;
+    }
+
+    // Mirror a partially lowered weapon onto its raise curve so a click during
+    // entry or recovery preserves its current height.
+    const float T = Age();
+    const float RaiseAge = T < 0.f
+        ? FMath::Clamp(-T / OffhandLowerSeconds, 0.f, 1.f) * OffhandRaiseSeconds
+        : FMath::Max(0.f, T - Motion.Duration);
+    CancelUnsubmittedContact();
+    bReturningFromMeal = true;
+    StartTime = GetWorld()->GetTimeSeconds() - (Motion.Duration + RaiseAge) / UseRate;
+    StopSwallowAudio();
+    Bottle->SetVisibility(false);
+    Liquid->SetVisibility(false);
+    Stopper->SetVisibility(false);
+    if (ActiveHands == FallbackHands && FallbackHands) FallbackHands->SetVisibility(false);
+    return true;
+}
+
+bool UFPSPotionUseComponent::HandlePrimaryRelease()
+{
+    const bool WasConsumed = bOwnsPrimaryRelease;
+    bOwnsPrimaryRelease = false;
+    return WasConsumed;
+}
+
+bool UFPSPotionUseComponent::EquippedHandsChanged(const UColdSteelStatusModel& Model,int32 ActiveSlot) const
+{
+    if(!bActive || UseWeaponSlot==INDEX_NONE)return false;
+    const auto* Main=Model.Equipped(ActiveSlot);
+    const auto* Off=Model.Equipped(ActiveSlot==6?8:11);
+    return ActiveSlot!=UseWeaponSlot ||
+        (Main ? UseMainItem!=Main->InstanceId : !UseMainItem.IsEmpty()) ||
+        (Off ? UseOffhandItem!=Off->InstanceId : !UseOffhandItem.IsEmpty());
+}
+
+const FPotionUseMotion& UFPSPotionUseComponent::MotionFor(const FString& Definition) const
+{
+    if(const auto* Cooked=CookedFoodMotions.Find(Definition))return *Cooked;
+    if(Definition==TEXT("bread"))return BreadMotion;
+    if(IsFood(Definition))return FoodMotion;
+    if(Definition==TEXT("soda_can"))return SodaMotion;
+    if(Definition==TEXT("mineral_water"))return WaterMotion;
+    return HealthMotion;
+}
+
+float UFPSPotionUseComponent::MinimumContactDelay(const FString& Definition) const
+{
+    const auto& Use=MotionFor(Definition);
+    return (Use.Contact+(Use.bTwoHanded?OffhandLowerSeconds:0.f))/LightningHaste::ActionSpeed(GetOwner());
+}
+
+void UFPSPotionUseComponent::CancelUnsubmittedContact()
+{
+    if(!NetworkUseId.IsValid() || bContactSubmitted || bCommitted)return;
+    if(const auto* Pawn=Cast<APawn>(GetOwner()))
+        if(auto* PS=Pawn->GetPlayerState<AColdSteelPlayerState>())PS->ServerCancelConsumableUse(NetworkUseId);
+    NetworkUseId.Invalidate();
+}
+
+void UFPSPotionUseComponent::ReceiveContactResult(FGuid UseId,bool Accepted)
+{
+    if(!UseId.IsValid() || UseId!=NetworkUseId || !bActive || !bContactSubmitted)return;
+    bCommitted=Accepted;
+    if(!Accepted)Cancel();
+}
