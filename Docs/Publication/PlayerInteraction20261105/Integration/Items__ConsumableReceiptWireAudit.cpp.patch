+enum ECase { NoStart,CancelBefore,RefusedContact,CancelAfter,FirstSip,Replay,SecondSip,ManaPotion,Count };
+bool Enabled(){return FParse::Param(FCommandLine::Get(),TEXT("MealReceiptWire"));}
+void Pin(AFPSGAMECharacter* Pawn)
+{
+    Pawn->GetCharacterMovement()->DisableMovement();
+    Pawn->GetCharacterMovement()->StopMovementImmediately();
+    Pawn->GetCapsuleComponent()->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+}
+void Lag(UWorld* World)
+{
+#if DO_ENABLE_NET_TEST
+    if(auto* Driver=World->GetNetDriver())
+    {
+        FPacketSimulationSettings Settings;Settings.PktLag=65;Settings.PktLoss=5;
+        Driver->SetPacketSimulationSettings(Settings);
+    }
+#endif
+}
+FColdSteelProfile Seed(UColdSteelStatusModel* Model,const FString& Session)
+{
+    auto P=Model->Snapshot();P.Items.Reset();P.ActiveProductionTool.Reset();P.ActiveWeaponSlot=6;
+    P.CampfireInventoryRevision=0;P.CampfireWorldReceipts.Reset();
+    P.Survival={};P.Survival.Hunger=15;P.Survival.Hydration=10;P.Mana=0;
+    for(const TCHAR* Def:{TEXT("mineral_water"),TEXT("roasted_large_lamb"),TEXT("mp_potion")})
+    {
+        auto Item=Model->CreateItem(Def);Item.InstanceId=Session+Def;
+        ColdSteelInventory::Insert(P.Items,Item);
+    }
+    return P;
+}
+int32 Water(const FColdSteelItem* Item)
+{return Item?int32(ColdSteelInventory::Number(*Item,TEXT("remainingUses"),2)):0;}
+}
