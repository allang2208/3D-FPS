+bool AShotgunWireAuditGameMode::TickMealReceipt(float Delta)
+{
+    if(!MealWire::Enabled())return false;
+    Super::Tick(Delta);const double Now=GetWorld()->GetRealTimeSeconds();
+    if(ExitAt>=0){if(Now>=ExitAt)FPlatformMisc::RequestExit(false);return true;}
+    if(!Guest)return true;
+    auto* Pawn=Cast<AFPSGAMECharacter>(Guest->GetPawn());auto* PS=Guest->GetPlayerState<AColdSteelPlayerState>();
+    auto* HostModel=GetGameInstance()->GetSubsystem<UColdSteelStatusModel>();
+    if(!Pawn||!PS||!HostModel||!HostModel->IsAudit())return true;
+    if(Guest->Finished>=MealWire::Count||Now-Joined>230.)
+    {
+        const bool OK=Guest->Finished==MealWire::Count&&Guest->bAllPassed;
+        ShotgunWire::Save(Guest->Results,OK,TEXT("listen-host"));Guest->ClientFinish(OK);ExitAt=Now+3.;return true;
+    }
+    if(Prepared!=Guest->Finished)
+    {
+        Prepared=Guest->Finished;Guest->Expected=Prepared;Guest->bObservedMeal=false;
+        if(Prepared==0)
+        {
+            Weapon=FGuid::NewGuid().ToString(EGuidFormats::Digits);Guest->Weapon=Weapon;
+            HostModel->Current=MealWire::Seed(HostModel,TEXT("host-")+Weapon);
+            MealWire::Pin(Pawn);MealWire::Lag(GetWorld());
+            PS->SlotName=TEXT("MealWireGuest_")+Weapon;
+            PS->ShadowModel=HostModel->CreateShadowModel(MealWire::Seed(HostModel,Weapon));
+            if(!PS->ShadowModel){Guest->bAllPassed=false;Guest->Finished=MealWire::Count;return true;}
+            PS->ShadowModel->CurrentPawn=Pawn;Pawn->NetShadowProfile=PS->ShadowModel;Pawn->ApplyColdSteelProfile(PS->ShadowModel);
+        }
+        LastSetup=-10.;Guest->SentAt=-1.;
+    }
+    if(auto* Body=Pawn->FindComponentByClass<UFPSPlayerBodyComponent>())
+        Guest->bObservedMeal|=Body->GetBodyState().Action==EFPSBodyAction::Consume;
+    // Explicitly hold this receipt until the owner has had time to cancel the
+    // remaining animation, as on a bandwidth-limited connection.
+    if(!PS->InventoryReplyOutgoing.IsEmpty())
+    {
+        if(Guest->SentAt<0.)Guest->SentAt=Now;
+        if(Prepared!=MealWire::CancelAfter||Now-Guest->SentAt>1.2)PS->TickInventoryReply();
+    }
+    if(Now-LastSetup>2.){LastSetup=Now;Guest->ClientSetup(Prepared,Weapon,Pawn);}return true;
+}
