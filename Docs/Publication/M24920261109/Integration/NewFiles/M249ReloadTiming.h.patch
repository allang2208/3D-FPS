+inline float Sample(const FKey* Keys,int32 Count,float Phase)
+{
+    const float Time=FMath::Clamp(Phase,0.f,1.f)*Keys[Count-1].Runtime;
+    const auto Slope=[&](int32 I){return (Keys[I+1].Source-Keys[I].Source)/(Keys[I+1].Runtime-Keys[I].Runtime);};
+    const auto Tangent=[&](int32 I)
+    {
+        if(I==0)return Slope(0);
+        if(I==Count-1)return Slope(Count-2);
+        const float A=Slope(I-1),B=Slope(I);
+        return 2.f*A*B/(A+B);
+    };
+    for(int32 I=0;I<Count-1;++I)if(Time<=Keys[I+1].Runtime)
+    {
+        const float Span=Keys[I+1].Runtime-Keys[I].Runtime;
+        return FMath::CubicInterp(Keys[I].Source,Tangent(I)*Span,Keys[I+1].Source,Tangent(I+1)*Span,
+            FMath::Clamp((Time-Keys[I].Runtime)/Span,0.f,1.f));
+    }
+    return Keys[Count-1].Source;
+}
+inline float SourceSeconds(float Phase,bool bEmpty)
+{
+    return bEmpty?Sample(Empty,UE_ARRAY_COUNT(Empty),Phase):Sample(Normal,UE_ARRAY_COUNT(Normal),Phase);
+}
+inline float SideDuration(bool bEmpty,bool bExtended)
+{
+    return bExtended
+        ?(bEmpty?Side45Empty[UE_ARRAY_COUNT(Side45Empty)-1].Runtime:Side45Normal[UE_ARRAY_COUNT(Side45Normal)-1].Runtime)
+        :(bEmpty?Side30Empty[UE_ARRAY_COUNT(Side30Empty)-1].Runtime:Side30Normal[UE_ARRAY_COUNT(Side30Normal)-1].Runtime);
+}
+inline float SideSourceSeconds(float Phase,bool bEmpty,bool bExtended)
+{
+    if(bExtended)return bEmpty?Sample(Side45Empty,UE_ARRAY_COUNT(Side45Empty),Phase)
+        :Sample(Side45Normal,UE_ARRAY_COUNT(Side45Normal),Phase);
+    return bEmpty?Sample(Side30Empty,UE_ARRAY_COUNT(Side30Empty),Phase)
+        :Sample(Side30Normal,UE_ARRAY_COUNT(Side30Normal),Phase);
+}
