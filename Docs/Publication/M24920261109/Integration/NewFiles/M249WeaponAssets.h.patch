+inline FString AnimationPath(FString Role)
+{
+    Role.RemoveFromStart(TEXT("A_AKM_"));
+    if(Role.StartsWith(TEXT("equip"))) Role=TEXT("equip");
+    else if(Role==TEXT("aim")) Role=TEXT("idle");
+    else if(Role==TEXT("aim_fire")) Role=TEXT("fire");
+    return FString::Printf(TEXT("/Game/Weapons/M249/Animations/A_M249_%s.A_M249_%s"),*Role,*Role);
+}
