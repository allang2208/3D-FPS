+// Native M249 receiver framing; move the full rig once, independently of ADS.
+// Repair20 compares the saved idle at the existing LMG anchor and +6/+9.5 cm.
+inline const FVector HipPresentationOffset(6.f,0.f,0.f);
+// Hip28: compressed A_M249_idle, component-space sight axis and rear sight (cm).
+// Undo only the rail's roll, about the existing sight line. The compensating
+// translation holds both sight points in place while the gun and arms turn together.
+inline void LevelHipPose(FVector& Location,FQuat& Rotation,const FVector& Scale,float Weight)
+{
+    if(Weight<=0.f)return;
+    const FVector Axis=FVector(.000450045f,-.999899724f,.014154136f).GetSafeNormal();
+    const FVector Pivot=FVector(7.146587f,-6.894206f,5.675161f)*Scale;
+    const FQuat Leveled=(Rotation*FQuat(Axis,FMath::DegreesToRadians(5.000496f)*Weight)).GetNormalized();
+    Location+=Rotation.RotateVector(Pivot)-Leveled.RotateVector(Pivot);
+    Rotation=Leveled;
+}
