+inline bool Matches(const USkeletalMeshComponent* Mesh)
+{
+    static const FName AssetName(TEXT("SK_M249_V7"));
+    return Mesh && Mesh->GetSkeletalMeshAsset() && Mesh->GetSkeletalMeshAsset()->GetFName()==AssetName;
