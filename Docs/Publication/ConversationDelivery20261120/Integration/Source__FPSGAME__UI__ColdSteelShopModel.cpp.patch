+
+bool UColdSteelShopModel::BeginMenuSession(AActor* Seller)
+{
+    const auto* NewMenu = MenuForSeller(Seller);
+    const auto* PC = GetGameInstance()->GetFirstLocalPlayerController();
+    if (!NewMenu || !PC || !ResidentConversation::CanReach(PC->GetPawn(), Seller) || !OpenProfile()) return false;
+    Menu = NewMenu;
+    MenuSeller = Seller;
+    BuyerPawn = PC->GetPawn();
+    for (const auto& Offer : Menu->Offers)
+    {
+        auto Item = Model->CreateItem(Offer.Definition);
+        if (Offer.Price(Item) > 0) Shelf.Add(MoveTemp(Item));
+    }
+    Message = Menu->BuyPrompt;
+    OnChanged.Broadcast();
+    return true;
+}
+
+void UColdSteelShopModel::WatchSeller(FSimpleDelegate OnLeft)
+{
+    if (!IsPurchaseOnly() && !IsArtisanShop()) return;
+    GetWorld()->GetTimerManager().SetTimer(ReachTimer, FTimerDelegate::CreateWeakLambda(this, [this, OnLeft]()
+    {
+        if (!OnLeft.IsBound()) EndSession();
+        else if (SellerHasLeft()) OnLeft.Execute();
+    }), .25f, true);
+}
+
+bool UColdSteelShopModel::SellerHasLeft() const
+{
+    const AActor* Seller = IsPurchaseOnly() ? MenuSeller.Get() : Merchant.Get();
+    const auto* PC = GetGameInstance()->GetFirstLocalPlayerController();
+    if (!Seller || !PC || !BuyerPawn.IsValid() || PC->GetPawn() != BuyerPawn.Get()) return true;
+    return !ResidentConversation::CanReach(PC->GetPawn(), Seller);
 }
 
