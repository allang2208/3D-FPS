+struct FColdSteelMenuOffer
+{
+    const TCHAR* Definition;
+    int64 PriceIfUnlisted = 0;
+
+    int64 Price(const FColdSteelItem& Item) const
+    {
+        if (Item.Data.IsEmpty()) return 0;
+        const int64 CatalogPrice = ShopUnitPrice(Item);
+        return CatalogPrice > 0 ? CatalogPrice : PriceIfUnlisted;
+    }
+};
+
+struct FColdSteelResidentMenu
+{
+    TConstArrayView<FColdSteelMenuOffer> Offers;
+    const TCHAR* BuyMode;
+    const TCHAR* Title;
+    const TCHAR* BuyPrompt;
+    const TCHAR* ReachPrompt;
+    const TCHAR* InvalidOffer;
+
+    const FColdSteelMenuOffer* FindOffer(const FString& Definition) const
+    {
+        return Offers.FindByPredicate([&Definition](const auto& Offer) { return Definition == Offer.Definition; });
+    }
+};
