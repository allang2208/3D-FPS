+}
+void AGunAssemblyInteraction::Stop(bool bReturnPanel)
+{
+    if(!bRunning)return;bRunning=false;bHeld=false;Dragged=INDEX_NONE;
+    FString Why;if(System&&!System->Pause(Why))Feedback=Why;
