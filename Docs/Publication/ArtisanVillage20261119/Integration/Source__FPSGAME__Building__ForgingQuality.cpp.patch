+    Q->SetNumberField(TEXT("blacksmithPercent"),QualityPercent);
+    Q->SetStringField(TEXT("label"),TEXT("铁匠成品"));
+    Data->SetObjectField(Field,Q);Write(Item,Data);
+    return true;
+}
