+FString UColdSteelShopModel::MerchantName() const
+{
+    const auto* Seller = Merchant.Get();
+    return Seller ? Seller->MerchantName() : TEXT("商店");
+}
+
+bool UColdSteelShopModel::BeginArtisanSession(AVillageArtisanMerchant* Seller)
+{
+    const auto* PC = GetGameInstance()->GetFirstLocalPlayerController();
+    if (!IsValid(Seller) || !Seller->CanTradeWith(PC ? PC->GetPawn() : nullptr) || !OpenProfile()) return false;
+    Merchant = Seller;
+    StockHandle = Seller->OnStockChanged.AddUObject(this, &ThisClass::RefreshArtisanStock);
+    Message = Seller->IsCarpenterMerchant()
+        ? TEXT("弓和法杖按基础品质出售，伐木斧可直接装备。买下一件后会补货。")
+        : TEXT("武器逐件定质，十字镐按工具出售。买下一件后会补货。");
+    RefreshArtisanStock();
+    return true;
+}
+
+
+bool UColdSteelShopModel::SellerHasLeft()
+{
+    return IsArtisanShop() && !Merchant.IsValid();
+}
+
+void UColdSteelShopModel::RefreshArtisanStock()
+{
+    Shelf.Reset();
+    if (const auto* Seller = Merchant.Get())
+        for (const auto& Offer : Seller->Stock())
+        {
+            FColdSteelItem Item;
+            if (Seller->MakeStockItem(*Model, Offer, Item)) Shelf.Add(MoveTemp(Item));
+        }
+    OnChanged.Broadcast();
+}
+
