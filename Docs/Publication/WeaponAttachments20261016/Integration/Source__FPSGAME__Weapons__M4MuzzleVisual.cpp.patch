+            MuzzleAttachment->SetCastShadow(false);
+            MuzzleAttachment->bReceivesDecals=false;
+            MuzzleAttachment->RegisterComponent();
+        }
+        MuzzleAttachment->EmptyOverrideMaterials();
+        MuzzleAttachment->SetStaticMesh(Part);
