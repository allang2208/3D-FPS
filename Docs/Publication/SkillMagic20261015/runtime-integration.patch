+
+    for(const bool Hammer:{false,true})
+    {
+        Reset();
+        if(Hammer){auto Item=Host->CreateItem(TEXT("ue_steel_warhammer"));Item.Place=1;Item.Cell=6;Shadow->Current.Items={Item};Tool->ServerBeginBluntCharge_Implementation(10);}
