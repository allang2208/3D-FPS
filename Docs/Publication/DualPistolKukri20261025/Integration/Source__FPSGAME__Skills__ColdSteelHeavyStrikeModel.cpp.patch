+/** The item the uppercut bills and validates against: the melee weapon, or the off-hand kukri behind a dual pistol. */
+const FColdSteelItem* UppercutItem(const UColdSteelStatusModel* Profile)
+{
+    const auto* Item=Profile->Equipped();
+    if(!Item||ColdSteelInventory::IsTwoHandedSword(*Item)||ColdSteelInventory::IsOneHandedMelee(*Item))return Item;
+    if(!ColdSteelInventory::IsDualPistol(*Item))return Item;
+    // Pistol + offhand kukri (OffhandKukriUppercut.cpp): the cast swings the off-hand blade.
+    const auto State=Profile->Snapshot();
+    const auto* Off=Profile->Equipped(State.ActiveWeaponSlot==6?8:11);
+    return Off&&ColdSteelInventory::IsOneHandedMelee(*Off)?Off:Item;
+}
