+bool UGrassDeformSubsystem::ArePassShadersReady() const
+{
+#if WITH_EDITOR
+    const UWorld* World=GetWorld();if(!World)return false;
+    const auto Platform=GetFeatureLevelShaderPlatform_Checked(World->GetFeatureLevel());
+    for(const auto* Material:{StampMaterial.Get(),StampTimeMaterial.Get(),RecenterMaterial.Get(),RecenterTimeMaterial.Get()})
+    {
+        if(!Material)return false;
+        const auto* Resource=Material->GetMaterialResource(Platform);
+        if(Material->IsCompiling() || (Resource && !Resource->IsCompilationFinished()))return false;
+    }
+#endif
+    return true;
+}
