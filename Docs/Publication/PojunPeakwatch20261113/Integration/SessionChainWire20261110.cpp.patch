+FColdSteelItem SkillWireEquipment::MakeWeapon(UColdSteelStatusModel* Model,const TCHAR* DefaultWeapon)
+{
+    if(!FParse::Param(FCommandLine::Get(),TEXT("PojunWire")))return Model->CreateItem(DefaultWeapon);
+    auto Item=Model->CreateItem(PojunGrip::Weapon);
+    TSharedPtr<FJsonObject> Data;
+    if(!FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Item.Data),Data)||!Data)return {};
+    auto Parts=MakeShared<FJsonObject>();
+    Parts->SetStringField(TEXT("grip"),PojunGrip::Part);
+    if(!FParse::Param(FCommandLine::Get(),TEXT("ChargedSlamWire")))
+    {
+        Parts->SetStringField(TEXT("blade_1"),TEXT("tengyun_dragon"));
+        Parts->SetStringField(TEXT("blade_2"),TEXT("chixiao_rune"));
+    }
+    Data->SetObjectField(TEXT("gunsmith_parts"),Parts);
+    Item.Data.Reset();
+    FJsonSerializer::Serialize(Data.ToSharedRef(),TJsonWriterFactory<>::Create(&Item.Data));
+    return Item;
+}
 
