+#pragma once
+#include "CoreMinimal.h"
+
+struct FIlluminationArrowTuning
+{
+    float RadiusBase=1000.f,RadiusMax=3000.f;
+    float DurationBase=10.f,DurationMax=30.f;
+    float BonusBase=.15f,BonusMax=.50f;
+    float CooldownBase=30.f,CooldownMin=18.f,ManaCost=12.f;
+    int32 ThreeKillExperience=18,FiveKillExperience=30,SevenKillExperience=48;
+};
+struct FIlluminationArrowCast
+{
+    float Radius=1000.f,Duration=10.f,DamageBonus=.15f,Cooldown=30.f,ManaCost=12.f;
+    FGuid Id;
+};
+namespace IlluminationArrow
+{
+    inline float ImpactDuration(const FIlluminationArrowCast& Cast){return Cast.Duration*2.f;}
+    inline constexpr int32 Stencil=236;
+    inline constexpr const TCHAR* Glow=TEXT("/Game/Skills/IlluminationArrow20261027/M_IlluminationArrowGlow.M_IlluminationArrowGlow");
+    inline constexpr const TCHAR* Outline=TEXT("/Game/Skills/IlluminationArrow20261027/M_IlluminationMarkOutline.M_IlluminationMarkOutline");
+    inline constexpr const TCHAR* Depth=TEXT("/Game/Skills/IlluminationArrow20261027/M_IlluminationMarkDepth.M_IlluminationMarkDepth");
+    inline FIlluminationArrowCast Evaluate(const FIlluminationArrowTuning& T,int32 Level,int32 MaxLevel=20)
+    {
+        const float A=float(FMath::Clamp(Level,1,MaxLevel)-1)/FMath::Max(1,MaxLevel-1);
+        FIlluminationArrowCast C;C.Radius=FMath::Lerp(T.RadiusBase,T.RadiusMax,A);
+        C.Duration=FMath::Lerp(T.DurationBase,T.DurationMax,A);C.DamageBonus=FMath::Lerp(T.BonusBase,T.BonusMax,A);
+        C.Cooldown=FMath::Lerp(T.CooldownBase,T.CooldownMin,A);C.ManaCost=T.ManaCost;return C;
+    }
+}
