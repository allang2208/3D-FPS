+
+void ReleaseStreamingBudget()
+{
+    if(--BudgetWorldCount!=0)return;
+    for(const auto& C:BudgetOverrides)
+        if(FMath::IsNearlyEqual(C.Variable->GetFloat(),C.Applied))C.Variable->SetWithCurrentPriority(C.Previous);
+    BudgetOverrides.Reset();
+}
