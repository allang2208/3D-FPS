+
+/** Small editor-only bridge for the native material-attribute pin API. */
+UCLASS()
+class FPSGAME_API UTemperateForestAuthoringLibrary : public UBlueprintFunctionLibrary
+{
+    GENERATED_BODY()
+public:
+    UFUNCTION(BlueprintCallable, Category="Development|Temperate Forest")
+    static int32 AddWindOffsetPin(UObject* Expression);
+
+    UFUNCTION(BlueprintCallable, Category="Development|Temperate Forest")
+    static int32 AddVisibilityMaskPin(UObject* Expression);
+
+    /** X=fade start, Y=visible end, Z=runtime generation radius, all in cm. */
+    UFUNCTION(BlueprintPure, Category="Development|Temperate Forest")
+    static FVector GetVisibilityDistances(int32 Layer);
+};
diff --git a/Source/FPSGAME/WorldGeneration/TemperateForestHabitat.h b/Source/FPSGAME/WorldGeneration/TemperateForestHabitat.h
new file mode 100644
index 0000000000000000000000000000000000000000..aa187d1b9ca4dff82aee7193f66b82fd819fa407
--- /dev/null
+++ b/Source/FPSGAME/WorldGeneration/TemperateForestHabitat.h
@@ -0,0 +1,127 @@
+#pragma once
+
+#include "TemperateHillsSurface.h"
+#include "TemperateEcologyConfig.h"
+
+// Visual habitat only. HeightV1/V2, river carving and harvest candidate coordinates
+// stay frozen. Both worker-built terrain colours and PCG sample this same field.
+namespace TemperateForestHabitat
+{
+// One bounded, seed-stable habitat mask is shared by terrain and every plant
+// layer. Outside its feathered ellipse, the established hills remain unchanged.
+inline double RainforestWeight(double X,double Y,int32 Seed)
+{
+    const auto& R=TemperateEcology::Get().Rainforest;
+    if(R.Strength<=0)return 0;
+    const double NX=(X-R.CenterX)/R.RadiusXCm;
+    if(FMath::Abs(NX)>1.1)return 0;
+    const double CY=TemperateHillsSurface::ValleyY(R.CenterX,Seed)+R.NorthOfValleyCm;
+    const double NY=(Y-CY)/R.RadiusYCm;
+    const double Distance=FMath::Sqrt(NX*NX+NY*NY);
+    if(Distance>1.1)return 0;
+    const double EdgeNoise=TemperateHillsSurface::Noise5(X/3800.0,Y/3800.0,Seed,3511)*.09;
+    return R.Strength*(1.0-FMath::SmoothStep(1.0-R.EdgeBlend,1.0,Distance+EdgeNoise));
+}
+
+inline double RainforestOpening(double X,double Y,int32 Seed)
+{
+    const double Scale=TemperateEcology::Get().Rainforest.ClearingScaleCm;
+    return FMath::SmoothStep(.56,.82,
+        TemperateHillsSurface::Noise5(X/Scale,Y/Scale,Seed,3527)*.5+.5);
+}
+
+inline double LegacyCanopy(double X,double Y,int32 Seed)
+{
+    return FMath::SmoothStep(0.0,1.0,
+        (TemperateHillsSurface::Noise(X*.00014,Y*.00014,Seed,173)+.45)/1.05);
+}
+
+inline double Canopy(double X,double Y,int32 Seed,double Region,double Opening)
+{
+    const auto& E=TemperateEcology::Get();
+    const double Woodland=E.Woodland.Weight(LegacyCanopy(X,Y,Seed));
+    const double Gap=E.Gaps.Weight(
+        TemperateHillsSurface::Noise5(X/E.GapScaleCm,Y/E.GapScaleCm,Seed,3101)*.5+.5);
+    const double Base=Woodland*(1.0-E.GapStrength*Gap);
+    if(Region<=0)return Base;
+    const double Local=E.Rainforest.Canopy-.46*Opening;
+    return FMath::Lerp(Base,Local,Region);
+}
+
+inline double Canopy(double X,double Y,int32 Seed)
+{
+    const double Region=RainforestWeight(X,Y,Seed);
+    return Canopy(X,Y,Seed,Region,Region>0?RainforestOpening(X,Y,Seed):0.);
+}
+
+inline double Moisture(double X,double Y,int32 Seed,double Region)
+{
+    const double Scale=TemperateEcology::Get().MoistureScaleCm;
+    const double Base=FMath::SmoothStep(.20,.80,
+        TemperateHillsSurface::Noise5(X/Scale,Y/Scale,Seed,3109)*.5+.5);
+    return FMath::Lerp(Base,FMath::Max(Base,TemperateEcology::Get().Rainforest.Moisture),Region);
+}
+
+inline double Moisture(double X,double Y,int32 Seed)
+{
+    return Moisture(X,Y,Seed,RainforestWeight(X,Y,Seed));
+}
+
+inline double UnderstoryPatch(double X,double Y,int32 Seed)
+{
+    const double Scale=TemperateEcology::Get().UnderstoryPatchScaleCm;
+    return FMath::SmoothStep(.28,.73,
+        TemperateHillsSurface::Noise5(X/Scale,Y/Scale,Seed,3119)*.5+.5);
+}
+
+struct FUnderstory
+{
+    double Edge=0,Shade=0,Moist=0,Patch=0,Shrub=0,Fern=0,Sapling=0;
+};
+
+// One shared site description prevents every layer filling the same ground.
+// Shrubs favour brighter, drier edges; fern colonies occupy the moist pockets
+// between them. Pure seeded maths is also safe in terrain worker jobs.
+inline FUnderstory Understory(double X,double Y,int32 Seed,double Forest,double Region)
+{
+    FUnderstory S;
+    const auto& E=TemperateEcology::Get();
+    S.Edge=E.EdgeEnter.Weight(Forest)*(1.0-E.EdgeLeave.Weight(Forest));
+    S.Shade=E.Shade.Weight(Forest);
+    S.Moist=Moisture(X,Y,Seed,Region);
+    S.Patch=UnderstoryPatch(X,Y,Seed);
+    const double FernPatch=FMath::SmoothStep(.30,.78,S.Patch);
+    const double ShrubPatch=FMath::SmoothStep(.23,.65,1.0-S.Patch);
+    S.Shrub=(.85*S.Edge+.20*S.Shade)*(.15+.85*ShrubPatch)*(1.0-.30*S.Moist);
+    S.Fern=FMath::SmoothStep(.12,.68,Forest)*(.25+.75*S.Moist)*FernPatch*(1.0-.65*S.Shrub);
+    S.Sapling=(.12*S.Shade+.36*S.Edge)*(.25+.75*(1.0-FernPatch))*(1.0-.45*S.Shrub);
+    // Mid-storey saplings and shrubs occupy different patches from fern beds.
+    S.Shrub=FMath::Max(S.Shrub,Region*.25*S.Shade*(.30+.70*ShrubPatch));
+    S.Sapling=FMath::Max(S.Sapling,Region*S.Shade*(.12+.12*(1.0-FernPatch)));
+    return S;
+}
+
+// Neighbouring plants share an age/form cohort without a visible cell seam.
+inline uint32 Cohort(double X,double Y,int32 Seed,uint32 PlantKey,uint32 Salt)
+{
+    const double Scale=TemperateEcology::Get().CohortScaleCm;
+    const double PX=X/Scale,PY=Y/Scale;
+    int32 IX=FMath::FloorToInt(PX),IY=FMath::FloorToInt(PY);
+    if(TemperateHillsSurface::Unit(PlantKey+37)<FMath::SmoothStep(0.0,1.0,PX-IX))++IX;
+    if(TemperateHillsSurface::Unit(PlantKey+41)<FMath::SmoothStep(0.0,1.0,PY-IY))++IY;
+    return TemperateHillsSurface::Key(IX,IY,uint32(Seed),Salt);
+}
+
+// Alpha keeps its historical default of 1 outside woodland. RGB remain the
+// bank / wetness / pebble contract. No extra runtime texture or GPU readback.
+inline double Litter(double X,double Y,int32 Seed,double NormalZ,double Bank)
+{
+    const double Path=FMath::Abs(Y-TemperateHillsSurface::ValleyY(X,Seed));
+    // Leaves extend past the densest canopy and remain in small gaps; their
+    // thickness varies over the same patches as the understory.
+    const double Cover=.85*Canopy(X,Y,Seed)+.15*LegacyCanopy(X,Y,Seed);
+    const double Deposit=.82+.18*UnderstoryPatch(X,Y,Seed);
+    return FMath::SmoothStep(.04,.84,Cover)*Deposit*FMath::SmoothStep(.76,.95,NormalZ)
+        *FMath::SmoothStep(450.0,1700.0,Path)*(1.0-FMath::SmoothStep(.02,.45,Bank));
+}
+}
diff --git a/Source/FPSGAME/WorldGeneration/TemperateForestUnderstory.cpp b/Source/FPSGAME/WorldGeneration/TemperateForestUnderstory.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0f06c334f543a375a0002c82da5b95cb7286dba8
--- /dev/null
+++ b/Source/FPSGAME/WorldGeneration/TemperateForestUnderstory.cpp
@@ -0,0 +1,83 @@
+#include "TemperateHillsWorld.h"
+#include "TemperateForestHabitat.h"
+#include "Engine/SkeletalMesh.h"
+
+void ATemperateHillsWorld::GetForestUnderstoryPlacements(const FBox& Bounds,TArray<FTemperatePlacement>& Out) const
+{
+    if(!Assets)return;
+    const auto& Ecology=TemperateEcology::Get();
+    using namespace TemperateHillsSurface;
+    const double Half=SizeMeters*50-500;
+    const double MinX=FMath::Max(-Half,Bounds.Min.X),MinY=FMath::Max(-Half,Bounds.Min.Y);
+    const double MaxX=FMath::Min(Half,Bounds.Max.X),MaxY=FMath::Min(Half,Bounds.Max.Y);
+    if(MinX>=MaxX||MinY>=MaxY)return;
+
+    for(int32 Pass=0;Pass<3;++Pass)
+    {
+        const auto& Meshes=Pass==0?Assets->ForestSaplings:(Pass==1?Assets->ForestShrubs:Assets->ForestFerns);
+        const auto& Rule=Pass==0?Ecology.Saplings:(Pass==1?Ecology.Hazel:Ecology.Ferns);
+        if(Meshes.IsEmpty()||Rule.Density<=0)continue;
+        const double Tile=Pass==0?850:(Pass==1?550:760);
+        // Include neighbouring colony anchors: a frond may cross the anchor's
+        // cell, but the final half-open bounds own each point exactly once.
+        for(int32 GY=FMath::FloorToInt(MinY/Tile)-1;GY<=FMath::FloorToInt(MaxY/Tile)+1;++GY)
+        for(int32 GX=FMath::FloorToInt(MinX/Tile)-1;GX<=FMath::FloorToInt(MaxX/Tile)+1;++GX)
+        {
+        const uint32 Colony=Key(GX,GY,uint32(Seed),3203+Pass*17);
+        const int32 Candidates=Pass==2?6+int32(Unit(Colony+53)*4):(Pass==0?2:1);
+        const double CX=(GX+.225+Unit(Colony+29)*.55)*Tile;
+        const double CY=(GY+.225+Unit(Colony+31)*.55)*Tile;
+        for(int32 I=0;I<Candidates;++I)
+        {
+            const uint32 K=Mix(Colony^uint32(I+1)*0x9e3779b9U);
+            const double Angle=Unit(Colony+43)*2*PI+I*2.3999632297;
+            const double Radius=FMath::Sqrt((I+.35)/Candidates)*(Pass==2?230.0:260.0)*(.85+.30*Unit(K+1));
+            const double X=CX+FMath::Cos(Angle)*Radius,Y=CY+FMath::Sin(Angle)*Radius;
+            const double Path=PathDistance(X,Y);
+            if(X<MinX||X>=MaxX||Y<MinY||Y>=MaxY||Path<650)continue;
+            const double StartDistance=FVector2D::Distance(FVector2D(X,Y),FVector2D(GetStartLocation()));
+            if(StartDistance<1400)continue;
+            const auto Bank=RiverPlan?RiverPlan->Sample(X,Y):TemperateRiver::FSample();
+            if(Bank.Bank>.22||(Bank.Bank>0&&Height(X,Y)<Bank.WaterZ+35))continue;
+            const FVector N=SurfaceNormal(X,Y);
+            const double SlopeWeight=Rule.SlopeWeight(N.Z);
+            if(SlopeWeight<=0)continue;
+            const double Region=TemperateForestHabitat::RainforestWeight(X,Y,Seed);
+            const double Opening=Region>0?TemperateForestHabitat::RainforestOpening(X,Y,Seed):0.;
+            const double Forest=TemperateForestHabitat::Canopy(X,Y,Seed,Region,Opening);
+            const auto Site=TemperateForestHabitat::Understory(X,Y,Seed,Forest,Region);
+            const double Fringe=FMath::SmoothStep(650.0,1300.0,Path)*FMath::SmoothStep(1400.0,2200.0,StartDistance)
+                *(1.0-FMath::SmoothStep(.01,.22,Bank.Bank))*SlopeWeight;
+            const double Shore=Region>0&&ForestWaterPlan?Region*ForestWaterPlan->ShoreMoistureAt(X,Y):0.;
+            // Keep the immediate lip low. Fern beds sit a little further up the
+            // bank, interrupted by the existing understory patches.
+            const double FernFringe=4.*Shore*(1.-Shore);
+            const double BankDensity=Pass==2?1.+.95*FernFringe-.70*Shore*Shore:1.-.72*Shore;
+            const double LocalDensity=FMath::Lerp(1.0,Pass==0?Ecology.Rainforest.SaplingDensityMultiplier:
+                (Pass==1?Ecology.Rainforest.ShrubDensityMultiplier:Ecology.Rainforest.FernDensityMultiplier),Region);
+            const double Chance=Rule.Density*LocalDensity*BankDensity*(Pass==0?Site.Sapling:(Pass==1?Site.Shrub:Site.Fern))*Fringe;
+            if(Unit(K+3)>Chance)continue;
+            const uint32 Cohort=TemperateForestHabitat::Cohort(X,Y,Seed,K,3247+Pass*13);
+            const uint32 Form=Unit(K+19)<.72?Cohort:K;
+            const auto& Chosen=Meshes[Form%Meshes.Num()];
+            const USkeletalMesh* Mesh=Chosen.Get();
+            if(!Mesh)continue;
+            const FBox Box=Mesh->GetBounds().GetBox();
+            double Vigor=.55*Unit(Cohort+7)+.45*Unit(K+5);
+            if(Region>0&&Pass==0)
+                Vigor=FMath::Lerp(Vigor,.68*Vigor+.32*Opening,Region);
+            const double TargetHeight=Pass==0?95+Vigor*180:
+                (Pass==1?100+Vigor*135:42+(Vigor*.55+Site.Moist*.45)*63);
+            const double Scale=TargetHeight/FMath::Max(1.0,Box.GetSize().Z);
+            const FVector Up=FMath::Lerp(FVector::UpVector,N,Pass==2?.25:.12).GetSafeNormal();
+            const FQuat Rot=FQuat(Up,Unit(K+4)*2*PI)*FQuat::FindBetweenNormals(FVector::UpVector,Up);
+            const FVector Root=Rot.RotateVector(FVector(0,0,Box.Min.Z)*Scale);
+            FTemperatePlacement& P=Out.Emplace_GetRef();
+            P.Transform=FTransform(Rot,FVector(X,Y,Height(X,Y)-Root.Z-2),FVector(Scale));
+            P.Mesh=Chosen.ToSoftObjectPath();P.Key=K;
+            P.CandidateId=(uint64(uint32(GX)&0x00ffffffU)<<32)|
+                (uint64(uint32(GY)&0x00ffffffU)<<8)|uint64(0x20+Pass*16+I);
+        }
+        }
+    }
+}
diff --git a/Source/FPSGAME/WorldGeneration/TemperateForestWater.cpp b/Source/FPSGAME/WorldGeneration/TemperateForestWater.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3f10c97b8ba2811182f6cdc53e98b4472e9a495b
--- /dev/null
+++ b/Source/FPSGAME/WorldGeneration/TemperateForestWater.cpp
@@ -0,0 +1,308 @@
+#include "TemperateForestWater.h"
+#include "TemperateForestHabitat.h"
+#include "DynamicMesh/DynamicMesh3.h"
+#include "DynamicMesh/DynamicMeshAttributeSet.h"
+#include <queue>
+#include <vector>
+
+namespace TemperateForestWater
+{
+namespace
+{
+constexpr double WaterEdgeDepthCm=2.;
+constexpr double ShoreWidthCm=240.;
+// Linear interpolation lets the last wet grid vertex influence its neighbouring cell.
+constexpr double ShoreInfluenceCm=ShoreWidthCm+Step;
+constexpr int32 CellTriangles[2][3]={{0,2,1},{0,3,2}};
+
+void GetCellCorners(const FPlan& Plan,FIntPoint Cell,FVector (&V)[4])
+{
+    const FIntPoint Corners[]={Cell,Cell+FIntPoint(1,0),Cell+FIntPoint(1,1),Cell+FIntPoint(0,1)};
+    for(int32 I=0;I<4;++I)
+    {
+        const auto C=Corners[I];
+        V[I]=FVector(Plan.Origin+FVector2D(C)*Step,Plan.GroundAt(C.X,C.Y));
+    }
+}
+
+void StampBank(FPlan& Plan,const FVector2D& A,const FVector2D& B,double WaterZ)
+{
+    const FVector2D Extent(ShoreWidthCm);
+    const FVector2D Lo=(A.ComponentMin(B)-Extent-Plan.Origin)/Step;
+    const FVector2D Hi=(A.ComponentMax(B)+Extent-Plan.Origin)/Step;
+    const FVector2D Segment=B-A;
+    const double LengthSquared=FMath::Max(Segment.SizeSquared(),UE_DOUBLE_SMALL_NUMBER);
+    const int32 LastX=FMath::Min(Plan.Width-1,FMath::FloorToInt(Hi.X));
+    const int32 LastY=FMath::Min(Plan.Height-1,FMath::FloorToInt(Hi.Y));
+    for(int32 Y=FMath::Max(0,FMath::CeilToInt(Lo.Y));Y<=LastY;++Y)
+    for(int32 X=FMath::Max(0,FMath::CeilToInt(Lo.X));X<=LastX;++X)
+    {
+        const FVector2D P=Plan.Origin+FVector2D(X,Y)*Step;
+        const double T=FMath::Clamp(FVector2D::DotProduct(P-A,Segment)/LengthSquared,0.,1.);
+        const double Distance=FVector2D::Distance(P,A+T*Segment);
+        const double LowGround=1.-FMath::SmoothStep(4.,32.,Plan.GroundAt(X,Y)-WaterZ);
+        const float Weight=float(LowGround*(1.-FMath::SmoothStep(0.,ShoreWidthCm,Distance)));
+        float& Value=Plan.ShoreMoisture[Y*Plan.Width+X];
+        Value=FMath::Max(Value,Weight);
+    }
+}
+
+// Run once in the water-plan worker. Terrain and thousands of instances then
+// read the same four samples, including where the shoreline crosses a PCG tile.
+void BuildShoreMoisture(FPlan& Plan)
+{
+    if(Plan.Pools.IsEmpty())return;
+    Plan.ShoreMoisture.Init(0.f,Plan.Width*Plan.Height);
+    for(const auto& Pool:Plan.Pools)
+    {
+        const double Level=Pool.WaterZ-WaterEdgeDepthCm;
+        for(const auto Cell:Pool.Cells)
+        {
+            FVector V[4];GetCellCorners(Plan,Cell,V);
+            for(int32 I=0;I<4;++I)if(V[I].Z<Level)
+            {
+                const int32 X=Cell.X+int32(I==1||I==2),Y=Cell.Y+int32(I>=2);
+                Plan.ShoreMoisture[Y*Plan.Width+X]=1.f;
+            }
+            for(const auto& Tri:CellTriangles)
+            {
+                FVector2D Ends[2];int32 Count=0;
+                for(int32 I=0;I<3;++I)
+                {
+                    const FVector& A=V[Tri[I]];
+                    const FVector& B=V[Tri[(I+1)%3]];
+                    if((A.Z<Level)!=(B.Z<Level))
+                        Ends[Count++]=FVector2D(FMath::Lerp(A,B,(Level-A.Z)/(B.Z-A.Z)));
+                }
+                if(Count==2)StampBank(Plan,Ends[0],Ends[1],Pool.WaterZ);
+            }
+        }
+    }
+}
+}
+
+FPlanPtr Generate(int32 Seed,double Half,TemperateRiver::FPlanPtr River,
+    const TArray<TemperateHillsSurface::FTerrainEdit>& Edits,int32 Version)
+{
+    auto Plan=MakeShared<FPlan,ESPMode::ThreadSafe>();
+    const auto& Region=TemperateEcology::Get().Rainforest;
+    if(Region.Strength<=0)return Plan;
+    const double CY=TemperateHillsSurface::ValleyY(Region.CenterX,Seed)+Region.NorthOfValleyCm;
+    // Align to the same world grid as the 64 m streamed ground cells.
+    auto Snap=[&](double V){return -Half+FMath::FloorToDouble((V+Half)/Step)*Step;};
+    Plan->Origin=FVector2D(Snap(FMath::Max(-Half+Step,Region.CenterX-Region.RadiusXCm*1.1)),
+        Snap(FMath::Max(-Half+Step,CY-Region.RadiusYCm*1.1)));
+    const double EndX=FMath::Min(Half-Step,Region.CenterX+Region.RadiusXCm*1.1);
+    const double EndY=FMath::Min(Half-Step,CY+Region.RadiusYCm*1.1);
+    Plan->Width=FMath::Max(0,FMath::FloorToInt((EndX-Plan->Origin.X)/Step)+1);
+    Plan->Height=FMath::Max(0,FMath::FloorToInt((EndY-Plan->Origin.Y)/Step)+1);
+    const int32 W=Plan->Width,H=Plan->Height,Count=W*H;
+    if(W<3||H<3)return Plan;
+    auto BaseHeight=[&](double X,double Y)
+    {return River?River->Height(X,Y,Seed):TemperateHillsSurface::Height(X,Y,Seed,Version);};
+    struct FCandidate { FBasin Basin; double Score; };
+    TArray<FCandidate> Basins;
+    // Legacy V1 seeds may have no closed hollows here. Select two gentle sites
+    // from the ORIGINAL seed terrain; selection never moves when a player digs
+    // or fills. Player edits are applied after shaping, and can drain/fill pools.
+    constexpr int32 SiteStep=int32(800./Step);
+    for(int32 Y=SiteStep;Y<H-SiteStep;Y+=SiteStep)for(int32 X=SiteStep;X<W-SiteStep;X+=SiteStep)
+    {
+        const FVector2D C=Plan->Origin+FVector2D(X,Y)*Step;
+        if(TemperateForestHabitat::RainforestWeight(C.X,C.Y,Seed)<.75)continue;
+        const uint32 Key=TemperateHillsSurface::Key(X,Y,uint32(Seed),3613);
+        FBasin B{C,480.+TemperateHillsSurface::Unit(Key)*100.,0,20.+TemperateHillsSurface::Unit(Key+7)*10.};
+        double Low=DBL_MAX,High=-DBL_MAX;bool Valid=true;
+        for(int32 I=0;I<16;++I)
+        {
+            const double Angle=I*2*PI/16;const FVector2D P=C+FVector2D(FMath::Cos(Angle),FMath::Sin(Angle))*B.Radius;
+            const auto Bank=River?River->Sample(P.X,P.Y):TemperateRiver::FSample();
+            if(TemperateForestHabitat::RainforestWeight(P.X,P.Y,Seed)<.4||Bank.Bank>.01
+                ||FMath::Abs(P.Y-TemperateHillsSurface::ValleyY(P.X,Seed))<1800){Valid=false;break;}
+            const double Z=BaseHeight(P.X,P.Y);Low=FMath::Min(Low,Z);High=FMath::Max(High,Z);
+        }
+        if(!Valid||High-Low>90)continue;
+        B.WaterZ=Low-4;double MaxCut=0;
+        for(int32 DY=-2;DY<=2;++DY)for(int32 DX=-2;DX<=2;++DX)
+        {
+            const double NX=DX/2.,NY=DY/2.,D=FMath::Sqrt(NX*NX+NY*NY);if(D>=1)continue;
+            const double Z=BaseHeight(C.X+NX*B.Radius,C.Y+NY*B.Radius);
+            const double Target=FMath::Lerp(B.WaterZ-B.Depth*(1-D*D),Z,FMath::SmoothStep(.65,1.,D));
+            MaxCut=FMath::Max(MaxCut,Z-Target);
+        }
+        if(MaxCut>75)continue;
+        Basins.Add({B,High-Low+MaxCut*.25+TemperateHillsSurface::Unit(Key+19)*8});
+    }
+    Basins.Sort([](const FCandidate& A,const FCandidate& B){return A.Score<B.Score;});
+    for(const auto& Candidate:Basins)
+    {
+        bool Near=false;for(const auto& B:Plan->Basins)Near|=FVector2D::DistSquared(B.Center,Candidate.Basin.Center)<FMath::Square(2600.);
+        if(!Near)Plan->Basins.Add(Candidate.Basin);if(Plan->Basins.Num()==2)break;
+    }
+    Plan->Ground.SetNumUninitialized(Count);
+    TArray<double> Filled;Filled.SetNumUninitialized(Count);
+    TArray<uint8> Visited,Allowed;Visited.Init(0,Count);Allowed.Init(0,Count);
+    using FEntry=std::pair<double,int32>;
+    std::priority_queue<FEntry,std::vector<FEntry>,std::greater<FEntry>> Queue;
+    for(int32 Y=0;Y<H;++Y)for(int32 X=0;X<W;++X)
+    {
+        const int32 I=Y*W+X;const double WX=Plan->Origin.X+X*Step,WY=Plan->Origin.Y+Y*Step;
+        const double Z=Plan->ShapeGround(WX,WY,BaseHeight(WX,WY))+TemperateHillsSurface::TerrainEditOffset(Edits,WX,WY);
+        Plan->Ground[I]=Filled[I]=Z;
+        const auto Bank=River?River->Sample(WX,WY):TemperateRiver::FSample();
+        Allowed[I]=TemperateForestHabitat::RainforestWeight(WX,WY,Seed)>.60&&Bank.Bank<=.01
+            &&FMath::Abs(WY-TemperateHillsSurface::ValleyY(WX,Seed))>1800;
+        // All excluded ground acts as an outlet, never an artificial dam.
+        if(!Allowed[I]||X==0||Y==0||X==W-1||Y==H-1)
+        {Visited[I]=1;Queue.push({Z,I});}
+    }
+    while(!Queue.empty())
+    {
+        const auto [Level,I]=Queue.top();Queue.pop();const int32 X=I%W,Y=I/W;
+        for(int32 DY=-1;DY<=1;++DY)for(int32 DX=-1;DX<=1;++DX)
+        {
+            const int32 NX=X+DX,NY=Y+DY;
+            if((DX==0&&DY==0)||NX<0||NY<0||NX>=W||NY>=H)continue;
+            const int32 N=NY*W+NX;if(Visited[N])continue;
+            Visited[N]=1;Filled[N]=FMath::Max(Plan->Ground[N],Level);Queue.push({Filled[N],N});
+        }
+    }
+    Visited.Init(0,Count);TArray<FPool> Candidates;
+    for(int32 Start=0;Start<Count;++Start)
+    {
+        if(Visited[Start]||!Allowed[Start]||Filled[Start]-Plan->Ground[Start]<3)continue;
+        const double Spill=Filled[Start];double Bottom=Plan->Ground[Start];
+        TArray<int32> Basin{Start};Visited[Start]=1;
+        for(int32 Cursor=0;Cursor<Basin.Num();++Cursor)
+        {
+            const int32 I=Basin[Cursor],X=I%W,Y=I/W;Bottom=FMath::Min(Bottom,Plan->Ground[I]);
+            for(int32 DY=-1;DY<=1;++DY)for(int32 DX=-1;DX<=1;++DX)
+            {
+                const int32 NX=X+DX,NY=Y+DY;if(NX<0||NY<0||NX>=W||NY>=H)continue;
+                const int32 N=NY*W+NX;
+                if(!Visited[N]&&Allowed[N]&&FMath::Abs(Filled[N]-Spill)<.1&&Filled[N]-Plan->Ground[N]>=3)
+                {Visited[N]=1;Basin.Add(N);}
+            }
+        }
+        FPool Pool;Pool.WaterZ=FMath::Min(Spill-3.,Bottom+45.);Pool.MaxDepth=Pool.WaterZ-Bottom;
+        if(Pool.MaxDepth<10)continue;
+        for(const int32 I:Basin)if(Plan->Ground[I]<Pool.WaterZ-WaterEdgeDepthCm)
+        {
+            Pool.AreaM2+=Step*Step/10000.;const int32 X=I%W,Y=I/W;
+            for(int32 DY=-1;DY<=0;++DY)for(int32 DX=-1;DX<=0;++DX)
+                if(X+DX>=0&&Y+DY>=0&&X+DX<W-1&&Y+DY<H-1)Pool.Cells.Add(FIntPoint(X+DX,Y+DY));
+        }
+        if(Pool.AreaM2<8||Pool.AreaM2>240)continue;
+        for(const auto Cell:Pool.Cells)
+        {Pool.Bounds+=Plan->Origin+FVector2D(Cell)*Step;Pool.Bounds+=Plan->Origin+FVector2D(Cell+FIntPoint(1,1))*Step;}
+        if(Pool.Bounds.GetSize().GetMax()>2800)continue;
+        Candidates.Add(MoveTemp(Pool));
+    }
+    Candidates.Sort([](const FPool& A,const FPool& B)
+    {if(A.AreaM2!=B.AreaM2)return A.AreaM2>B.AreaM2;return A.WaterZ<B.WaterZ;});
+    for(auto& Pool:Candidates)
+    {
+        bool Near=false;for(const auto& Kept:Plan->Pools)
+            Near|=FVector2D::DistSquared(Pool.Bounds.GetCenter(),Kept.Bounds.GetCenter())<FMath::Square(2200.);
+        if(!Near)Plan->Pools.Add(MoveTemp(Pool));
+        if(Plan->Pools.Num()==3)break;
+    }
+    BuildShoreMoisture(*Plan);
+    return Plan;
+}
+
+bool FPlan::HasBasin(double X,double Y) const
+{
+    for(const auto& B:Basins)if(FVector2D::DistSquared(FVector2D(X,Y),B.Center)<B.Radius*B.Radius)return true;
+    return false;
+}
+double FPlan::ShapeGround(double X,double Y,double Original) const
+{
+    double Z=Original;
+    for(const auto& B:Basins)
+    {
+        const double D=FVector2D::Distance(FVector2D(X,Y),B.Center)/B.Radius;if(D>=1)continue;
+        const double Target=FMath::Lerp(B.WaterZ-B.Depth*(1-D*D),Original,FMath::SmoothStep(.65,1.,D));
+        Z=FMath::Min(Z,FMath::Max(Original-75.,Target));
+    }
+    return Z;
+}
+
+FSample FPlan::Sample(double X,double Y) const
+{
+    const double GX=(X-Origin.X)/Step,GY=(Y-Origin.Y)/Step;
+    const int32 IX=FMath::FloorToInt(GX),IY=FMath::FloorToInt(GY);
+    if(IX<0||IY<0||IX>=Width-1||IY>=Height-1)return {};
+    for(const auto& Pool:Pools)if(Pool.Cells.Contains(FIntPoint(IX,IY)))
+    {
+        const double FX=GX-IX,FY=GY-IY;
+        // Exact diagonal used by the streamed ground mesh, not bilinear sampling.
+        const double A=GroundAt(IX,IY),B=GroundAt(IX+1,IY),C=GroundAt(IX+1,IY+1),D=GroundAt(IX,IY+1);
+        const double Z=FY<=FX?A+(B-A)*FX+(C-B)*FY:A+(C-D)*FX+(D-A)*FY;
+        if(Pool.WaterZ>Z+WaterEdgeDepthCm)return {true,Pool.WaterZ,Pool.WaterZ-Z};
+    }
+    return {};
+}
+double FPlan::ShoreMoistureAt(double X,double Y) const
+{
+    if(ShoreMoisture.IsEmpty())return 0.;
+    const double GX=(X-Origin.X)/Step,GY=(Y-Origin.Y)/Step;
+    const int32 IX=FMath::FloorToInt(GX),IY=FMath::FloorToInt(GY);
+    if(IX<0||IY<0||IX>=Width-1||IY>=Height-1)return 0.;
+    const int32 I=IY*Width+IX;
+    return FMath::BiLerp(ShoreMoisture[I],ShoreMoisture[I+1],ShoreMoisture[I+Width],ShoreMoisture[I+Width+1],GX-IX,GY-IY);
+}
+bool FPlan::IntersectsCell(double X,double Y,double Size) const
+{
+    const FBox2D Cell(FVector2D(X,Y),FVector2D(X+Size,Y+Size));
+    for(const auto& B:Basins)
+        if(FBox2D(B.Center-FVector2D(B.Radius),B.Center+FVector2D(B.Radius)).Intersect(Cell))return true;
+    for(const auto& Pool:Pools)if(Pool.Bounds.ExpandBy(ShoreInfluenceCm).Intersect(Cell))return true;
+    return false;
+}
+bool FPlan::IntersectSegment(const FVector& Start,const FVector& End,FVector& Position) const
+{
+    const double DZ=Start.Z-End.Z;if(DZ<=UE_SMALL_NUMBER)return false;
+    double Best=2.;
+    for(const auto& Pool:Pools)
+    {
+        const double T=(Start.Z-Pool.WaterZ)/DZ;if(T<0||T>1||T>=Best)continue;
+        const FVector P=FMath::Lerp(Start,End,T);const auto S=Sample(P.X,P.Y);
+        if(S.Wet&&FMath::Abs(S.WaterZ-Pool.WaterZ)<.1){Best=T;Position=P;}
+    }
+    return Best<=1.;
+}
+void FPlan::BuildWaterMesh(double X,double Y,double Size,UE::Geometry::FDynamicMesh3& Mesh) const
+{
+    Mesh.EnableAttributes();Mesh.Attributes()->EnablePrimaryColors();
+    auto* N=Mesh.Attributes()->PrimaryNormals();auto* UV=Mesh.Attributes()->PrimaryUV();auto* Color=Mesh.Attributes()->PrimaryColors();
+    for(const auto& Pool:Pools)for(const auto Cell:Pool.Cells)
+    {
+        const double WX=Origin.X+Cell.X*Step,WY=Origin.Y+Cell.Y*Step;
+        if(WX<X||WY<Y||WX>=X+Size||WY>=Y+Size)continue;
+        FVector V[4];GetCellCorners(*this,Cell,V);
+        const double Level=Pool.WaterZ-WaterEdgeDepthCm;
+        for(const auto& CornersForTri:CellTriangles)
+        {
+            TArray<FVector,TInlineAllocator<4>> Clipped;
+            for(int32 I=0;I<3;++I)
+            {
+                const auto A=V[CornersForTri[I]],B=V[CornersForTri[(I+1)%3]];
+                const bool InA=A.Z<Level,InB=B.Z<Level;
+                if(InA)Clipped.Add(A);
+                if(InA!=InB)Clipped.Add(FMath::Lerp(A,B,(Level-A.Z)/(B.Z-A.Z)));
+            }
+            if(Clipped.Num()<3)continue;
+            const int32 First=Mesh.VertexCount();
+            for(const auto P:Clipped)
+            {
+                const float Depth=Pool.WaterZ-P.Z;
+                Mesh.AppendVertex(FVector3d(P.X-X,P.Y-Y,Pool.WaterZ));N->AppendElement(FVector3f(0,0,1));
+                UV->AppendElement(FVector2f(P.X/400,P.Y/400));Color->AppendElement(FVector4f(FMath::Clamp((Depth-2)/8,0.f,1.f),.5f,0,Depth/100));
+            }
+            for(int32 I=1;I<Clipped.Num()-1;++I)
+            {const UE::Geometry::FIndex3i Id(First,First+I,First+I+1);const int32 T=Mesh.AppendTriangle(Id);N->SetTriangle(T,Id);UV->SetTriangle(T,Id);Color->SetTriangle(T,Id);}
+        }
+    }
+}
+}
