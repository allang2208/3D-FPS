+    for(const auto& Setting:TArray<TPair<const TCHAR*,float>>{
+        {TEXT("pcg.FrameTime"),2.f},{TEXT("pcg.RuntimeGeneration.NumGeneratingComponents"),2.f},{TEXT("pcg.RuntimeGeneration.BasePoolSize"),16.f},
