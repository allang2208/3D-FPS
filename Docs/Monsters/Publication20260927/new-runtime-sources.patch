+ }
+ if(Dead())
+ {
+  if(auto* A=Cast<UFatZombieAnimInstance>(GetMesh()->GetAnimInstance()))A->SetCombatTime(StateSeconds);
+  if(!DeathClip||StateSeconds>=DeathClip->GetPlayLength())
