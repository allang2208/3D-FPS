+
+/** One-handed staff: one action clock, immutable physical swing, six-slot assembly. */
+UCLASS(ClassGroup=(Weapons),meta=(BlueprintSpawnableComponent))
+class FPSGAME_API UStaffWeaponComponent : public UActorComponent
+{
