// UV.x describes physical pieces; UV.y is imported height, bottom=0, top=1.
float f=saturate(Fill);
float h=UV.y;
float front=saturate(abs(dot(normalize(Normal),normalize(View))));
float rim=pow(1.-front,2.2);
float surface=.38+.62*front;
float filled=(1.-smoothstep(f-.012,f+.012,h))*smoothstep(.002,.015,f);
float cell=1.-smoothstep(.35,.40,UV.x);
cell*=smoothstep(.20,.30,UV.x);
float frame=smoothstep(.58,.70,UV.x);
float rune=smoothstep(.55,.61,UV.x)*(1.-smoothstep(.65,.70,UV.x));
float tipline=exp(-pow((h-f)/.012,2.))*smoothstep(.01,.03,f);
float veins=pow(.5+.5*sin(h*83.+sin(h*37.-Age*1.8)*1.7),14.);
float shimmer=.92+.08*sin(Age*2.1+h*11.);
float3 glass=float3(.012,.115,.135)*surface;
float3 cyan=float3(.025,.53,.56)*surface;
float3 white=float3(.32,.92,.98);
float3 color=lerp(glass,cyan,filled*(.38+.62*cell));
color+=white*(rim*.14+frame*(.25+.22*filled)+rune*.13+veins*.06*filled+tipline*.34*cell);
color*=shimmer*(1.+Pulse*.12+Burst*.28);
float alpha=.085+rim*.16+frame*.34+rune*.12;
alpha+=cell*filled*.48+tipline*cell*.12;
return float4(color,saturate(alpha)*Reveal);
