float f=saturate(Fill);
float glyph=smoothstep(.88,.91,UV.x);
float rail=smoothstep(.64,.70,UV.x)*(1.-glyph);
float front=saturate(abs(dot(normalize(Normal),normalize(View))));
float rim=pow(1.-front,1.8);
float sweep=exp(-pow(frac(UV.y*.75-Age*.075)-.5,2.)/.016);
float3 color=float3(.017,.24,.27)*(.5+.5*front);
color+=float3(.31,.90,.98)*(glyph*.52+rail*.30+rim*.19+sweep*.18);
color*=.66+.34*f+Pulse*.12+Burst*.30;
float alpha=.065+glyph*.52+rail*.25+rim*.10;
return float4(color,saturate(alpha)*Reveal);
