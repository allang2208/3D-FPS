// Pixel-safe local coordinates in cm. The luminous double helix is confined to
// the sphere; visible light is integrated over its volume, without flat cards.
float3 center=float3(0,0,-8.0);
float radius=3.91;
float3 ray=normalize(LocalPos-CameraLocal),eye=CameraLocal-center;
float b=dot(eye,ray),disc=b*b-dot(eye,eye)+radius*radius;
if(disc<=0) return float4(0,0,0,0);
float entry=max(0.,-b-sqrt(disc)),exitT=-b+sqrt(disc);
float stepLength=(exitT-entry)/24.;
float3 accumulated=0.;float alpha=0.;
float ca=cos(Age*.16),sa=sin(Age*.16);
[unroll] for(int i=0;i<24;i++)
{
    float3 q=(eye+ray*(entry+(i+.5)*stepLength))/radius;
    q.xy=float2(ca*q.x-sa*q.y,sa*q.x+ca*q.y);
    float r=length(q),edge=saturate((.98-r)*8.);
    float phase=atan2(q.y,q.x)-q.z*7.5-Age*.34;
    float helix=pow(.5+.5*cos(phase*2.),12.)*exp(-pow(length(q.xy)-.46,2.)*24.);
    float wisps=pow(.5+.5*sin(q.x*11.+sin(q.y*8.+Age*.17)*2.+cos(q.z*12.-Age*.2)*2.),4.);
    float centerGlow=exp(-dot(q,q)*40.);
    float density=(.38*wisps+.85*helix+centerGlow*.6)*edge;
    float opacity=1.-exp(-density*stepLength*.85);
    float3 tint=lerp(float3(.001,.025,.19),float3(.018,.30,1.2),saturate(helix+wisps*.5));
    tint+=float3(.22,.55,1.1)*centerGlow*1.5;
    accumulated+=(1.-alpha)*opacity*tint*(1.6+Awake*.85+Impact*.65);
    alpha+=(1.-alpha)*opacity;
}
return float4(accumulated/max(alpha,.001),saturate(alpha*.74));
