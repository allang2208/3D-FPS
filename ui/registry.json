{
  "schema": "ui-registry-v1",
  "updated": "2026-08-09",
  "reference": "https://ui.shadcn.com/docs (local: E:/3d/shadcn-ui)",
  "rules": [
    "新 UI 任务先查本注册表，能复用绝不新建",
    "新组件先登记再实现，改接口先改 registry.md",
    "组件只消费 ui/style.gd Token，禁止裸 Color( 硬编码",
    "状态 stable = 已过门禁；in_progress = 有会话在改，动手前 git status 协调"
  ],
  "components": [
    {
      "name": "style",
      "type": "tokens",
      "path": "ui/style.gd",
      "status": "stable",
      "deps": [],
      "interfaces": ["make_theme()", "make_font(weight)", "COLOR_*", "THEME_*"],
      "tests": ["tests/test_ui_tokens.gd"]
    },
    {
      "name": "status_bar",
      "type": "hud",
      "path": "ui/status_bar.gd",
      "status": "stable",
      "deps": ["style"],
      "interfaces": ["consume player.gd/gun.gd stable signals", "_build()"],
      "tests": ["tests/test_ui_tokens.gd", "tests/test_status_bar.gd"]
    },
    {
      "name": "item_tooltip",
      "type": "tooltip",
      "path": "ui/item_tooltip.gd",
      "status": "stable",
      "deps": ["style", "item_db"],
      "interfaces": ["signal close_requested", "render(item)", "is_pinned()", "set_pinned(v)"],
      "tests": ["tests/test_ui_tokens.gd"]
    },
    {
      "name": "backpack_hud",
      "type": "panel",
      "path": "ui/backpack_hud.gd",
      "status": "in_progress",
      "deps": ["style", "backpack", "equipment", "item_tooltip"],
      "interfaces": ["signal player_healed(hp)", "setup(bp, eq)"],
      "tests": ["tests/test_backpack.gd"]
    },
    {
      "name": "backpack",
      "type": "data",
      "path": "ui/backpack.gd",
      "status": "stable",
      "deps": ["item_db"],
      "interfaces": ["signal changed/item_used/item_added/bound", "add_item", "remove_item", "swap_items", "bind_hotbar", "resolve_hotbar"],
      "tests": ["tests/test_backpack.gd"]
    },
    {
      "name": "equipment",
      "type": "data",
      "path": "ui/equipment.gd",
      "status": "stable",
      "deps": ["backpack"],
      "interfaces": ["signal changed/equipped", "equip_from_backpack", "equip_to_slot", "unequip", "swap_equip", "is_locked"],
      "tests": ["tests/test_equip.gd"]
    },
    {
      "name": "item_db",
      "type": "data",
      "path": "ui/item_db.gd",
      "status": "stable",
      "deps": [],
      "interfaces": ["has_item", "get_def", "get_all_ids", "create_instance"],
      "tests": ["tests/test_ui_tokens.gd"]
    },
    {
      "name": "style_config",
      "type": "config",
      "path": "ui/style-config.json",
      "status": "stable",
      "deps": [],
      "interfaces": ["radius", "spacing", "font", "font_weight", "motion", "active_theme"],
      "tests": ["tests/test_ui_tokens.gd"]
    },
    {
      "name": "icons",
      "type": "tools",
      "path": "ui/icons.gd",
      "status": "stable",
      "deps": [],
      "interfaces": ["get_icon(name)", "apply_icon(rect, name, color)", "has(name)"],
      "tests": ["tests/test_icons.gd"]
    },
    {
      "name": "tabs",
      "type": "widget",
      "path": "ui/tabs.gd",
      "status": "stable",
      "deps": ["style"],
      "interfaces": ["signal tab_changed", "add_tab(title)", "select(i)", "current()"],
      "tests": ["tests/test_components.gd"]
    },
    {
      "name": "switch",
      "type": "widget",
      "path": "ui/switch.gd",
      "status": "stable",
      "deps": ["style"],
      "interfaces": ["signal toggled", "set_on(v)", "is_on()"],
      "tests": ["tests/test_components.gd"]
    },
    {
      "name": "checkbox",
      "type": "widget",
      "path": "ui/checkbox.gd",
      "status": "stable",
      "deps": ["style", "icons"],
      "interfaces": ["signal toggled", "setup(text)", "set_on(v)", "is_on()"],
      "tests": ["tests/test_components.gd"]
    },
    {
      "name": "slider",
      "type": "widget",
      "path": "ui/slider.gd",
      "status": "stable",
      "deps": ["style"],
      "interfaces": ["signal value_changed", "setup(min,max,step,val)", "get_value()"],
      "tests": ["tests/test_components.gd"]
    },
    {
      "name": "input",
      "type": "widget",
      "path": "ui/input.gd",
      "status": "stable",
      "deps": ["style"],
      "interfaces": ["signal text_submitted", "setup(label, placeholder)", "get_text()", "set_text()"],
      "tests": ["tests/test_components.gd"]
    },
    {
      "name": "select",
      "type": "widget",
      "path": "ui/select.gd",
      "status": "stable",
      "deps": ["style"],
      "interfaces": ["signal item_selected", "setup(label)", "add_item", "select", "get_selected_id()"],
      "tests": ["tests/test_components.gd"]
    },
    {
      "name": "context_menu",
      "type": "widget",
      "path": "ui/context_menu.gd",
      "status": "stable",
      "deps": ["style"],
      "interfaces": ["open_at(pos, items)"],
      "tests": ["tests/test_components.gd"]
    },
    {
      "name": "navigation_menu",
      "type": "widget",
      "path": "ui/navigation_menu.gd",
      "status": "stable",
      "deps": ["style", "icons"],
      "interfaces": ["signal item_activated", "add_item(title, icon)"],
      "tests": ["tests/test_components.gd"]
    },
    {
      "name": "command_palette",
      "type": "widget",
      "path": "ui/command_palette.gd",
      "status": "stable",
      "deps": ["style"],
      "interfaces": ["signal command_selected", "register(id, label)", "toggle()"],
      "tests": ["tests/test_components.gd"]
    },
    {
      "name": "settings_demo",
      "type": "demo",
      "path": "scenes/ui/settings_demo.tscn",
      "status": "stable",
      "deps": ["style", "icons", "tabs", "switch", "checkbox", "slider", "input", "select", "context_menu", "command_palette"],
      "interfaces": ["独立场景 F6 运行", "tabs 画面/音频/游戏"],
      "tests": ["tools/ui_preview.gd"]
    }
  ]
}
