{
  "version": 1,
  "active_theme": "gray_white",
  "radius": 10,
  "radius_xs": 4,
  "radius_sm": 6,
  "radius_md": 8,
  "radius_lg": 12,
  "spacing": {
    "grid": 4,
    "hud_margin": 20,
    "panel_padding": 10,
    "element_gap": 8
  },
  "font": {
    "h1": 48,
    "h2": 32,
    "big": 22,
    "label": 16,
    "body": 14,
    "caption": 12
  },
  "font_weight": {
    "heavy": 700,
    "bold": 600,
    "regular": 400
  },
  "motion": {
    "duration_ms": 200,
    "easing": "ease_out"
  },
  "hud": {
    "bar_w": 220,
    "bar_h": 18,
    "hp": { "x": 16, "y": 10, "label_x": 244, "label_size": 22, "low_ratio": 0.25 },
    "mp": { "x": 16, "y": 40, "h": 14, "label_x": 244, "label_size": 16 },
    "kill": { "x": 16, "y": 64, "size": 16 },
    "weapon": { "size": 14 },
    "ammo": { "size": 34, "reserve_size": 16 },
    "status": { "size": 16 },
    "death": { "w": 320, "h": 140, "title_size": 40, "hint_size": 16 },
    "hitmark": { "size": 30, "ms": 0.12 },
    "dmgflash": { "ms": 0.18, "alpha": 0.25 },
    "crosshair": { "gap": 4.0, "len": 9.0, "thick": 1.5, "spread": 24.0, "max_ratio": 0.035 },
    "vignette": { "base": 0.30, "amp": 0.22, "freq": 2.4 },
    "labels": {
      "kills": "击杀: %d",
      "death_title": "你死了",
      "death_hint": "按 R 重来",
      "hp_tip_title": "生命值",
      "hp_tip_desc": "角色的生命，归零时死亡。低血量会触发红色警示。",
      "mp_tip_title": "魔法值",
      "mp_tip_desc": "释放技能消耗的魔力，随时间自动恢复。",
      "weapon_tip_title": "当前武器",
      "weapon_tip_desc": "正在使用的武器。1~4 键切换，R 键换弹。",
      "ammo_tip_title": "弹药",
      "ammo_tip_desc": "弹匣内子弹 / 备弹。弹匣打空后自动换弹。",
      "kill_tip_title": "击杀数",
      "kill_tip_desc": "本局累计击杀的敌人数量。"
    }
  }
}
