    {
      "id": "brew_hp_basic",
      "version": 2,
      "name": "治疗药水",
      "output": "hp_potion",
      "description": "入门温浸配方。基液开炉时自动入锅；加入主料，低火温热并搅匀两圈即可装瓶，无需研磨或计时。",
      "count": 2,
      "bonus": 1,
      "color": [
        0.58,
        0.025,
        0.035
      ],
      "inputs": [
        {
          "item": "alchemy_pure_base_fluid",
          "count": 1
        },
        {
          "item": "alchemy_redvein_extract",
          "count": 1
        }
      ],
      "steps": [
        {
          "action": "pour",
          "text": "基液已在锅中。加入 1 份赤脉花萃取液，冷锅或温热时均可。",
          "item": "alchemy_redvein_extract",
          "amount": 1,
          "minHeat": 0,
          "maxHeat": 60,
          "direction": 1,
          "id": "s01"
        },
        {
          "action": "stir",
          "text": "调至低火，药液温热后搅匀两圈，两个方向均可。色泽融合后直接温热装瓶。",
          "item": "",
          "amount": 2,
          "minHeat": 30,
          "maxHeat": 60,
          "direction": 0,
          "id": "s02"
        }
      ],
      "autoBase": true,
      "freeBrewing": true,
      "bottleHeat": 65
    },
